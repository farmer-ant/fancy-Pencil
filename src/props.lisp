;;;; props.lisp — the Properties palette (PROPERTIES, Ctrl+1): view and edit selected objects.

(in-package :fancy-pencil)

(defun fmt-num (x) (if (realp x) (fmt-len x) ""))
(defun fmt-deg (a) (if (realp a) (fmt-decimal (deg a) (max 0 (or (sysvar "AUPREC") 0))) ""))

(defun type-display-name (type)
  (cond ((equal type "LWPOLYLINE") "Polyline") ((equal type "INSERT") "Block Reference")
        ((equal type "MTEXT") "MText") ((equal type "DIMENSION") "Dimension")
        (t (string-capitalize type))))

(defun common-value (sel fn)
  (let ((vals (remove-duplicates (mapcar (lambda (e) (funcall fn (ent-data e))) sel) :test #'equalp)))
    (if (= (length vals) 1) (first vals) "*VARIES*")))

(defun geometry-rows (type sel)
  (flet ((v (fn) (common-value sel fn)))
    (cond
      ((equal type "LINE")
       (list '("" "Geometry" "" :head)
             (list "SX" "Start X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "SY" "Start Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "EX" "End X" (v (lambda (d) (fmt-num (px (dxf 11 d))))) :entry)
             (list "EY" "End Y" (v (lambda (d) (fmt-num (py (dxf 11 d))))) :entry)
             (list "" "Delta X" (v (lambda (d) (fmt-num (- (px (dxf 11 d)) (px (dxf 10 d)))))) :ro)
             (list "" "Delta Y" (v (lambda (d) (fmt-num (- (py (dxf 11 d)) (py (dxf 10 d)))))) :ro)
             (list "LENGTH" "Length" (v (lambda (d) (fmt-num (dist (dxf 10 d) (dxf 11 d))))) :entry)
             (list "ANGLE" "Angle" (v (lambda (d) (fmt-deg (ang (dxf 10 d) (dxf 11 d))))) :entry)))
      ((equal type "CIRCLE")
       (list '("" "Geometry" "" :head)
             (list "CX" "Center X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "CY" "Center Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "RADIUS" "Radius" (v (lambda (d) (fmt-num (dxf 40 d)))) :entry)
             (list "DIAMETER" "Diameter" (v (lambda (d) (fmt-num (* 2 (dxf 40 d))))) :entry)
             (list "" "Circumference" (v (lambda (d) (fmt-num (* +2pi+ (dxf 40 d))))) :ro)
             (list "" "Area" (v (lambda (d) (fmt-num (* +pi+ (expt (dxf 40 d) 2))))) :ro)))
      ((equal type "ARC")
       (list '("" "Geometry" "" :head)
             (list "CX" "Center X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "CY" "Center Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "RADIUS" "Radius" (v (lambda (d) (fmt-num (dxf 40 d)))) :entry)
             (list "SA" "Start angle" (v (lambda (d) (fmt-deg (dxf 50 d)))) :entry)
             (list "EA" "End angle" (v (lambda (d) (fmt-deg (dxf 51 d)))) :entry)
             (list "" "Total angle" (v (lambda (d) (fmt-deg (arc-sweep (dxf 50 d) (dxf 51 d))))) :ro)
             (list "" "Arc length" (v (lambda (d) (fmt-num (* (dxf 40 d) (arc-sweep (dxf 50 d) (dxf 51 d)))))) :ro)))
      ((equal type "LWPOLYLINE")
       (list '("" "Geometry" "" :head)
             (list "" "Vertices" (v (lambda (d) (princ-to-string (length (lwpoly-vertices d))))) :ro)
             (list "WIDTH" "Global width" (v (lambda (d) (fmt-num (or (dxf 43 d) 0d0)))) :entry)
             (list "CLOSED" "Closed" (v (lambda (d) (if (lwpoly-closed-p d) "Yes" "No"))) :combo '("Yes" "No"))
             (list "" "Length" (v (lambda (d) (fmt-num (loop for pc in (lwpoly-pieces d)
                                                              sum (if (eq (first pc) :seg) (dist2d (second pc) (third pc))
                                                                      (* (third pc) (arc-sweep (fourth pc) (fifth pc)))))))) :ro)))
      ((member type '("TEXT" "MTEXT" "ATTDEF") :test #'equal)
       (list '("" "Text" "" :head)
             (list "TEXT" "Contents" (v (lambda (d) (or (dxf 1 d) ""))) :entry)
             (list "HEIGHT" "Height" (v (lambda (d) (fmt-num (dxf 40 d)))) :entry)
             (list "ROT" "Rotation" (v (lambda (d) (fmt-deg (or (dxf 50 d) 0d0)))) :entry)
             (list "PX" "Position X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "PY" "Position Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)))
      ((equal type "INSERT")
       (list '("" "Block" "" :head)
             (list "" "Name" (v (lambda (d) (dxf 2 d))) :ro)
             (list "PX" "Position X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "PY" "Position Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "SCX" "Scale X" (v (lambda (d) (fmt-num (or (dxf 41 d) 1d0)))) :entry)
             (list "SCY" "Scale Y" (v (lambda (d) (fmt-num (or (dxf 42 d) 1d0)))) :entry)
             (list "ROT" "Rotation" (v (lambda (d) (fmt-deg (or (dxf 50 d) 0d0)))) :entry)))
      ((equal type "HATCH")
       (list '("" "Pattern" "" :head)
             (list "HPAT" "Pattern name" (v (lambda (d) (or (dxf 2 d) ""))) :combo (mapcar #'first *hatch-patterns*))
             (list "HSCALE" "Scale" (v (lambda (d) (fmt-num (or (dxf 41 d) 1d0)))) :entry)
             (list "HANG" "Angle" (v (lambda (d) (fmt-deg (or (dxf 52 d) 0d0)))) :entry)
             (list "" "Area" (v (lambda (d) (fmt-num (abs (reduce #'+ (mapcar (lambda (lp) (loop-signed-area (loop-polygon-directed lp 32)))
                                                                               (hatch-loops d))))))) :ro)))
      ((equal type "DIMENSION")
       (list '("" "Dimension" "" :head)
             (list "" "Measurement" (v (lambda (d) (fmt-num (or (dxf 42 d) 0d0)))) :ro)
             (list "DIMTEXT" "Text override" (v (lambda (d) (or (dxf 1 d) ""))) :entry)
             (list "DIMSTY" "Dim style" (v (lambda (d) (or (dxf 3 d) "Standard"))) :combo (mapcar #'dimstyle-name (all-dimstyles)))))
      ((equal type "POINT")
       (list '("" "Geometry" "" :head)
             (list "PX" "Position X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "PY" "Position Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)))
      ((equal type "ELLIPSE")
       (list '("" "Geometry" "" :head)
             (list "CX" "Center X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "CY" "Center Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "" "Major radius" (v (lambda (d) (fmt-num (dist2d (pt 0 0) (dxf 11 d))))) :ro)
             (list "RATIO" "Radius ratio" (v (lambda (d) (fmt-num (or (dxf 40 d) 1d0)))) :entry)))
      (t nil))))

(defun palette-rows (sel)
  (let ((layers (mapcar #'layer-name (drawing-layers *dwg*))))
    (if (null sel)
        (list '("" "General (current settings)" "" :head)
              (list "COLOR" "Color" (color-label (sysvar "CECOLOR")) :combo *color-choices*)
              (list "LAYER" "Layer" (sysvar "CLAYER") :combo layers)
              (list "LTYPE" "Linetype" (ltype-label (sysvar "CELTYPE")) :combo (ltype-choices))
              (list "LTSCALE" "Linetype scale" (fmt-num (sysvar "CELTSCALE")) :entry)
              (list "LWEIGHT" "Lineweight" (lineweight-label (sysvar "CELWEIGHT")) :combo (lweight-choices))
              (list "GLTSCALE" "Global LT scale" (fmt-num (sysvar "LTSCALE")) :entry)
              (list "TEXTSIZE" "Text height" (fmt-num (sysvar "TEXTSIZE")) :entry))
        (let* ((types (remove-duplicates (mapcar #'ent-type sel) :test #'equal))
               (one-type (and (= (length types) 1) (first types))))
          (append
           (list '("" "General" "" :head)
                 (list "COLOR" "Color" (common-value sel (lambda (d) (color-label (or (dxf 62 d) 256)))) :combo *color-choices*)
                 (list "LAYER" "Layer" (common-value sel (lambda (d) (dxf 8 d))) :combo layers)
                 (list "LTYPE" "Linetype" (common-value sel (lambda (d) (ltype-label (dxf 6 d)))) :combo (ltype-choices))
                 (list "LTSCALE" "Linetype scale" (common-value sel (lambda (d) (fmt-num (or (dxf 48 d) 1d0)))) :entry)
                 (list "LWEIGHT" "Lineweight" (common-value sel (lambda (d) (lineweight-label (or (dxf 370 d) -1)))) :combo (lweight-choices)))
           (and one-type (geometry-rows one-type sel)))))))

(defun palette-title (sel)
  (cond ((null sel) "No selection")
        (t (let ((types (remove-duplicates (mapcar #'ent-type sel) :test #'equal)))
             (if (= (length types) 1)
                 (format nil "~A (~D)" (type-display-name (first types)) (length sel))
                 (format nil "All (~D)" (length sel)))))))

(defun refresh-palette ()
  (when (and (eq *ui* :gui) *palette-shown*)
    (let* ((sel (remove-if-not #'ent-live-p *pickfirst*))
           (rows (palette-rows sel)))
      (tk "palette_set ~A {~{~A~^ ~}}" (tq (palette-title sel))
          (mapcar (lambda (r)
                    (destructuring-bind (key label value kind &optional choices) r
                      (format nil "{~A ~A ~A ~A ~A}" (tq key) (tq label) (tq (if (stringp value) value (lisp-repr value nil)))
                              (string-downcase (symbol-name kind)) (tcl-list choices))))
                  rows)))))

(defun apply-palette-edit (rest)
  (let* ((sp (position #\Space rest)) (key (subseq rest 0 sp)) (val (if sp (subseq rest (1+ sp)) ""))
         (sel (remove-if-not #'ent-live-p *pickfirst*))
         (num (parse-number-text val)) (angv (angtof val)))
    (when (string= val "*VARIES*") (return-from apply-palette-edit nil))
    (if (null sel)
        ;; current settings
        (cond ((member key '("COLOR" "LTYPE" "LWEIGHT") :test #'string=) (apply-current-prop rest))
              ((string= key "LAYER") (when (find-layer val) (setf (sysvar "CLAYER") (layer-name (find-layer val)))))
              ((string= key "LTSCALE") (when num (setf (sysvar "CELTSCALE") (d num))))
              ((string= key "GLTSCALE") (when (and num (> num 0)) (setf (sysvar "LTSCALE") (d num)) (gui-regen)))
              ((string= key "TEXTSIZE") (when (and num (> num 0)) (setf (sysvar "TEXTSIZE") (d num)))))
        (with-undo-group
            (lambda ()
              (dolist (e (filter-editable sel))
                (let* ((d0 (ent-data e)) (type (dxf 0 d0)) (nd d0))
                  (flet ((setp (code fn) (when num (setf nd (set-dxf code (funcall fn (pt3 (dxf code nd))) nd)))))
                    (cond
                      ((string= key "COLOR") (let ((c (parse-color-label val))) (when c (setf nd (set-entity-color nd c)))))
                      ((string= key "LAYER") (when (find-layer val) (setf nd (set-dxf 8 (layer-name (find-layer val)) nd))))
                      ((string= key "LTYPE") (ensure-ltype val)
                       (setf nd (if (string-equal val "ByLayer") (rem-dxf 6 nd) (set-dxf 6 (if (string-equal val "ByBlock") "BYBLOCK" val) nd))))
                      ((string= key "LTSCALE") (when (and num (> num 0)) (setf nd (set-dxf 48 (d num) nd))))
                      ((string= key "LWEIGHT") (let ((lw (parse-lweight-label val)))
                                                 (when lw (setf nd (if (= lw -1) (rem-dxf 370 nd) (set-dxf 370 lw nd))))))
                      ((string= key "SX") (setp 10 (lambda (p) (pt num (py p) (pz p)))))
                      ((string= key "SY") (setp 10 (lambda (p) (pt (px p) num (pz p)))))
                      ((string= key "EX") (setp 11 (lambda (p) (pt num (py p) (pz p)))))
                      ((string= key "EY") (setp 11 (lambda (p) (pt (px p) num (pz p)))))
                      ((and (string= key "LENGTH") num (equal type "LINE"))
                       (setf nd (set-dxf 11 (polar (pt3 (dxf 10 nd)) (ang (dxf 10 nd) (dxf 11 nd)) num) nd)))
                      ((and (string= key "ANGLE") angv (equal type "LINE"))
                       (setf nd (set-dxf 11 (polar (pt3 (dxf 10 nd)) angv (dist2d (dxf 10 nd) (dxf 11 nd))) nd)))
                      ((string= key "CX") (setp 10 (lambda (p) (pt num (py p) (pz p)))))
                      ((string= key "CY") (setp 10 (lambda (p) (pt (px p) num (pz p)))))
                      ((and (string= key "RADIUS") num (> num 0)) (setf nd (set-dxf 40 (d num) nd)))
                      ((and (string= key "DIAMETER") num (> num 0)) (setf nd (set-dxf 40 (d (/ num 2)) nd)))
                      ((and (string= key "SA") angv) (setf nd (set-dxf 50 angv nd)))
                      ((and (string= key "EA") angv) (setf nd (set-dxf 51 angv nd)))
                      ((and (string= key "WIDTH") num) (setf nd (if (zerop num) (rem-dxf 43 nd) (set-dxf 43 (d num) nd))))
                      ((string= key "CLOSED") (setf nd (set-dxf 70 (if (string-equal val "Yes") 1 0) nd)))
                      ((string= key "TEXT") (setf nd (set-dxf 1 val nd)))
                      ((and (string= key "HEIGHT") num (> num 0)) (setf nd (set-dxf 40 (d num) nd)))
                      ((and (string= key "ROT") angv) (setf nd (set-dxf 50 angv nd)))
                      ((member key '("PX" "PY") :test #'string=)
                       (when num
                         (let* ((p (pt3 (if (equal type "TEXT") (text-insertion nd) (dxf 10 nd))))
                                (q (if (string= key "PX") (pt num (py p) (pz p)) (pt (px p) num (pz p)))))
                           (setf nd (xform-data nd (xf-move (v- q p)))))))
                      ((and (string= key "SCX") num) (setf nd (set-dxf 41 (d num) nd)))
                      ((and (string= key "SCY") num) (setf nd (set-dxf 42 (d num) nd)))
                      ((string= key "HPAT") (when (hatch-pattern-def val)
                                              (setf nd (rem-dxf :pattern (set-dxf 70 (if (solid-pattern-p val) 1 0) (set-dxf 2 (string-upcase val) nd))))))
                      ((and (string= key "HSCALE") num (> num 0)) (setf nd (rem-dxf :pattern (set-dxf 41 (d num) nd))))
                      ((and (string= key "HANG") angv) (setf nd (rem-dxf :pattern (set-dxf 52 angv nd))))
                      ((string= key "DIMTEXT") (setf nd (set-dxf 1 val nd)))
                      ((string= key "DIMSTY") (let ((ds (find-dimstyle val)))
                                                (when ds (setf nd (set-dxf :dimvars (dimstyle-vars ds) (set-dxf 3 (dimstyle-name ds) nd))))))
                      ((and (string= key "RATIO") num (< 0 num 1.0000001)) (setf nd (set-dxf 40 (d num) nd)))))
                  (unless (eq nd d0) (set-entity-data e nd)))))))
    (gui-sync)))

(defcmd "PROPERTIES" ("PR" "PROPS" "CH" "MO" "DDCHPROP" "DDMODIFY") "Shows the Properties palette."
  (if (gui-p) (tk "palette_toggle") (out (format nil "The Properties palette needs the graphical interface.~%"))))
