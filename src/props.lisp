;;;; props.lisp — the Properties palette (PROPERTIES, Ctrl+1): view and edit selected objects.

(in-package :fancy-pencil)

(defun fmt-num (x) (if (realp x) (fmt-len x) ""))
(defun fmt-factor (x)
  "A scale factor: a plain number (never feet and inches), with as many decimals as it needs."
  (if (realp x)
      (let ((s (string-right-trim "." (string-right-trim "0" (format nil "~,6F" (d x))))))
        (if (string= s "") "0" s))
      ""))
(defun fmt-deg (a) (if (realp a) (fmt-decimal (deg a) (max 0 (or (sysvar "AUPREC") 0))) ""))

(defun type-display-name (type)
  (cond ((equal type "LWPOLYLINE") "Polyline") ((equal type "INSERT") "Block Reference")
        ((equal type "MTEXT") "MText") ((equal type "DIMENSION") "Dimension") ((equal type "LEADER") "Leader")
        ((equal type "POLYFACE") "3D Solid (mesh)") ((equal type "VIEWPORT") "Viewport")
        (t (string-capitalize type))))

(defun common-value (sel fn)
  (let ((vals (remove-duplicates (mapcar (lambda (e) (funcall fn (ent-data e))) sel) :test #'equalp)))
    (if (= (length vals) 1) (first vals) "*VARIES*")))

(defun geometry-rows (type sel)
  (flet ((v (fn) (common-value sel fn)))
    (cond
      ((equal type "LINE")
       (list '("" "Geometry" "" :head)
             (list "SX" "Start X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "SY" "Start Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "EX" "End X" (v (lambda (d) (fmt-num (px (dxf 11 d))))) :entry)
             (list "EY" "End Y" (v (lambda (d) (fmt-num (py (dxf 11 d))))) :entry)
             (list "" "Delta X" (v (lambda (d) (fmt-num (- (px (dxf 11 d)) (px (dxf 10 d)))))) :ro)
             (list "" "Delta Y" (v (lambda (d) (fmt-num (- (py (dxf 11 d)) (py (dxf 10 d)))))) :ro)
             (list "LENGTH" "Length" (v (lambda (d) (fmt-num (dist (dxf 10 d) (dxf 11 d))))) :entry)
             (list "ANGLE" "Angle" (v (lambda (d) (fmt-deg (ang (dxf 10 d) (dxf 11 d))))) :entry)))
      ((equal type "CIRCLE")
       (list '("" "Geometry" "" :head)
             (list "CX" "Center X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "CY" "Center Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "RADIUS" "Radius" (v (lambda (d) (fmt-num (dxf 40 d)))) :entry)
             (list "DIAMETER" "Diameter" (v (lambda (d) (fmt-num (* 2 (dxf 40 d))))) :entry)
             (list "" "Circumference" (v (lambda (d) (fmt-num (* +2pi+ (dxf 40 d))))) :ro)
             (list "" "Area" (v (lambda (d) (fmt-area (* +pi+ (expt (dxf 40 d) 2))))) :ro)))
      ((equal type "ARC")
       (list '("" "Geometry" "" :head)
             (list "CX" "Center X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "CY" "Center Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "RADIUS" "Radius" (v (lambda (d) (fmt-num (dxf 40 d)))) :entry)
             (list "SA" "Start angle" (v (lambda (d) (fmt-deg (dxf 50 d)))) :entry)
             (list "EA" "End angle" (v (lambda (d) (fmt-deg (dxf 51 d)))) :entry)
             (list "" "Total angle" (v (lambda (d) (fmt-deg (arc-sweep (dxf 50 d) (dxf 51 d))))) :ro)
             (list "" "Arc length" (v (lambda (d) (fmt-num (* (dxf 40 d) (arc-sweep (dxf 50 d) (dxf 51 d)))))) :ro)))
      ((equal type "LWPOLYLINE")
       (list '("" "Geometry" "" :head)
             (list "" "Vertices" (v (lambda (d) (princ-to-string (length (lwpoly-vertices d))))) :ro)
             (list "WIDTH" "Global width" (v (lambda (d) (fmt-num (or (dxf 43 d) 0d0)))) :entry)
             (list "CLOSED" "Closed" (v (lambda (d) (if (lwpoly-closed-p d) "Yes" "No"))) :combo '("Yes" "No"))
             (list "" "Length" (v (lambda (d) (fmt-num (loop for pc in (lwpoly-pieces d)
                                                              sum (if (eq (first pc) :seg) (dist2d (second pc) (third pc))
                                                                      (* (third pc) (arc-sweep (fourth pc) (fifth pc)))))))) :ro)))
      ((member type '("TEXT" "MTEXT" "ATTDEF") :test #'equal)
       (append
        (list '("" "Text" "" :head)
             (list "TEXT" "Contents" (v (lambda (d) (or (dxf 1 d) ""))) :entry)
             (list "TSTYLE" "Style" (v (lambda (d) (or (dxf 7 d) "Standard"))) :combo (mapcar #'textstyle-name (all-textstyles)))
             (list "HEIGHT" "Height" (v (lambda (d) (fmt-num (dxf 40 d)))) :entry)
             (list "ROT" "Rotation" (v (lambda (d) (fmt-deg (or (dxf 50 d) 0d0)))) :entry)
             (list "PX" "Position X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "PY" "Position Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry))
       (when (equal type "MTEXT")
         (list (list "MTWIDTH" "Width (0 = no wrap)" (v (lambda (d) (fmt-num (or (dxf 41 d) 0d0)))) :entry)
               (list "MTJUST" "Justify" (v (lambda (d) (or (car (rassoc (or (dxf 71 d) 1) *mtext-justify*)) "TL")))
                     :combo (mapcar #'car *mtext-justify*))))))
      ((equal type "INSERT")
       (list '("" "Block" "" :head)
             (list "" "Name" (v (lambda (d) (dxf 2 d))) :ro)
             (list "PX" "Position X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "PY" "Position Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "SCX" "Scale X" (v (lambda (d) (fmt-plain (or (dxf 41 d) 1d0)))) :entry)
             (list "SCY" "Scale Y" (v (lambda (d) (fmt-plain (or (dxf 42 d) 1d0)))) :entry)
             (list "ROT" "Rotation" (v (lambda (d) (fmt-deg (or (dxf 50 d) 0d0)))) :entry)))
      ((equal type "HATCH")
       (list '("" "Pattern" "" :head)
             (list "HPAT" "Pattern name" (v (lambda (d) (or (dxf 2 d) ""))) :combo (mapcar #'first *hatch-patterns*))
             (list "HSCALE" "Scale" (v (lambda (d) (fmt-plain (or (dxf 41 d) 1d0)))) :entry)
             (list "HANG" "Angle" (v (lambda (d) (fmt-deg (or (dxf 52 d) 0d0)))) :entry)
             (list "" "Area" (v (lambda (d) (fmt-area (abs (reduce #'+ (mapcar (lambda (lp) (loop-signed-area (loop-polygon-directed lp 32)))
                                                                               (hatch-loops d))))))) :ro)))
      ((equal type "DIMENSION")
       (list '("" "Dimension" "" :head)
             (list "" "Measurement" (v (lambda (d) (fmt-num (or (dxf 42 d) 0d0)))) :ro)
             (list "DIMTEXT" "Text override" (v (lambda (d) (or (dxf 1 d) ""))) :entry)
             (list "DIMSTY" "Dim style" (v (lambda (d) (or (dxf 3 d) "Standard"))) :combo (mapcar #'dimstyle-name (all-dimstyles)))))
      ((equal type "VIEWPORT") (funcall 'viewport-palette-rows sel))
      ((equal type "IMAGE") (funcall 'image-palette-rows sel))
      ((equal type "HELIX") (funcall 'helix-palette-rows sel))
      ((equal type "POLYFACE")
       (list '("" "Solid (mesh)" "" :head)
             (list "" "Volume" (v (lambda (d) (let ((vol (mesh-volume d))) (if (> vol 1d-12) (fmt-num vol) "open surface")))) :ro)
             (list "" "Faces" (v (lambda (d) (princ-to-string (length (mesh-faces d))))) :ro)))
      ((equal type "LEADER")
       (list '("" "Leader" "" :head)
             (list "LDRASZ" "Arrow size" (v (lambda (d) (fmt-num (getf (leader-arrow-vars d) :dimasz)))) :entry)
             (list "LDRSCALE" "Overall scale" (v (lambda (d) (fmt-factor (getf (leader-arrow-vars d) :dimscale)))) :entry)
             (list "LDRARROW" "Arrowhead" (v (lambda (d) (if (eql (dxf 71 d) 0) "None" "Yes"))) :combo '("Yes" "None"))
             (list "LDRPATH" "Path" (v (lambda (d) (if (eql (dxf 72 d) 1) "Spline" "Straight"))) :combo '("Straight" "Spline"))
             (list "DIMSTY" "Dim style" (v (lambda (d) (or (dxf 3 d) "Standard"))) :combo (mapcar #'dimstyle-name (all-dimstyles)))
             (list "" "Vertices" (v (lambda (d) (princ-to-string (length (leader-vertices d))))) :ro)))
      ((equal type "POINT")
       (list '("" "Geometry" "" :head)
             (list "PX" "Position X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "PY" "Position Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)))
      ((equal type "ELLIPSE")
       (list '("" "Geometry" "" :head)
             (list "CX" "Center X" (v (lambda (d) (fmt-num (px (dxf 10 d))))) :entry)
             (list "CY" "Center Y" (v (lambda (d) (fmt-num (py (dxf 10 d))))) :entry)
             (list "" "Major radius" (v (lambda (d) (fmt-num (dist2d (pt 0 0) (dxf 11 d))))) :ro)
             (list "RATIO" "Radius ratio" (v (lambda (d) (fmt-factor (or (dxf 40 d) 1d0)))) :entry)))
      (t nil))))

(defun palette-rows (sel)
  (let ((layers (mapcar #'layer-name (drawing-layers *dwg*))))
    (if (null sel)
        (list '("" "General (current settings)" "" :head)
              (list "COLOR" "Color" (color-label (sysvar "CECOLOR")) :combo *color-choices*)
              (list "LAYER" "Layer" (sysvar "CLAYER") :combo layers)
              (list "LTYPE" "Linetype" (ltype-label (sysvar "CELTYPE")) :combo (ltype-choices))
              (list "LTSCALE" "Linetype scale" (fmt-factor (sysvar "CELTSCALE")) :entry)
              (list "LWEIGHT" "Lineweight" (lineweight-label (sysvar "CELWEIGHT")) :combo (lweight-choices))
              (list "GLTSCALE" "Global LT scale" (fmt-factor (sysvar "LTSCALE")) :entry)
              (list "TEXTSIZE" "Text height" (fmt-num (sysvar "TEXTSIZE")) :entry)
              (list "THICK" "Thickness" (fmt-num (or (sysvar "THICKNESS") 0d0)) :entry)
              (list "ELEV" "Elevation" (fmt-num (or (sysvar "ELEVATION") 0d0)) :entry))
        (let* ((types (remove-duplicates (mapcar #'ent-type sel) :test #'equal))
               (one-type (and (= (length types) 1) (first types))))
          (append
           (list '("" "General" "" :head)
                 (list "COLOR" "Color" (common-value sel (lambda (d) (color-label (or (dxf 62 d) 256)))) :combo *color-choices*)
                 (list "LAYER" "Layer" (common-value sel (lambda (d) (dxf 8 d))) :combo layers)
                 (list "LTYPE" "Linetype" (common-value sel (lambda (d) (ltype-label (dxf 6 d)))) :combo (ltype-choices))
                 (list "LTSCALE" "Linetype scale" (common-value sel (lambda (d) (fmt-factor (or (dxf 48 d) 1d0)))) :entry)
                 (list "LWEIGHT" "Lineweight" (common-value sel (lambda (d) (lineweight-label (or (dxf 370 d) -1)))) :combo (lweight-choices))
                 (list "ELEV" "Elevation" (common-value sel (lambda (d) (fmt-num (entity-elevation d)))) :entry))
           (when (every (lambda (e) (member (ent-type e) '("LINE" "ARC" "CIRCLE" "LWPOLYLINE" "POINT") :test #'equal)) sel)
             (list (list "THICK" "Thickness" (common-value sel (lambda (d) (fmt-num (or (dxf 39 d) 0d0)))) :entry)))
           (and one-type (geometry-rows one-type sel)))))))

(defun palette-title (sel)
  (cond ((null sel) "No selection")
        (t (let ((types (remove-duplicates (mapcar #'ent-type sel) :test #'equal)))
             (if (= (length types) 1)
                 (format nil "~A (~D)" (type-display-name (first types)) (length sel))
                 (format nil "All (~D)" (length sel)))))))

(defvar *palette-type* nil "Object type the Properties palette is limited to (NIL = all selected).")
(defvar *palette-sel-key* nil)


(defun palette-selection ()
  "The selected objects the palette shows and edits: all of them, or only the chosen type."
  (let* ((sel (remove-if-not #'ent-live-p *pickfirst*))
         (key (sort (mapcar #'ename-handle sel) #'string<)))
    (unless (equal key *palette-sel-key*)          ; a new selection starts again at "All"
      (setf *palette-sel-key* key *palette-type* nil))
    (if (and *palette-type* (find *palette-type* sel :key #'ent-type :test #'equal))
        (remove-if-not (lambda (e) (equal (ent-type e) *palette-type*)) sel)
        (progn (setf *palette-type* nil) sel))))

(defun palette-type-choices ()
  "({type label} ...): All (n), then each object type in the selection with its count."
  (let* ((sel (remove-if-not #'ent-live-p *pickfirst*))
         (types (remove-duplicates (mapcar #'ent-type sel) :test #'equal :from-end t)))
    (when sel
      (cons (list "ALL" (format nil "All (~D)" (length sel)))
            (loop for ty in types
                  collect (list ty (format nil "~A (~D)" (type-display-name ty) (count ty sel :key #'ent-type :test #'equal))))))))

(defun rows-tcl (rows)
  (format nil "{~{~A~^ ~}}"
          (mapcar (lambda (r)
                    (destructuring-bind (key label value kind &optional choices) r
                      (format nil "{~A ~A ~A ~A ~A}" (tq key) (tq label) (tq (if (stringp value) value (lisp-repr value nil)))
                              (string-downcase (symbol-name kind)) (tcl-list choices))))
                  rows)))

(defun types-tcl ()
  (let ((choices (palette-type-choices)))
    (values (format nil "{~{{~A ~A}~^ ~}}" (loop for (ty label) in choices append (list (tq ty) (tq label))))
            (tq (or *palette-type* "ALL")))))

(defparameter *quick-keys*
  '("COLOR" "LAYER" "LTYPE" "LTSCALE" "LENGTH" "ANGLE" "RADIUS" "DIAMETER" "TEXT" "TSTYLE" "HEIGHT" "ROT"
    "MTWIDTH" "WIDTH" "CLOSED" "HPAT" "HSCALE" "HANG" "DIMTEXT" "DIMSTY" "SCX" "SCY" "THICK"
    "LDRASZ" "LDRARROW" "LDRPATH"))
(defparameter *quick-ro-labels* '("Area" "Length" "Circumference" "Arc length" "Measurement" "Name" "Vertices"))

(defun quick-rows (sel)
  "The short list of properties AutoCAD's Quick Properties shows."
  (remove-if-not (lambda (r) (destructuring-bind (key label value kind &rest ignore) r
                               (declare (ignore value ignore))
                               (or (and (eq kind :head) nil)
                                   (member key *quick-keys* :test #'string=)
                                   (and (eq kind :ro) (member label *quick-ro-labels* :test #'string=)))))
                 (palette-rows sel)))

(defun refresh-palette ()
  (when (eq *ui* :gui)
    (let* ((sel (palette-selection)))
      (when *palette-shown*
        (multiple-value-bind (types cur) (types-tcl)
          (tk "palette_set ~A ~A ~A ~A" (tq (palette-title sel)) (rows-tcl (palette-rows sel)) types cur)))
      ;; Quick Properties stays open until its Close button: with nothing selected it shows the
      ;; current settings (what new objects get)
      (when *quick-shown*
        (if (null sel)
            (tk "qpanel_set ~A {} ALL" (rows-tcl (quick-rows nil)))
            (multiple-value-bind (types cur) (types-tcl)
              (tk "qpanel_set ~A ~A ~A" (rows-tcl (quick-rows sel)) types cur)))))))

(defun set-palette-type (ty)
  (setf *palette-type* (if (string-equal ty "ALL") nil ty))
  (refresh-palette))

(defcmd "QUICKPROPERTIES" ("QP" "QUICKPROP") "Quick Properties: a small panel with the main properties of the selected objects."
  (let ((sel (remove-if-not #'ent-live-p *pickfirst*)))
    (unless sel
      (setf sel (get-selection "Select objects: "))
      (when sel (setf *pickfirst* sel) (when (gui-p) (ui-highlight sel t) (refresh-grips))))
    (when (gui-p)
      (setf *quick-shown* t)
      (refresh-palette))))

(defun apply-palette-edit (rest)
  (let* ((sp (position #\Space rest)) (key (subseq rest 0 sp)) (val (if sp (subseq rest (1+ sp)) ""))
         (sel (palette-selection))
         (num (parse-number-text val)) (angv (angtof val)))
    (when (string= val "*VARIES*") (return-from apply-palette-edit nil))
    (if (null sel)
        ;; current settings
        (cond ((member key '("COLOR" "LTYPE" "LWEIGHT") :test #'string=) (apply-current-prop rest))
              ((string= key "LAYER") (when (find-layer val) (setf (sysvar "CLAYER") (layer-name (find-layer val)))))
              ((string= key "LTSCALE") (when num (setf (sysvar "CELTSCALE") (d num))))
              ((string= key "GLTSCALE") (when (and num (> num 0)) (setf (sysvar "LTSCALE") (d num)) (gui-regen)))
              ((string= key "TEXTSIZE") (when (and num (> num 0)) (setf (sysvar "TEXTSIZE") (d num))))
              ((string= key "THICK") (when num (setf (sysvar "THICKNESS") (d num))))
              ((string= key "ELEV") (when num (setf (sysvar "ELEVATION") (d num)))))
        (with-undo-group
            (lambda ()
              (dolist (e (filter-editable sel))
                (let* ((d0 (ent-data e)) (type (dxf 0 d0)) (nd d0))
                  (flet ((setp (code fn) (when num (setf nd (set-dxf code (funcall fn (pt3 (dxf code nd))) nd)))))
                    (cond
                      ((string= key "COLOR") (let ((c (parse-color-label val))) (when c (setf nd (set-entity-color nd c)))))
                      ((string= key "LAYER") (when (find-layer val) (setf nd (set-dxf 8 (layer-name (find-layer val)) nd))))
                      ((string= key "LTYPE") (ensure-ltype val)
                       (setf nd (if (string-equal val "ByLayer") (rem-dxf 6 nd) (set-dxf 6 (if (string-equal val "ByBlock") "BYBLOCK" val) nd))))
                      ((string= key "LTSCALE") (when (and num (> num 0)) (setf nd (set-dxf 48 (d num) nd))))
                      ((string= key "THICK")
                       (when (and num (member type '("LINE" "ARC" "CIRCLE" "LWPOLYLINE" "POINT") :test #'equal))
                         (setf nd (if (zerop num) (rem-dxf 39 nd) (set-dxf 39 (d num) nd)))))
                      ((string= key "ELEV")
                       (when num
                         (setf nd (if (equal type "LWPOLYLINE")
                                      (if (zerop num) (rem-dxf 38 nd) (set-dxf 38 (d num) nd))
                                      (xform-data nd (xf-move (pt 0 0 (- num (entity-elevation nd)))))))))
                      ((string= key "LWEIGHT") (let ((lw (parse-lweight-label val)))
                                                 (when lw (setf nd (if (= lw -1) (rem-dxf 370 nd) (set-dxf 370 lw nd))))))
                      ((string= key "SX") (setp 10 (lambda (p) (pt num (py p) (pz p)))))
                      ((string= key "SY") (setp 10 (lambda (p) (pt (px p) num (pz p)))))
                      ((string= key "EX") (setp 11 (lambda (p) (pt num (py p) (pz p)))))
                      ((string= key "EY") (setp 11 (lambda (p) (pt (px p) num (pz p)))))
                      ((and (string= key "LENGTH") num (equal type "LINE"))
                       (setf nd (set-dxf 11 (polar (pt3 (dxf 10 nd)) (ang (dxf 10 nd) (dxf 11 nd)) num) nd)))
                      ((and (string= key "ANGLE") angv (equal type "LINE"))
                       (setf nd (set-dxf 11 (polar (pt3 (dxf 10 nd)) angv (dist2d (dxf 10 nd) (dxf 11 nd))) nd)))
                      ((string= key "CX") (setp 10 (lambda (p) (pt num (py p) (pz p)))))
                      ((string= key "CY") (setp 10 (lambda (p) (pt (px p) num (pz p)))))
                      ((and (string= key "RADIUS") num (> num 0)) (setf nd (set-dxf 40 (d num) nd)))
                      ((and (string= key "DIAMETER") num (> num 0)) (setf nd (set-dxf 40 (d (/ num 2)) nd)))
                      ((and (string= key "SA") angv) (setf nd (set-dxf 50 angv nd)))
                      ((and (string= key "EA") angv) (setf nd (set-dxf 51 angv nd)))
                      ((and (string= key "WIDTH") num) (setf nd (if (zerop num) (rem-dxf 43 nd) (set-dxf 43 (d num) nd))))
                      ((string= key "CLOSED") (setf nd (set-dxf 70 (if (string-equal val "Yes") 1 0) nd)))
                      ((string= key "TEXT") (setf nd (set-dxf 1 val nd)))
                      ((string= key "TSTYLE") (let ((st (find-textstyle val))) (when st (setf nd (set-dxf 7 (textstyle-name st) nd)))))
                      ((and (string= key "MTWIDTH") num (>= num 0) (equal type "MTEXT")) (setf nd (set-dxf 41 (d num) nd)))
                      ((and (string= key "MTJUST") (equal type "MTEXT") (assoc val *mtext-justify* :test #'string-equal))
                       (setf nd (set-dxf 71 (cdr (assoc val *mtext-justify* :test #'string-equal)) nd)))
                      ((and (string= key "HEIGHT") num (> num 0)) (setf nd (set-dxf 40 (d num) nd)))
                      ((and (string= key "ROT") angv) (setf nd (set-dxf 50 angv nd)))
                      ((member key '("PX" "PY") :test #'string=)
                       (when num
                         (let* ((p (pt3 (if (equal type "TEXT") (text-insertion nd) (dxf 10 nd))))
                                (q (if (string= key "PX") (pt num (py p) (pz p)) (pt (px p) num (pz p)))))
                           (setf nd (xform-data nd (xf-move (v- q p)))))))
                      ((and (string= key "SCX") num) (setf nd (set-dxf 41 (d num) nd)))
                      ((and (string= key "SCY") num) (setf nd (set-dxf 42 (d num) nd)))
                      ((string= key "HPAT") (when (hatch-pattern-def val)
                                              (setf nd (rem-dxf :pattern (set-dxf 70 (if (solid-pattern-p val) 1 0) (set-dxf 2 (string-upcase val) nd))))))
                      ((and (string= key "HSCALE") num (> num 0)) (setf nd (rem-dxf :pattern (set-dxf 41 (d num) nd))))
                      ((and (string= key "HANG") angv) (setf nd (rem-dxf :pattern (set-dxf 52 angv nd))))
                      ((string= key "DIMTEXT") (setf nd (set-dxf 1 val nd)))
                      ((string= key "DIMSTY") (let ((ds (find-dimstyle val)))
                                                (when ds (setf nd (set-dxf :dimvars (dimstyle-vars ds) (set-dxf 3 (dimstyle-name ds) nd))))))
                      ((and (string= key "LDRASZ") num (>= num 0) (equal type "LEADER")) (setf nd (set-dxf :ldr-asz (d num) nd)))
                      ((and (string= key "LDRSCALE") num (> num 0) (equal type "LEADER")) (setf nd (set-dxf :ldr-scale (d num) nd)))
                      ((and (string= key "LDRARROW") (equal type "LEADER")) (setf nd (set-dxf 71 (if (string-equal val "None") 0 1) nd)))
                      ((and (string= key "LDRPATH") (equal type "LEADER")) (setf nd (set-dxf 72 (if (string-equal val "Spline") 1 0) nd)))
                      ((and (string= key "RATIO") num (< 0 num 1.0000001)) (setf nd (set-dxf 40 (d num) nd)))
                      ((and (equal type "HELIX") (member key '("HXBR" "HXTR" "HXH" "HXN" "HXTH" "HXTW") :test #'string=))
                       (setf nd (funcall 'helix-palette-edit nd key val num)))
                      ((and (equal type "IMAGE") (member key '("IMGW" "IMGH" "IMGFADE" "IMGSHOW") :test #'string=))
                       (setf nd (funcall 'image-palette-edit nd key val num)))
                      ((and (equal type "VIEWPORT") (> (length key) 2) (string= (subseq key 0 2) "VP"))
                       (setf nd (funcall 'viewport-palette-edit nd key val num)))))
                  (unless (eq nd d0) (set-entity-data e nd)))))))
    (when (member key '("LTSCALE" "GLTSCALE" "LTYPE") :test #'string=)
      (linetype-visibility-note (if sel (remove-if-not #'ent-live-p sel) nil)))
    (gui-sync)))

(defun nice-number (x)
  "X rounded up to 1, 2 or 5 times a power of ten."
  (let* ((p (expt 10d0 (floor (log (max x 1d-12) 10)))) (m (/ x p)))
    (* p (cond ((<= m 1) 1) ((<= m 2) 2) ((<= m 5) 5) (t 10)))))

(defun linetype-visibility-note (ents)
  "Say so when a dashed linetype's pattern is too small (or too big) to see at the current zoom:
it is then drawn solid, which otherwise looks as if the linetype scale did nothing."
  (when (gui-p)
    (let ((notes nil))
      (dolist (e (or ents (list nil)))
        (let* ((data (and e (ent-data e)))
               (name (if data (entity-ltype-name data) (sysvar "CELTYPE")))
               (pattern (and name (ltype-pattern-for name)))
               (scale (if data (ltype-scale-for data) (* (d (or (sysvar "LTSCALE") 1)) (d (or (sysvar "CELTSCALE") 1)))))
               (period (and pattern (* scale (reduce #'+ (mapcar #'abs pattern))))))
          (when (and period (< (* period *vscale*) 3) (not (member name notes :test #'string-equal)))
            (push name notes)
            (out (format nil "Note: ~A at this scale repeats every ~A, which is under 3 pixels at this zoom, so it is ~
                              drawn solid.~%  Zoom in to see the dashes, or raise the linetype scale (about ~A for this zoom), ~
                              or the Global LT scale (LTSCALE) for the whole drawing.~%"
                         name (fmt-len period) (fmt-factor (nice-number (/ (* 6 scale) (* period *vscale*))))))))))))

(defcmd "PROPERTIES" ("PR" "PROPS" "CH" "MO" "DDCHPROP" "DDMODIFY") "Shows the Properties palette."
  (if (gui-p) (tk "palette_toggle") (out (format nil "The Properties palette needs the graphical interface.~%"))))
