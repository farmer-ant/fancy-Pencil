;;;; hover.lisp — rollover tooltips: rest the cursor on an object and a small box shows what it
;;;; is and its sizes (length, radius, area ...), in the drawing's units. ROLLOVERTIPS = 0 turns
;;;; them off (Tools > Drafting Settings > Cursor & Selection, or the command line).

(in-package :fancy-pencil)

(defun piece-length (pc)
  (case (first pc)
    ((:seg :gseg) (dist2d (second pc) (third pc)))
    (:arc (destructuring-bind (c r a1 a2) (rest pc) (declare (ignore c)) (* r (arc-sweep a1 a2))))
    (:circle (* +2pi+ (third pc)))
    (t 0d0)))

(defun lwpoly-rectangle-size (data)
  "Width and height when the polyline is a closed four-sided rectangle, else NIL."
  (let ((vs (mapcar #'first (lwpoly-vertices data))))
    (when (and (lwpoly-closed-p data) (= (length vs) 4)
               (every (lambda (v) (zerop (or (second v) 0))) (lwpoly-vertices data)))
      (destructuring-bind (a b c dd) vs
        (let ((ab (v- b a)) (bc (v- c b)) (cd (v- dd c)))
          (flet ((dot (u v) (+ (* (px u) (px v)) (* (py u) (py v)))))
            (when (and (< (abs (dot ab bc)) (* 1d-6 (max 1d-12 (* (dist2d a b) (dist2d b c)))))
                       (< (abs (dot bc cd)) (* 1d-6 (max 1d-12 (* (dist2d b c) (dist2d c dd))))))
              (values (dist2d a b) (dist2d b c)))))))))

(defun rollover-lines (e)
  "Lines of text describing entity E for its tooltip."
  (let* ((data (ent-data e)) (type (dxf 0 data))
         (layer (or (dxf 8 data) "0"))
         (lines nil))
    (flet ((add (fmt &rest args) (push (apply #'format nil fmt args) lines)))
      (cond
        ((equal type "LINE")
         (let ((a (pt3 (dxf 10 data))) (b (pt3 (dxf 11 data))))
           (add "Line")
           (add "Length  ~A" (fmt-len (dist2d a b)))
           (add "Angle  ~A" (fmt-ang (ang a b)))
           (add "Delta X  ~A    Delta Y  ~A" (fmt-len (- (px b) (px a))) (fmt-len (- (py b) (py a))))))
        ((equal type "CIRCLE")
         (let ((r (dxf 40 data)))
           (add "Circle")
           (add "Radius  ~A    Diameter  ~A" (fmt-len r) (fmt-len (* 2 r)))
           (add "Circumference  ~A" (fmt-len (* +2pi+ r)))
           (add "Area  ~A" (fmt-area (* pi r r)))))
        ((equal type "ARC")
         (let ((r (dxf 40 data)) (sw (arc-sweep (dxf 50 data) (dxf 51 data))))
           (add "Arc")
           (add "Radius  ~A" (fmt-len r))
           (add "Arc length  ~A" (fmt-len (* r sw)))
           (add "Included angle  ~A" (fmt-ang sw))))
        ((equal type "LWPOLYLINE")
         (multiple-value-bind (w h) (lwpoly-rectangle-size data)
           (let ((len (reduce #'+ (mapcar #'piece-length (lwpoly-pieces data)))))
             (cond (w (add "Rectangle")
                      (add "~A  x  ~A" (fmt-len w) (fmt-len h)))
                   (t (add "Polyline (~D vertices~:[~;, closed~])" (length (lwpoly-vertices data)) (lwpoly-closed-p data))))
             (add "Length  ~A" (fmt-len len))
             (when (lwpoly-closed-p data)
               (multiple-value-bind (area) (entity-area-perimeter e)
                 (when area (add "Area  ~A" (fmt-area area)))))
             (when (and (dxf 43 data) (plusp (dxf 43 data))) (add "Width  ~A" (fmt-len (dxf 43 data)))))))
        ((equal type "ELLIPSE")
         (let* ((m (pt3 (dxf 11 data))) (major (* 2 (sqrt (+ (expt (px m) 2) (expt (py m) 2)))))
                (ratio (or (dxf 40 data) 1d0)))
           (add "Ellipse")
           (add "Major axis  ~A    Minor axis  ~A" (fmt-len major) (fmt-len (* ratio major)))))
        ((equal type "HELIX")
         (add "Helix  ~A turns" (fmt-plain (or (dxf 41 data) 1)))
         (add "Length  ~A" (fmt-len (funcall 'helix-length data))))
        ((equal type "SPLINE")
         (add "Spline")
         (add "Length  ~A" (fmt-len (polyline-length (spline-points data)))))
        ((member type '("TEXT" "ATTDEF" "ATTRIB") :test #'equal)
         (add "Text  \"~A\"" (let ((s (or (dxf 1 data) ""))) (if (> (length s) 40) (concatenate 'string (subseq s 0 40) "...") s)))
         (add "Style  ~A    Height  ~A" (or (dxf 7 data) "Standard") (fmt-len (or (dxf 40 data) 0)))
         (when (and (dxf 50 data) (/= (dxf 50 data) 0)) (add "Rotation  ~A" (fmt-ang (dxf 50 data)))))
        ((equal type "MTEXT")
         (let ((s (mtext-plain-text (or (dxf 1 data) ""))))
           (add "MText  \"~A\"" (if (> (length s) 40) (concatenate 'string (subseq s 0 40) "...") s)))
         (add "Style  ~A    Height  ~A" (or (dxf 7 data) "Standard") (fmt-len (or (dxf 40 data) 0)))
         (when (and (dxf 41 data) (plusp (dxf 41 data))) (add "Box width  ~A" (fmt-len (dxf 41 data)))))
        ((equal type "DIMENSION")
         (add "Dimension")
         (add "Measurement  ~A" (if (dxf 42 data)
                                    (if (= (logand (or (dxf 70 data) 0) 7) 2) (fmt-ang (dxf 42 data)) (fmt-len (dxf 42 data)))
                                    "-"))
         (add "Style  ~A" (or (dxf 3 data) "Standard")))
        ((equal type "LEADER") (add "Leader") (add "Style  ~A" (or (dxf 3 data) "Standard")))
        ((equal type "INSERT")
         (add "Block  ~A" (dxf 2 data))
         (let ((sx (or (dxf 41 data) 1d0)) (sy (or (dxf 42 data) 1d0)))
           (add "Scale  ~A~:[  x  ~A~;~*~]" (fmt-plain sx) (= sx sy) (fmt-plain sy)))
         (when (and (dxf 50 data) (/= (dxf 50 data) 0)) (add "Rotation  ~A" (fmt-ang (dxf 50 data))))
         (let ((b (ignore-errors (entity-bbox e))))
           (when b (add "Size  ~A  x  ~A" (fmt-len (- (third b) (first b))) (fmt-len (- (fourth b) (second b)))))))
        ((equal type "HATCH")
         (add "Hatch  ~A" (if (eql (dxf 70 data) 1) "SOLID" (or (dxf 2 data) "")))
         (unless (eql (dxf 70 data) 1)
           (add "Scale  ~A    Angle  ~A" (fmt-plain (or (dxf 41 data) 1d0)) (fmt-ang (or (dxf 52 data) 0d0))))
         (let ((a (ignore-errors (abs (reduce #'+ (mapcar (lambda (lp) (loop-signed-area (loop-polygon-directed lp 32)))
                                                         (hatch-loops data)))))))
           (when a (add "Area  ~A" (fmt-area a)))))
        ((equal type "POINT") (add "Point"))
        ((equal type "POLYFACE")
         (add "3D Solid (mesh)")
         (let ((vol (mesh-volume data))) (if (> vol 1d-12) (add "Volume  ~A" (fmt-num vol)) (add "Open surface"))))
        (t (add "~A" (type-display-name type))))
      (add "Layer  ~A" layer)
      (nreverse lines))))

(defun mtext-plain-text (s)
  "MTEXT contents without formatting codes, on one line."
  (let ((s (substitute #\Space #\Newline s)))
    (with-output-to-string (o)
      (loop with i = 0 while (< i (length s))
            do (let ((c (char s i)))
                 (cond ((and (char= c #\\) (< (1+ i) (length s)))
                        (let ((n (char s (1+ i))))
                          (cond ((member n '(#\P #\p)) (write-char #\Space o) (incf i 2))
                                ((member n '(#\\ #\{ #\})) (write-char n o) (incf i 2))
                                ((member n '(#\f #\F #\H #\W #\Q #\T #\A #\C #\c #\p))
                                 (let ((semi (position #\; s :start i))) (setf i (if semi (1+ semi) (length s)))))
                                (t (incf i 2)))))
                       ((member c '(#\{ #\})) (incf i))
                       (t (write-char c o) (incf i))))))))

(defun rollover-allowed-p ()
  (and (eq *ui* :gui)
       (not (eql (sysvar "ROLLOVERTIPS") 0))
       *req*
       (member (inreq-kind *req*) '(:command :select-point :entity))))

(defun handle-rollover (sx sy)
  "Show the tooltip for the object under screen point SX,SY (or hide it)."
  (let ((e (and (rollover-allowed-p) (ignore-errors (pick-entity-at (s->w sx sy))))))
    (if e
        (let ((lines (ignore-errors (rollover-lines e))))
          (if lines
              (tk "rolltip ~D ~D ~A" sx sy (tq (format nil "~{~A~^~%~}" lines)))
              (tk "rolltip_hide")))
        (tk "rolltip_hide"))))
