;;;; dxf2000.lisp — DXF writer for AutoCAD 2000 format (AC1015), the default for SAVE.
;;;; Keeps lineweights, linetype scales, LWPOLYLINE, MTEXT, ELLIPSE, SPLINE, HATCH and DIMENSION.

(in-package :lispdraft)

(defvar *h2000* 0 "Handle counter while writing.")
(defun h2 () (format nil "~X" (incf *h2000*)))

(defun dxf-escape (s)
  "ANSI DXF strings: non-ASCII characters become \\U+XXXX."
  (if (every (lambda (c) (< (char-code c) 128)) s)
      s
      (with-output-to-string (o)
        (loop for c across s
              do (if (< (char-code c) 128) (write-char c o) (format o "\\U+~4,'0X" (char-code c)))))))

(defun w (out code val)
  (format out "~3D~%" code)
  (cond ((floatp val) (format out "~A~%" (fmt-real val)))
        ((integerp val) (format out "~6D~%" val))
        ((stringp val) (format out "~A~%" (dxf-escape val)))
        (t (format out "~A~%" val))))
(defun wp (out code p &optional (two-d nil))
  (w out code (px p)) (w out (+ code 10) (py p)) (unless two-d (w out (+ code 20) (pz p))))

(defun write-common (out data handle owner)
  (w out 0 (dxf 0 data)) (w out 5 handle) (w out 330 owner) (w out 100 "AcDbEntity")
  (w out 8 (or (dxf 8 data) "0"))
  (let ((lt (dxf 6 data))) (when (and lt (not (string-equal lt "BYLAYER"))) (w out 6 lt)))
  (let ((c (dxf 62 data))) (when c (w out 62 c)))
  (let ((lw (dxf 370 data))) (when (and lw (/= lw -1)) (w out 370 lw)))
  (let ((s (dxf 48 data))) (when (and s (/= s 1)) (w out 48 (d s)))))

(defun split-chunks (s n)
  (loop for i from 0 below (length s) by n collect (subseq s i (min (length s) (+ i n)))))

(defun write-entity-2000 (out data owner &optional (handle (h2)))
  (let ((type (dxf 0 data)))
    (flet ((common () (write-common out data handle owner)))
      (cond
        ((equal type "LINE")
         (common) (w out 100 "AcDbLine") (wp out 10 (pt3 (dxf 10 data))) (wp out 11 (pt3 (dxf 11 data))))
        ((equal type "CIRCLE")
         (common) (w out 100 "AcDbCircle") (wp out 10 (pt3 (dxf 10 data))) (w out 40 (d (dxf 40 data))))
        ((equal type "ARC")
         (common) (w out 100 "AcDbCircle") (wp out 10 (pt3 (dxf 10 data))) (w out 40 (d (dxf 40 data)))
         (w out 100 "AcDbArc") (w out 50 (deg (dxf 50 data))) (w out 51 (deg (dxf 51 data))))
        ((equal type "POINT")
         (common) (w out 100 "AcDbPoint") (wp out 10 (pt3 (dxf 10 data))))
        ((equal type "LWPOLYLINE")
         (let ((verts (lwpoly-vertices data)))
           (common) (w out 100 "AcDbPolyline") (w out 90 (length verts))
           (w out 70 (if (lwpoly-closed-p data) 1 0))
           (when (dxf 43 data) (w out 43 (d (dxf 43 data))))
           (loop for (p b) in verts do (wp out 10 p t) (unless (zerop b) (w out 42 (d b))))))
        ((member type '("TEXT" "ATTDEF") :test #'equal)
         (common) (w out 100 "AcDbText")
         (wp out 10 (pt3 (dxf 10 data))) (w out 40 (d (or (dxf 40 data) 0.2d0)))
         (w out 1 (or (dxf 1 data) ""))
         (when (and (dxf 50 data) (/= (dxf 50 data) 0)) (w out 50 (deg (dxf 50 data))))
         (when (dxf 41 data) (w out 41 (d (dxf 41 data))))
         (when (dxf 7 data) (w out 7 (dxf 7 data)))
         (let ((h (or (dxf 72 data) 0)) (v (or (dxf 73 data) 0)))
           (when (/= h 0) (w out 72 h))
           (when (and (or (/= h 0) (/= v 0)) (dxf 11 data)) (wp out 11 (pt3 (dxf 11 data))))
           (if (equal type "ATTDEF")
               (progn (w out 100 "AcDbAttributeDefinition") (w out 280 0)
                      (w out 3 (or (dxf 3 data) "")) (w out 2 (or (dxf 2 data) "TAG")) (w out 70 (or (dxf 70 data) 0))
                      (when (/= v 0) (w out 74 v)))
               (progn (w out 100 "AcDbText") (when (/= v 0) (w out 73 v))))))
        ((equal type "MTEXT")
         (let* ((s (or (dxf 1 data) "")) (chunks (split-chunks (dxf-escape s) 250)) (rot (or (dxf 50 data) 0d0)))
           (common) (w out 100 "AcDbMText") (wp out 10 (pt3 (dxf 10 data)))
           (w out 40 (d (or (dxf 40 data) 0.2d0))) (w out 41 (d (or (dxf 41 data) 0d0)))
           (w out 71 (or (dxf 71 data) 1)) (w out 72 1)
           (if (null chunks) (w out 1 "")
               (progn (dolist (c (butlast chunks)) (format out "  3~%~A~%" c))
                      (format out "  1~%~A~%" (car (last chunks)))))
           (when (dxf 7 data) (w out 7 (dxf 7 data)))
           (wp out 11 (pt (cos rot) (sin rot)))))
        ((equal type "INSERT")
         (common) (w out 100 "AcDbBlockReference") (w out 2 (dxf 2 data)) (wp out 10 (pt3 (dxf 10 data)))
         (w out 41 (d (or (dxf 41 data) 1))) (w out 42 (d (or (dxf 42 data) 1))) (w out 43 (d (or (dxf 43 data) 1)))
         (when (and (dxf 50 data) (/= (dxf 50 data) 0)) (w out 50 (deg (dxf 50 data)))))
        ((equal type "ELLIPSE")
         (common) (w out 100 "AcDbEllipse") (wp out 10 (pt3 (dxf 10 data))) (wp out 11 (pt3 (dxf 11 data)))
         (wp out 210 (pt 0 0 1)) (w out 40 (d (or (dxf 40 data) 1))) (w out 41 (d (or (dxf 41 data) 0)))
         (w out 42 (d (or (dxf 42 data) +2pi+))))
        ((equal type "SPLINE")
         (common) (w out 100 "AcDbSpline")
         (dolist (pair data)
           (when (and (consp pair) (integerp (car pair))
                      (not (member (car pair) '(0 5 6 8 48 62 100 330 370))))
             (if (and (consp (cdr pair)) (realp (cadr pair)))
                 (wp out (car pair) (pt3 (cdr pair)))
                 (w out (car pair) (cdr pair))))))
        ((equal type "SOLID")
         (common) (w out 100 "AcDbTrace")
         (dolist (c '(10 11 12 13)) (wp out c (pt3 (or (dxf c data) (dxf 12 data) (pt 0 0))))))
        ((equal type "HATCH") (common) (write-hatch-body out data))
        ((equal type "DIMENSION") (common) (write-dimension-body out data))
        (t nil)))))

(defun write-hatch-body (out data)
  (let* ((name (or (dxf 2 data) "ANSI31"))
         (solid (or (eql (dxf 70 data) 1) (solid-pattern-p name)))
         (loops (hatch-loops data)))
    (w out 100 "AcDbHatch") (wp out 10 (pt 0 0)) (wp out 210 (pt 0 0 1))
    (w out 2 (if solid "SOLID" name)) (w out 70 (if solid 1 0)) (w out 71 0)
    (w out 91 (length loops))
    (loop for lp in loops for first = t then nil
          do (let ((bulgy (some (lambda (v) (/= (second v) 0)) lp)))
               (w out 92 (if first 3 2)) (w out 72 (if bulgy 1 0)) (w out 73 1) (w out 93 (length lp))
               (dolist (v lp)
                 (wp out 10 (first v) t)
                 (when bulgy (w out 42 (d (second v)))))
               (w out 97 0)))
    (w out 75 0) (w out 76 1)
    (unless solid
      (let ((lines (hatch-pattern-lines data)))
        (w out 52 (deg (or (dxf 52 data) 0d0))) (w out 41 (d (or (dxf 41 data) 1))) (w out 77 0)
        (w out 78 (length lines))
        (dolist (l lines)
          (destructuring-bind (a base off dashes) l
            (w out 53 (deg a)) (w out 43 (px base)) (w out 44 (py base))
            (w out 45 (px off)) (w out 46 (py off)) (w out 79 (length dashes))
            (dolist (x dashes) (w out 49 (d x)))))))
    (w out 98 0)))

(defun write-dimension-body (out data)
  (let ((type (logand (or (dxf 70 data) 0) 7)))
    (w out 100 "AcDbDimension") (w out 2 (or (dxf 2 data) ""))
    (wp out 10 (pt3 (or (dxf 10 data) (pt 0 0)))) (wp out 11 (pt3 (or (dxf 11 data) (pt 0 0))))
    (w out 70 (logior 32 type (logand (or (dxf 70 data) 0) 128))) (w out 1 (or (dxf 1 data) ""))
    (w out 3 (if (find-dimstyle (dxf 3 data)) (dimstyle-name (find-dimstyle (dxf 3 data))) "Standard"))
    (case type
      ((0 1) (w out 100 "AcDbAlignedDimension")
       (wp out 13 (pt3 (or (dxf 13 data) (pt 0 0)))) (wp out 14 (pt3 (or (dxf 14 data) (pt 0 0))))
       (when (= type 0)
         (w out 50 (deg (or (dxf 50 data) 0d0))) (w out 100 "AcDbRotatedDimension")))
      (2 (w out 100 "AcDb2LineAngularDimension")
       (dolist (c '(13 14 15 16)) (wp out c (pt3 (or (dxf c data) (pt 0 0))))))
      (5 (w out 100 "AcDb3PointAngularDimension")
       (dolist (c '(13 14 15)) (wp out c (pt3 (or (dxf c data) (pt 0 0))))))
      (3 (w out 100 "AcDbDiametricDimension") (wp out 15 (pt3 (or (dxf 15 data) (pt 0 0))))
       (w out 40 (d (or (dxf 40 data) 0))))
      (4 (w out 100 "AcDbRadialDimension") (wp out 15 (pt3 (or (dxf 15 data) (pt 0 0))))
       (w out 40 (d (or (dxf 40 data) 0))))
      (6 (w out 100 "AcDbOrdinateDimension")
       (wp out 13 (pt3 (or (dxf 13 data) (pt 0 0)))) (wp out 14 (pt3 (or (dxf 14 data) (pt 0 0))))))))

(defun dimstyle-vars-for-dxf (vars)
  "DIMSTYLE table groups for a dimension-variable plist."
  (flet ((v (n default) (let ((x (getf vars n :none))) (if (eq x :none) default x))))
    (list (cons 3 (v :dimpost "")) (cons 40 (d (v :dimscale 1))) (cons 41 (d (v :dimasz 0.18)))
          (cons 42 (d (v :dimexo 0.0625))) (cons 43 (d (v :dimdli 0.38))) (cons 44 (d (v :dimexe 0.18)))
          (cons 140 (d (v :dimtxt 0.18))) (cons 141 (d (v :dimcen 0.09))) (cons 142 (d (v :dimtsz 0)))
          (cons 144 (d (v :dimlfac 1))) (cons 147 (d (v :dimgap 0.09))) (cons 73 (v :dimtih 0))
          (cons 77 (v :dimtad 1)) (cons 271 (v :dimdec 4)) (cons 176 (v :dimclrd 0))
          (cons 177 (v :dimclre 0)) (cons 178 (v :dimclrt 0)))))

(defun dxf-export-2000 (path)
  (let* ((*h2000* (+ (drawing-next-handle *dwg*) 16))
         (ext (or (drawing-extents) (list 0d0 0d0 12d0 9d0)))
         (ents (live-entities))
         (blocks (reverse (drawing-blocks *dwg*)))
         (ltypes (remove-duplicates
                  (append (mapcar #'ltype-name (drawing-ltypes *dwg*))
                          (remove-if #'continuous-name-p
                                     (append (mapcar #'layer-ltype (drawing-layers *dwg*))
                                             (mapcar (lambda (e) (dxf 6 (ename-data e))) ents)
                                             (loop for b in blocks append (mapcar (lambda (dd) (dxf 6 dd)) (block-def-entities b))))))
                  :test #'string-equal))
         (styles (remove-duplicates
                  (remove-if (lambda (n) (or (not (stringp n)) (string-equal n "Standard")))
                             (append (mapcar (lambda (e) (dxf 7 (ename-data e))) ents)
                                     (loop for b in blocks append (mapcar (lambda (dd) (dxf 7 dd)) (block-def-entities b)))))
                  :test #'string-equal))
         ;; fixed handles for tables and objects
         (h-vport-t (h2)) (h-ltype-t (h2)) (h-layer-t (h2)) (h-style-t (h2)) (h-view-t (h2)) (h-ucs-t (h2))
         (h-appid-t (h2)) (h-dimstyle-t (h2)) (h-br-t (h2))
         (h-root (h2)) (h-group (h2)) (h-psn (h2)) (h-placeholder (h2))
         (h-ms-br (h2)) (h-ps-br (h2))
         (block-brs (mapcar (lambda (b) (cons b (h2))) blocks)))
    (with-open-file (out path :direction :output :if-exists :supersede :external-format :latin-1)
      ;; HEADER
      (w out 0 "SECTION") (w out 2 "HEADER")
      (w out 9 "$ACADVER") (w out 1 "AC1015")
      (w out 9 "$ACADMAINTVER") (w out 70 6)
      (w out 9 "$DWGCODEPAGE") (w out 3 "ANSI_1252")
      (w out 9 "$INSBASE") (wp out 10 (pt 0 0))
      (w out 9 "$EXTMIN") (wp out 10 (pt (first ext) (second ext)))
      (w out 9 "$EXTMAX") (wp out 10 (pt (third ext) (fourth ext)))
      (w out 9 "$LIMMIN") (wp out 10 (pt3 (sysvar "LIMMIN")) t)
      (w out 9 "$LIMMAX") (wp out 10 (pt3 (sysvar "LIMMAX")) t)
      (w out 9 "$LTSCALE") (w out 40 (d (sysvar "LTSCALE")))
      (w out 9 "$TEXTSIZE") (w out 40 (d (sysvar "TEXTSIZE")))
      (w out 9 "$CLAYER") (w out 8 (sysvar "CLAYER"))
      (w out 9 "$CELTYPE") (w out 6 (let ((c (sysvar "CELTYPE"))) (if (string-equal c "BYLAYER") "ByLayer" c)))
      (w out 9 "$CELWEIGHT") (w out 370 (sysvar "CELWEIGHT"))
      (w out 9 "$CELTSCALE") (w out 40 (d (sysvar "CELTSCALE")))
      (w out 9 "$LWDISPLAY") (w out 290 (sysvar "LWDISPLAY"))
      (w out 9 "$DIMSTYLE") (w out 2 (sysvar "DIMSTYLE"))
      (dolist (v '(("$DIMSCALE" 40) ("$DIMASZ" 40) ("$DIMTXT" 40) ("$DIMEXO" 40) ("$DIMEXE" 40) ("$DIMGAP" 40)
                   ("$DIMDEC" 70) ("$DIMTAD" 70)))
        (let ((val (sysvar (subseq (first v) 1))))
          (w out 9 (first v)) (w out (second v) (if (= (second v) 70) (round val) (d val)))))
      (w out 9 "$INSUNITS") (w out 70 (sysvar "INSUNITS"))
      (w out 9 "$MEASUREMENT") (w out 70 (sysvar "MEASUREMENT"))
      (w out 9 "$HANDSEED") (w out 5 "FFFFF")   ; patched below
      (w out 0 "ENDSEC")
      (w out 0 "SECTION") (w out 2 "CLASSES") (w out 0 "ENDSEC")
      ;; TABLES
      (w out 0 "SECTION") (w out 2 "TABLES")
      (flet ((table (name h n) (w out 0 "TABLE") (w out 2 name) (w out 5 h) (w out 330 "0")
               (w out 100 "AcDbSymbolTable") (w out 70 n))
             (rec (type owner sub) (w out 0 type) (w out 5 (h2)) (w out 330 owner)
               (w out 100 "AcDbSymbolTableRecord") (w out 100 sub)))
        (table "VPORT" h-vport-t 1)
        (rec "VPORT" h-vport-t "AcDbViewportTableRecord")
        (w out 2 "*ACTIVE") (w out 70 0) (wp out 10 (pt 0 0) t) (wp out 11 (pt 1 1) t)
        (wp out 12 (if (eq *ui* :gui) (pt *vx* *vy*) (pt 6 4.5)) t)
        (wp out 13 (pt 0 0) t) (wp out 14 (pt 0.5 0.5) t) (wp out 15 (pt 0.5 0.5) t)
        (wp out 16 (pt 0 0 1)) (wp out 17 (pt 0 0 0))
        (w out 40 (d (if (eq *ui* :gui) (/ *ch* *vscale*) 9))) (w out 41 (d (if (eq *ui* :gui) (/ *cw* *ch*) 1.6)))
        (w out 42 50d0) (w out 43 0d0) (w out 44 0d0) (w out 50 0d0) (w out 51 0d0)
        (w out 71 0) (w out 72 100) (w out 73 1) (w out 74 3) (w out 75 0) (w out 76 0) (w out 77 0) (w out 78 0)
        (w out 0 "ENDTAB")
        (table "LTYPE" h-ltype-t (+ 3 (length ltypes)))
        (dolist (n '("ByBlock" "ByLayer" "Continuous"))
          (rec "LTYPE" h-ltype-t "AcDbLinetypeTableRecord")
          (w out 2 n) (w out 70 0) (w out 3 (if (string= n "Continuous") "Solid line" "")) (w out 72 65) (w out 73 0) (w out 40 0d0))
        (dolist (n ltypes)
          (let* ((lt (or (find-ltype n) (library-linetype n))) (pat (and lt (ltype-pattern lt))))
            (rec "LTYPE" h-ltype-t "AcDbLinetypeTableRecord")
            (w out 2 n) (w out 70 0) (w out 3 (if lt (ltype-desc lt) n)) (w out 72 65) (w out 73 (length pat))
            (w out 40 (d (reduce #'+ (mapcar #'abs pat))))
            (dolist (x pat) (w out 49 (d x)) (w out 74 0))))
        (w out 0 "ENDTAB")
        (table "LAYER" h-layer-t (length (drawing-layers *dwg*)))
        (dolist (l (drawing-layers *dwg*))
          (rec "LAYER" h-layer-t "AcDbLayerTableRecord")
          (w out 2 (layer-name l))
          (w out 70 (logior (if (layer-frozen l) 1 0) (if (layer-locked l) 4 0)))
          (w out 62 (* (if (layer-on l) 1 -1) (max 1 (abs (layer-color l)))))
          (w out 6 (let ((n (layer-ltype l))) (if (continuous-name-p n) "Continuous" n)))
          (w out 370 (layer-lineweight l))
          (w out 390 h-placeholder))
        (w out 0 "ENDTAB")
        (table "STYLE" h-style-t (1+ (length styles)))
        (dolist (n (cons "Standard" styles))
          (rec "STYLE" h-style-t "AcDbTextStyleTableRecord")
          (w out 2 n) (w out 70 0) (w out 40 0d0) (w out 41 1d0) (w out 50 0d0) (w out 71 0) (w out 42 0.2d0)
          (w out 3 "txt") (w out 4 ""))
        (w out 0 "ENDTAB")
        (table "VIEW" h-view-t 0) (w out 0 "ENDTAB")
        (table "UCS" h-ucs-t 0) (w out 0 "ENDTAB")
        (table "APPID" h-appid-t 1)
        (rec "APPID" h-appid-t "AcDbRegAppTableRecord") (w out 2 "ACAD") (w out 70 0)
        (w out 0 "ENDTAB")
        ;; DIMSTYLE records carry their handle in group 105
        (let ((styles (all-dimstyles)))
          (w out 0 "TABLE") (w out 2 "DIMSTYLE") (w out 5 h-dimstyle-t) (w out 330 "0") (w out 100 "AcDbSymbolTable")
          (w out 70 (length styles)) (w out 100 "AcDbDimStyleTable") (w out 71 0)
          (dolist (ds styles)
            (w out 0 "DIMSTYLE") (w out 105 (h2)) (w out 330 h-dimstyle-t)
            (w out 100 "AcDbSymbolTableRecord") (w out 100 "AcDbDimStyleTableRecord")
            (w out 2 (dimstyle-name ds)) (w out 70 0)
            (loop for (code . val) in (dimstyle-vars-for-dxf (dimstyle-vars ds)) do (w out code val))))
        (w out 0 "ENDTAB")
        (table "BLOCK_RECORD" h-br-t (+ 2 (length blocks)))
        (flet ((br (name h) (w out 0 "BLOCK_RECORD") (w out 5 h) (w out 330 h-br-t)
                 (w out 100 "AcDbSymbolTableRecord") (w out 100 "AcDbBlockTableRecord") (w out 2 name)))
          (br "*Model_Space" h-ms-br) (br "*Paper_Space" h-ps-br)
          (dolist (bb block-brs) (br (block-def-name (car bb)) (cdr bb))))
        (w out 0 "ENDTAB"))
      (w out 0 "ENDSEC")
      ;; BLOCKS
      (w out 0 "SECTION") (w out 2 "BLOCKS")
      (flet ((block-begin (name br base flags)
               (w out 0 "BLOCK") (w out 5 (h2)) (w out 330 br) (w out 100 "AcDbEntity") (w out 8 "0")
               (w out 100 "AcDbBlockBegin") (w out 2 name) (w out 70 flags) (wp out 10 base) (w out 3 name) (w out 1 ""))
             (block-end (br)
               (w out 0 "ENDBLK") (w out 5 (h2)) (w out 330 br) (w out 100 "AcDbEntity") (w out 8 "0")
               (w out 100 "AcDbBlockEnd")))
        (block-begin "*Model_Space" h-ms-br (pt 0 0) 0) (block-end h-ms-br)
        (block-begin "*Paper_Space" h-ps-br (pt 0 0) 0) (block-end h-ps-br)
        (dolist (bb block-brs)
          (let ((b (car bb)))
            (block-begin (block-def-name b) (cdr bb) (block-def-base b)
                         (if (char= (char (block-def-name b) 0) #\*) 1 0))
            (dolist (dd (block-def-entities b)) (write-entity-2000 out dd (cdr bb)))
            (block-end (cdr bb)))))
      (w out 0 "ENDSEC")
      ;; ENTITIES
      (w out 0 "SECTION") (w out 2 "ENTITIES")
      (dolist (e ents) (write-entity-2000 out (ename-data e) h-ms-br (ename-handle e)))
      (w out 0 "ENDSEC")
      ;; OBJECTS
      (w out 0 "SECTION") (w out 2 "OBJECTS")
      (w out 0 "DICTIONARY") (w out 5 h-root) (w out 330 "0") (w out 100 "AcDbDictionary") (w out 281 1)
      (w out 3 "ACAD_GROUP") (w out 350 h-group)
      (w out 3 "ACAD_PLOTSTYLENAME") (w out 350 h-psn)
      (w out 0 "DICTIONARY") (w out 5 h-group) (w out 330 h-root) (w out 100 "AcDbDictionary") (w out 281 1)
      (w out 0 "ACDBDICTIONARYWDFLT") (w out 5 h-psn) (w out 330 h-root) (w out 100 "AcDbDictionary") (w out 281 1)
      (w out 3 "Normal") (w out 350 h-placeholder) (w out 100 "AcDbDictionaryWithDefault") (w out 340 h-placeholder)
      (w out 0 "ACDBPLACEHOLDER") (w out 5 h-placeholder) (w out 330 h-psn)
      (w out 0 "ENDSEC")
      (w out 0 "EOF"))
    ;; patch $HANDSEED now that all handles are known
    (patch-handseed path (format nil "~X" (1+ *h2000*))))
  (setf (drawing-filename *dwg*) (namestring path)
        (drawing-saved-modcount *dwg*) (drawing-modcount *dwg*))
  path)

(defun patch-handseed (path seed)
  (let* ((lines (with-open-file (in path :external-format :latin-1)
                  (loop for l = (read-line in nil) while l collect l)))
         (pos (position "$HANDSEED" lines :test #'string=)))
    (when pos (setf (nth (+ pos 2) lines) seed))
    (with-open-file (out path :direction :output :if-exists :supersede :external-format :latin-1)
      (dolist (l lines) (write-line l out)))))
