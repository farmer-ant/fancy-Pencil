;;;; calc.lisp — the calculator: CAL expressions (as AutoCAD's CAL and QuickCalc read them), the
;;;; CAL command, QUICKCALC (the window, in gui.tcl), and 'CAL / 'QC typed in the middle of a command.
;;;;
;;;; Expressions: numbers (also 5'6", 3/4 as 0.75 via division), + - * / ^ and brackets; points
;;;; [x,y,z] and [dist<angle]; with points + - add, number*point scales, point*point is the dot
;;;; product and point&point the cross product. Angles are in degrees. Functions:
;;;;   sin cos tan asin acos atan  ln log exp exp10  sqr sqrt abs round trunc  r2d d2r  min max
;;;;   dist(p1,p2)  ang(p1,p2) or ang(vector)  cvunit(value, "from", "to")  xof(p) yof(p) zof(p)
;;;; and, picking in the drawing: cur, end mid cen int nea qua per nod ins (a point with that snap),
;;;; rad (radius of a picked circle or arc), dee (distance between two endpoints), mee (midpoint
;;;; between two endpoints), ille (intersection of two lines through four endpoints).
;;;; name=expression keeps a variable (shared with AutoLISP, as CAL does); pi and Phi are known.

(in-package :fancy-pencil)

(define-condition calc-error (error) ((msg :initarg :msg :reader calc-msg))
  (:report (lambda (c s) (write-string (calc-msg c) s))))
(defun cerr (fmt &rest args) (error 'calc-error :msg (apply #'format nil fmt args)))

(defvar *calc-vars* (make-hash-table :test #'equalp) "QuickCalc's own variables (name -> value).")
(defvar *calc-last* nil "The last result.")

;;; ---------- reading ----------

(defun calc-tokens (s)
  (let ((out nil) (i 0) (n (length s)))
    (loop while (< i n)
          do (let ((c (char s i)))
               (cond ((member c '(#\Space #\Tab)) (incf i))
                     ((or (digit-char-p c) (and (char= c #\.) (< (1+ i) n) (digit-char-p (char s (1+ i)))))
                      ;; a number, maybe feet and inches: 5'6"  2'  6.5"
                      (let ((j i))
                        (loop while (and (< j n) (or (digit-char-p (char s j)) (char= (char s j) #\.)
                                                     (and (char-equal (char s j) #\e) (< (1+ j) n)
                                                          (or (digit-char-p (char s (1+ j)))
                                                              (and (find (char s (1+ j)) "+-") (< (+ j 2) n) (digit-char-p (char s (+ j 2))))))
                                                     (and (find (char s j) "+-") (> j i) (char-equal (char s (1- j)) #\e))))
                              do (incf j))
                        (when (and (< j n) (char= (char s j) #\'))
                          (incf j)
                          (when (and (< j n) (char= (char s j) #\-)) (incf j))
                          (loop while (and (< j n) (or (digit-char-p (char s j)) (char= (char s j) #\.))) do (incf j)))
                        (when (and (< j n) (char= (char s j) #\")) (incf j))
                        (let* ((txt (subseq s i j))
                               (v (or (and (not (find-if (lambda (ch) (find ch "'\"")) txt))
                                           (ignore-errors (let ((*read-default-float-format* 'double-float))
                                                            (d (parse-xps-real txt)))))
                                      (ignore-errors (distof txt 4))
                                      (cerr "Can't read the number ~A." txt))))
                          (push (cons :num (d v)) out))
                        (setf i j)))
                     ((or (alpha-char-p c) (char= c #\_))
                      (let ((j i))
                        (loop while (and (< j n) (or (alphanumericp (char s j)) (char= (char s j) #\_))) do (incf j))
                        (push (cons :id (subseq s i j)) out)
                        (setf i j)))
                     ((char= c #\")
                      (let ((j (position #\" s :start (1+ i))))
                        (unless j (cerr "A text in quotes isn't closed."))
                        (push (cons :str (subseq s (1+ i) j)) out)
                        (setf i (1+ j))))
                     ((find c "+-*/^()[],<=&@")
                      (push (cons :op c) out) (incf i))
                     (t (cerr "\"~A\" isn't understood here." c)))))
    (nreverse out)))

;;; ---------- values ----------

(defun cpt-p (v) (and (consp v) (= (length v) 3) (every #'realp v)))
(defun cnum (v what) (if (realp v) v (cerr "~A needs a number." what)))
(defun cpt (v what) (cond ((cpt-p v) v) ((and (consp v) (= (length v) 2)) (pt3 v)) (t (cerr "~A needs a point." what))))

(defun c+ (a b) (cond ((and (realp a) (realp b)) (+ a b)) ((and (cpt-p a) (cpt-p b)) (v+ a b)) (t (cerr "Can't add a number and a point."))))
(defun c- (a b) (cond ((and (realp a) (realp b)) (- a b)) ((and (cpt-p a) (cpt-p b)) (v- a b)) (t (cerr "Can't subtract a number and a point."))))
(defun c* (a b)
  (cond ((and (realp a) (realp b)) (* a b))
        ((and (realp a) (cpt-p b)) (v* b a)) ((and (cpt-p a) (realp b)) (v* a b))
        (t (vdot3 a b))))
(defun c/ (a b)
  (cond ((and (realp b) (zerop b)) (cerr "Division by zero."))
        ((and (realp a) (realp b)) (/ a b))
        ((and (cpt-p a) (realp b)) (v* a (/ 1 b)))
        (t (cerr "Can't divide by a point."))))

;;; ---------- picking in the drawing ----------

(defun calc-pick (bits prompt)
  (unless (gui-p) (cerr "Picking needs the drawing window."))
  (let ((p (get-user-input :point :prompt prompt :osnap (and bits (plusp bits) bits))))
    (unless (pointp p) (cerr "No point picked."))
    (pt3 p)))

(defun calc-pick-radius ()
  (unless (gui-p) (cerr "Picking needs the drawing window."))
  (let* ((r (get-user-input :entity :prompt ">> Select circle, arc or polyline segment for RAD function: "))
         (e (and (consp r) (sel-entity r))))
    (unless e (cerr "Nothing picked."))
    (let ((dd (ename-data e)))
      (or (and (member (dxf 0 dd) '("CIRCLE" "ARC") :test #'equal) (dxf 40 dd))
          (let ((pc (find-if (lambda (pc) (member (first pc) '(:arc :circle))) (entity-pieces e))))
            (and pc (third pc)))
          (cerr "That has no radius.")))))

(defparameter +calc-snaps+
  '(("END" 1) ("MID" 2) ("CEN" 4) ("NOD" 8) ("QUA" 16) ("INT" 32) ("INS" 64) ("PER" 128) ("TAN" 256) ("NEA" 512)))

;;; ---------- evaluating ----------

(defun calc-var (name)
  (cond ((string-equal name "pi") (d +pi+))
        ((string-equal name "Phi") 1.618033988749895d0)
        ((string-equal name "e") (exp 1d0))
        ((nth-value 1 (gethash name *calc-vars*)) (gethash name *calc-vars*))
        (t (let ((v (ignore-errors (sym-value (asym name)))))
             (cond ((realp v) (d v))
                   ((and (consp v) (every #'realp v) (<= 2 (length v) 3)) (pt3 (mapcar #'d v)))
                   (t (cerr "~A isn't a known variable or function." name)))))))

(defun calc-call (name args)
  (flet ((a1 () (unless (= (length args) 1) (cerr "~A takes one value." name)) (first args))
         (a2 () (unless (= (length args) 2) (cerr "~A takes two values." name)) (values (first args) (second args))))
    (let ((u (string-upcase name)))
      (cond
        ((string= u "SIN") (sin (rad (cnum (a1) name))))
        ((string= u "COS") (cos (rad (cnum (a1) name))))
        ((string= u "TAN") (tan (rad (cnum (a1) name))))
        ((string= u "ASIN") (deg (asin (max -1d0 (min 1d0 (cnum (a1) name))))))
        ((string= u "ACOS") (deg (acos (max -1d0 (min 1d0 (cnum (a1) name))))))
        ((string= u "ATAN") (if (= (length args) 2)
                                (deg (atan (cnum (first args) name) (cnum (second args) name)))
                                (deg (atan (cnum (a1) name)))))
        ((string= u "LN") (let ((x (cnum (a1) name))) (if (plusp x) (log x) (cerr "LN needs a number above 0."))))
        ((string= u "LOG") (let ((x (cnum (a1) name))) (if (plusp x) (/ (log x) (log 10d0)) (cerr "LOG needs a number above 0."))))
        ((string= u "EXP") (exp (cnum (a1) name)))
        ((string= u "EXP10") (expt 10d0 (cnum (a1) name)))
        ((string= u "SQR") (let ((x (cnum (a1) name))) (* x x)))
        ((string= u "SQRT") (let ((x (cnum (a1) name))) (if (minusp x) (cerr "SQRT needs a number not below 0.") (sqrt x))))
        ((string= u "ABS") (let ((x (a1))) (if (cpt-p x) (sqrt (vdot3 x x)) (abs x))))
        ((string= u "ROUND") (let ((x (cnum (a1) name))) (d (* (if (minusp x) -1 1) (floor (+ (abs x) 1/2))))))
        ((string= u "TRUNC") (d (truncate (cnum (a1) name))))
        ((string= u "R2D") (deg (cnum (a1) name)))
        ((string= u "D2R") (rad (cnum (a1) name)))
        ((string= u "MIN") (reduce #'min (mapcar (lambda (x) (cnum x name)) args)))
        ((string= u "MAX") (reduce #'max (mapcar (lambda (x) (cnum x name)) args)))
        ((string= u "XOF") (px (cpt (a1) name)))
        ((string= u "YOF") (py (cpt (a1) name)))
        ((string= u "ZOF") (pz (cpt (a1) name)))
        ((string= u "DIST") (multiple-value-bind (p q) (a2) (dist (cpt p name) (cpt q name))))
        ((string= u "ANG") (if (= (length args) 1)
                               (let ((v (cpt (a1) name))) (deg (norm-ang (atan (py v) (px v)))))
                               (multiple-value-bind (p q) (a2) (deg (ang (cpt p name) (cpt q name))))))
        ((string= u "CVUNIT")
         (unless (= (length args) 3) (cerr "CVUNIT takes a value and two unit names."))
         (let ((r (funcall (alisp-function "cvunit") (first args) (second args) (third args))))
           (or r (cerr "CVUNIT doesn't know those units."))))
        (t (cerr "~A isn't a known function." name))))))

(defun alisp-function (name)
  "The Lisp function behind AutoLISP built-in NAME."
  (let ((s (ignore-errors (symbol-value (asym name)))))
    (if (subr-p s) (subr-fn s) (lambda (&rest r) (declare (ignore r)) nil))))

(defun calc-eval (text)
  "The value of CAL expression TEXT: a number or a point (x y z). Signals CALC-ERROR."
  (let ((toks (calc-tokens text)) (assign nil))
    (when (and (eq (car (first toks)) :id) (equal (second toks) '(:op . #\=)))
      (setf assign (cdr (first toks)) toks (cddr toks)))
    (labels ((peek () (first toks))
             (next () (pop toks))
             (op-p (c) (equal (peek) (cons :op c)))
             (expect (c) (if (op-p c) (next) (cerr "\"~A\" is missing." c)))
             (expr () (let ((v (term)))
                        (loop (cond ((op-p #\+) (next) (setf v (c+ v (term))))
                                    ((op-p #\-) (next) (setf v (c- v (term))))
                                    (t (return v))))))
             (term () (let ((v (unary)))
                        (loop (cond ((op-p #\*) (next) (setf v (c* v (unary))))
                                    ((op-p #\/) (next) (setf v (c/ v (unary))))
                                    ((op-p #\&) (next) (setf v (cross3 (cpt v "&") (cpt (unary) "&"))))
                                    (t (return v))))))
             (unary () (cond ((op-p #\-) (next) (let ((v (unary))) (if (cpt-p v) (v* v -1) (- v))))
                             ((op-p #\+) (next) (unary))
                             (t (power))))
             (power () (let ((b (primary)))
                         (if (op-p #\^)
                             (progn (next)
                                    (let ((e (unary)))
                                      (let ((r (expt (cnum b "^") (cnum e "^"))))
                                        (if (complexp r) (cerr "That power has no real value.") (d r)))))
                             b)))
             (args () (let ((out nil))
                        (expect #\()
                        (unless (op-p #\))
                          (loop (push (if (eq (car (peek)) :str) (cdr (next)) (expr)) out)
                                (if (op-p #\,) (next) (return))))
                        (expect #\))
                        (nreverse out)))
             (primary ()
               (let ((tk (peek)))
                 (cond ((null tk) (cerr "The expression is unfinished."))
                       ((eq (car tk) :num) (next) (cdr tk))
                       ((equal tk '(:op . #\()) (next) (prog1 (expr) (expect #\))))
                       ((equal tk '(:op . #\[))
                        (next)
                        (when (op-p #\@) (next))      ; [@x,y] is the same as [x,y] here
                        (let ((a (if (op-p #\,) 0d0 (cnum (expr) "A point"))))
                          (cond ((op-p #\<)
                                 (next)
                                 (let* ((an (rad (cnum (expr) "A point's angle")))
                                        (z (if (op-p #\,) (progn (next) (cnum (expr) "A point")) 0d0)))
                                   (expect #\])
                                   (pt (* a (cos an)) (* a (sin an)) z)))
                                (t (let ((b (if (op-p #\,) (progn (next) (if (or (op-p #\,) (op-p #\])) 0d0 (cnum (expr) "A point"))) 0d0))
                                         (c (if (op-p #\,) (progn (next) (if (op-p #\]) 0d0 (cnum (expr) "A point"))) 0d0)))
                                     (expect #\])
                                     (pt (d a) (d b) (d c)))))))
                       ((eq (car tk) :id)
                        (next)
                        (let* ((name (cdr tk)) (u (string-upcase name)) (snap (assoc u +calc-snaps+ :test #'string=)))
                          (cond ((op-p #\() (calc-call name (args)))
                                (snap (calc-pick (second snap) (format nil ">> Select entity for ~A snap: " u)))
                                ((string= u "CUR") (calc-pick 0 ">> Enter a point: "))
                                ((string= u "RAD") (calc-pick-radius))
                                ((string= u "DEE") (dist (calc-pick 1 ">> Select one endpoint for DEE: ")
                                                         (calc-pick 1 ">> Select another endpoint for DEE: ")))
                                ((string= u "MEE") (midpt (calc-pick 1 ">> Select one endpoint for MEE: ")
                                                          (calc-pick 1 ">> Select another endpoint for MEE: ")))
                                ((string= u "ILLE")
                                 (let* ((a (calc-pick 1 ">> Select first endpoint of line 1: ")) (b (calc-pick 1 ">> Select second endpoint of line 1: "))
                                        (c (calc-pick 1 ">> Select first endpoint of line 2: ")) (dd (calc-pick 1 ">> Select second endpoint of line 2: ")))
                                   (or (line-line-int a b c dd nil) (cerr "Those lines don't meet."))))
                                (t (calc-var name)))))
                       (t (cerr "\"~A\" isn't expected here." (cdr tk)))))))
      (let ((v (expr)))
        (when toks (cerr "\"~A\" isn't expected after the expression." (let ((tk (first toks))) (cdr tk))))
        (setf v (if (realp v) (d v) v))
        (when assign
          (setf (gethash assign *calc-vars*) v)
          (ignore-errors (set-sym (asym assign) (if (realp v) v (copy-list v)))))
        (setf *calc-last* v)
        v))))

(defun calc-format (v)
  "A result as shown: a number with up to 8 decimals, a point as x,y,z."
  (flet ((num (x) (let* ((s (format nil "~,8F" x))
                         (s (if (find #\. s) (string-right-trim "." (string-right-trim "0" s)) s)))
                    (if (or (string= s "-0") (string= s "")) "0" s))))
    (if (realp v) (num v) (format nil "~A,~A,~A" (num (px v)) (num (py v)) (num (pz v))))))

;;; ---------- the CAL command, and 'CAL / 'QC at any prompt ----------

(defcmd "CAL" () "Calculates an expression (numbers, points, geometry picked in the drawing)."
  (let ((s (gstring ">> Expression: " t)))
    (when (plusp (length (string-trim " " s)))
      (handler-case (out (format nil "~A~%" (calc-format (calc-eval s))))
        (calc-error (e) (out (format nil "~A~%" (calc-msg e))))))))

(defun transparent-calc (word req)
  "'CAL or 'QC typed at a prompt: the value to give that prompt, or :retry."
  (cond ((member word '("CAL") :test #'string-equal)
         (let ((s (get-user-input :string :prompt ">> Expression: ")))
           (if (and (stringp s) (plusp (length (string-trim " " s))))
               (handler-case (let ((v (calc-eval s)))
                               (out (format nil "~A~%" (calc-format v)))
                               (interpret-value (if (realp v) v (copy-list v)) req))
                 (calc-error (e) (out (format nil "~A~%" (calc-msg e))) :retry))
               :retry)))
        (t                                  ; 'QC: the window; its Apply gives the prompt the result
         (open-quickcalc t)
         :retry)))

;;; ---------- QuickCalc (the window is in gui.tcl) ----------

(defun open-quickcalc (&optional apply)
  (if (gui-p)
      (progn (tk "qc_open ~D" (if apply 1 0))
             (qc-send-vars))
      (out (format nil "QuickCalc needs the drawing window; use CAL to type an expression.~%"))))

(defun qc-send-vars ()
  (let ((items (loop for k being the hash-keys of *calc-vars* using (hash-value v)
                     collect (format nil "{~A} {~A}" k (calc-format v)))))
    (tk "qc_vars {~{~A~^ ~}}" (sort items #'string-lessp))))

(defcmd "QUICKCALC" ("QC") "Opens QuickCalc: a calculator, unit converter, and geometry from the drawing."
  (open-quickcalc nil))

(defun qc-event (what arg)
  "A request from the QuickCalc window."
  (flet ((reply (expr v) (tk "qc_result ~A ~A" (tq expr) (tq (calc-format v)))))
    (handler-case
        (cond
          ((string= what "EVAL")
           (let ((v (calc-eval arg))) (reply arg v) (qc-send-vars)))
          ((string= what "COORD")
           (let ((p (calc-pick 0 ">> Specify a point: "))) (reply "cur" p)))
          ((string= what "DIST")
           (let* ((p (calc-pick 0 ">> Specify first point: "))
                  (q (let ((r (get-user-input :point :base p :prompt ">> Specify second point: "))) (if (pointp r) (pt3 r) (cerr "No point picked.")))))
             (reply "dist(p1,p2)" (dist p q))))
          ((string= what "ANGLE")
           (let* ((p (calc-pick 0 ">> Specify first point of line: "))
                  (q (let ((r (get-user-input :point :base p :prompt ">> Specify second point of line: "))) (if (pointp r) (pt3 r) (cerr "No point picked.")))))
             (reply "ang(p1,p2)" (deg (ang p q)))))
          ((string= what "ILLE")
           (reply "ille" (calc-eval "ille")))
          ((string= what "DELVAR") (remhash arg *calc-vars*) (qc-send-vars)))
      (calc-error (e) (tk "qc_error ~A" (tq (calc-msg e))))
      (alisp-cancel () (tk "qc_error ~A" (tq "Cancelled."))))))
