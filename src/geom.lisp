;;;; geom.lisp — points, angles, intersections and geometric "pieces".
;;;; Points are AutoLISP-style lists (x y z) of double-floats.

(in-package :fancy-pencil)

(defconstant +pi+ (coerce pi 'double-float))
(defconstant +2pi+ (* 2 +pi+))
(defconstant +eps+ 1d-9)

(declaim (inline d))
(defun d (x) (coerce x 'double-float))

(defun pt (x y &optional (z 0)) (list (d x) (d y) (d z)))
(defun px (p) (d (first p)))
(defun py (p) (d (second p)))
(defun pz (p) (if (cddr p) (d (third p)) 0d0))
(defun pt3 (p) (pt (px p) (py p) (pz p)))
(defun pointp (x)
  (and (consp x) (listp (cdr x)) (<= 2 (length x) 3) (every #'realp x)))

(defun v+ (a b) (pt (+ (px a) (px b)) (+ (py a) (py b)) (+ (pz a) (pz b))))
(defun v- (a b) (pt (- (px a) (px b)) (- (py a) (py b)) (- (pz a) (pz b))))
(defun v* (a s) (pt (* (px a) s) (* (py a) s) (* (pz a) s)))
(defun dist (a b)
  (sqrt (+ (expt (- (px a) (px b)) 2) (expt (- (py a) (py b)) 2) (expt (- (pz a) (pz b)) 2))))
(defun dist2d (a b) (sqrt (+ (expt (- (px a) (px b)) 2) (expt (- (py a) (py b)) 2))))
(defun norm-ang (a)
  (let ((r (mod (d a) +2pi+))) (if (< (abs (- r +2pi+)) 1d-12) 0d0 r)))
(defun ang (a b)
  (let ((dx (- (px b) (px a))) (dy (- (py b) (py a))))
    (if (and (zerop dx) (zerop dy)) 0d0 (norm-ang (atan dy dx)))))
(defun polar (p a dd) (pt (+ (px p) (* dd (cos a))) (+ (py p) (* dd (sin a))) (pz p)))
(defun midpt (a b) (v* (v+ a b) 0.5d0))
(defun rot-pt (p base a)
  (let ((dx (- (px p) (px base))) (dy (- (py p) (py base))) (c (cos a)) (s (sin a)))
    (pt (+ (px base) (- (* dx c) (* dy s))) (+ (py base) (* dx s) (* dy c)) (pz p))))
(defun scale-pt (p base s) (v+ base (v* (v- p base) s)))
(defun mirror-pt (p a b)
  (let* ((dx (- (px b) (px a))) (dy (- (py b) (py a))) (l2 (+ (* dx dx) (* dy dy))))
    (if (< l2 +eps+) p
        (let* ((tt (/ (+ (* (- (px p) (px a)) dx) (* (- (py p) (py a)) dy)) l2))
               (fx (+ (px a) (* tt dx))) (fy (+ (py a) (* tt dy))))
          (pt (- (* 2 fx) (px p)) (- (* 2 fy) (py p)) (pz p))))))
(defun deg (r) (* r (/ 180d0 +pi+)))
(defun rad (dg) (* (d dg) (/ +pi+ 180d0)))

;;; ---------- segments, lines, circles ----------

(defun seg-param (p a b)
  (let* ((dx (- (px b) (px a))) (dy (- (py b) (py a))) (l2 (+ (* dx dx) (* dy dy))))
    (if (< l2 1d-24) 0d0
        (/ (+ (* (- (px p) (px a)) dx) (* (- (py p) (py a)) dy)) l2))))
(defun at-param (a b tt) (v+ a (v* (v- b a) tt)))
(defun closest-on-seg (p a b)
  (at-param a b (max 0d0 (min 1d0 (seg-param p a b)))))
(defun foot-on-line (p a b) (at-param a b (seg-param p a b)))

(defun line-line-int (a b c dd &optional (on-segs t))
  "Intersection of AB with CD; with ON-SEGS only within both segments. Returns point or NIL."
  (let* ((x1 (px a)) (y1 (py a)) (x2 (px b)) (y2 (py b))
         (x3 (px c)) (y3 (py c)) (x4 (px dd)) (y4 (py dd))
         (den (- (* (- x1 x2) (- y3 y4)) (* (- y1 y2) (- x3 x4)))))
    (when (> (abs den) 1d-14)
      (let ((tt (/ (- (* (- x1 x3) (- y3 y4)) (* (- y1 y3) (- x3 x4))) den))
            (u (/ (- (* (- x1 x3) (- y1 y2)) (* (- y1 y3) (- x1 x2))) den)))
        (when (or (not on-segs)
                  (and (<= -1d-9 tt (+ 1 1d-9)) (<= -1d-9 u (+ 1 1d-9))))
          (pt (+ x1 (* tt (- x2 x1))) (+ y1 (* tt (- y2 y1))) (pz a)))))))

(defun line-circle-params (a b c r)
  "Parameters t (along A->B, unbounded) where the line meets the circle."
  (let* ((dx (- (px b) (px a))) (dy (- (py b) (py a)))
         (fx (- (px a) (px c))) (fy (- (py a) (py c)))
         (aa (+ (* dx dx) (* dy dy))) (bb (* 2 (+ (* fx dx) (* fy dy))))
         (cc (- (+ (* fx fx) (* fy fy)) (* r r)))
         (disc (- (* bb bb) (* 4 aa cc))))
    (cond ((< aa 1d-24) nil)
          ((< disc (- 1d-12)) nil)
          ((< (abs disc) 1d-12) (list (/ (- bb) (* 2 aa))))
          (t (let ((s (sqrt disc)))
               (list (/ (- (- bb) s) (* 2 aa)) (/ (+ (- bb) s) (* 2 aa))))))))

(defun circle-circle-ints (c1 r1 c2 r2)
  (let ((dd (dist2d c1 c2)))
    (when (and (> dd 1d-12) (<= dd (+ r1 r2 1d-9)) (>= dd (- (abs (- r1 r2)) 1d-9)))
      (let* ((a (/ (+ (- (* r1 r1) (* r2 r2)) (* dd dd)) (* 2 dd)))
             (h (sqrt (max 0d0 (- (* r1 r1) (* a a)))))
             (mx (+ (px c1) (/ (* a (- (px c2) (px c1))) dd)))
             (my (+ (py c1) (/ (* a (- (py c2) (py c1))) dd)))
             (ox (/ (* h (- (py c2) (py c1))) dd))
             (oy (/ (* h (- (px c2) (px c1))) dd)))
        (if (< h 1d-12)
            (list (pt mx my))
            (list (pt (+ mx ox) (- my oy)) (pt (- mx ox) (+ my oy))))))))

(defun arc-sweep (a1 a2)
  (let ((s (norm-ang (- a2 a1)))) (if (< s 1d-12) +2pi+ s)))
(defun ang-in-arc-p (a a1 a2 &optional (eps 1d-9))
  (<= (norm-ang (- a a1)) (+ (arc-sweep a1 a2) eps)))

(defun bulge->arc (p1 p2 b)
  "Arc for a polyline segment with bulge B. Returns (values center radius a1 a2), CCW a1->a2."
  (let* ((theta (* 4 (atan (abs b))))
         (chord (dist2d p1 p2))
         (r (/ chord (* 2 (sin (/ theta 2)))))
         (h (/ chord (* 2 (tan (/ theta 2)))))   ; signed: negative when sweep > 180
         (c (polar (midpt p1 p2) (+ (ang p1 p2) (if (> b 0) (/ +pi+ 2) (- (/ +pi+ 2)))) h)))
    (if (> b 0)
        (values c r (ang c p1) (ang c p2))
        (values c r (ang c p2) (ang c p1)))))

(defun arc-points (c r a1 a2 &optional n)
  (let* ((sw (arc-sweep a1 a2))
         (n (or n (max 8 (ceiling (* 48 (/ sw +2pi+)))))))
    (loop for i from 0 to n collect (polar c (+ a1 (* sw (/ i n))) r))))

;;; ---------- pieces ----------
;;; (:seg a b) (:arc c r a1 a2) (:circle c r) (:pt p) (:gseg a b) — gseg is a
;;; "ghost" edge (text boxes) used only for selection.

(defun piece-points-for-bbox (pc)
  (ecase (first pc)
    ((:seg :gseg) (list (second pc) (third pc)))
    (:pt (list (second pc)))
    (:circle (destructuring-bind (c r) (rest pc)
               (list (v+ c (pt (- r) (- r))) (v+ c (pt r r)))))
    (:arc (destructuring-bind (c r a1 a2) (rest pc)
            (append (list (polar c a1 r) (polar c a2 r))
                    (loop for q in (list 0d0 (/ +pi+ 2) +pi+ (* 1.5d0 +pi+))
                          when (ang-in-arc-p q a1 a2) collect (polar c q r)))))))

(defun points-bbox (pts)
  (when pts
    (loop for p in pts
          minimize (px p) into x0 maximize (px p) into x1
          minimize (py p) into y0 maximize (py p) into y1
          finally (return (list x0 y0 x1 y1)))))

(defun pieces-bbox (pieces) (points-bbox (mapcan #'piece-points-for-bbox pieces)))

(defun piece-nearest (pc p)
  (ecase (first pc)
    ((:seg :gseg) (closest-on-seg p (second pc) (third pc)))
    (:pt (second pc))
    (:circle (destructuring-bind (c r) (rest pc) (polar c (ang c p) r)))
    (:arc (destructuring-bind (c r a1 a2) (rest pc)
            (let ((a (ang c p)))
              (if (ang-in-arc-p a a1 a2)
                  (polar c a r)
                  (let ((e1 (polar c a1 r)) (e2 (polar c a2 r)))
                    (if (< (dist2d p e1) (dist2d p e2)) e1 e2))))))))

(defun piece-dist (pc p) (dist2d p (piece-nearest pc p)))

(defun piece-ends (pc)
  (case (first pc)
    (:seg (list (second pc) (third pc)))
    (:arc (destructuring-bind (c r a1 a2) (rest pc) (list (polar c a1 r) (polar c a2 r))))))
(defun piece-mids (pc)
  (case (first pc)
    (:seg (list (midpt (second pc) (third pc))))
    (:arc (destructuring-bind (c r a1 a2) (rest pc)
            (list (polar c (+ a1 (/ (arc-sweep a1 a2) 2)) r))))))
(defun piece-center (pc) (when (member (first pc) '(:arc :circle)) (second pc)))
(defun piece-quads (pc)
  (case (first pc)
    (:circle (destructuring-bind (c r) (rest pc)
               (loop for q from 0 below 4 collect (polar c (* q (/ +pi+ 2)) r))))
    (:arc (destructuring-bind (c r a1 a2) (rest pc)
            (loop for q from 0 below 4 for a = (* q (/ +pi+ 2))
                  when (ang-in-arc-p a a1 a2) collect (polar c a r))))))
(defun piece-perp (pc from)
  (case (first pc)
    (:seg (list (foot-on-line from (second pc) (third pc))))
    ((:circle :arc) (let ((c (second pc)) (r (third pc)))
                      (unless (< (dist2d c from) 1d-12)
                        (list (polar c (ang c from) r)))))))
(defun piece-tangents (pc from)
  (when (member (first pc) '(:circle :arc))
    (let* ((c (second pc)) (r (third pc)) (dd (dist2d c from)))
      (when (> dd r)
        (let ((a (ang c from)) (b (acos (/ r dd))))
          (remove-if-not (lambda (q) (or (eq (first pc) :circle)
                                         (ang-in-arc-p (ang c q) (fourth pc) (fifth pc))))
                         (list (polar c (+ a b) r) (polar c (- a b) r))))))))

(defun on-piece-p (pc p &optional (eps 1d-7))
  (< (piece-dist pc p) eps))

(defun piece-ints (p1 p2 &optional extend)
  "Intersections of two pieces. With EXTEND, segments act as infinite lines and arcs as circles."
  (let ((k1 (first p1)) (k2 (first p2)))
    (cond
      ((or (member k1 '(:pt :gseg)) (member k2 '(:pt :gseg))) nil)
      ((and (eq k1 :seg) (eq k2 :seg))
       (let ((q (line-line-int (second p1) (third p1) (second p2) (third p2) (not extend))))
         (and q (list q))))
      ((eq k1 :seg)
       (let ((a (second p1)) (b (third p1)) (c (second p2)) (r (third p2)))
         (loop for tt in (line-circle-params a b c r)
               for q = (at-param a b tt)
               when (and (or extend (<= -1d-9 tt (+ 1 1d-9)))
                         (or extend (eq k2 :circle) (ang-in-arc-p (ang c q) (fourth p2) (fifth p2))))
                 collect q)))
      ((eq k2 :seg) (piece-ints p2 p1 extend))
      (t (loop for q in (circle-circle-ints (second p1) (third p1) (second p2) (third p2))
               when (and (or extend (eq k1 :circle) (ang-in-arc-p (ang (second p1) q) (fourth p1) (fifth p1)))
                         (or extend (eq k2 :circle) (ang-in-arc-p (ang (second p2) q) (fourth p2) (fifth p2))))
                 collect q)))))

(defun seg-intersects-rect-p (a b x0 y0 x1 y1)
  (or (and (<= x0 (px a) x1) (<= y0 (py a) y1))
      (and (<= x0 (px b) x1) (<= y0 (py b) y1))
      (let ((c1 (pt x0 y0)) (c2 (pt x1 y0)) (c3 (pt x1 y1)) (c4 (pt x0 y1)))
        (or (line-line-int a b c1 c2) (line-line-int a b c2 c3)
            (line-line-int a b c3 c4) (line-line-int a b c4 c1)))))

(defun piece-crosses-rect-p (pc x0 y0 x1 y1)
  (ecase (first pc)
    ((:seg :gseg) (seg-intersects-rect-p (second pc) (third pc) x0 y0 x1 y1))
    (:pt (let ((p (second pc))) (and (<= x0 (px p) x1) (<= y0 (py p) y1))))
    ((:circle :arc)
     (let ((pts (if (eq (first pc) :circle)
                    (arc-points (second pc) (third pc) 0d0 +2pi+ 64)
                    (arc-points (second pc) (third pc) (fourth pc) (fifth pc)))))
       (loop for (a b) on pts while b
               thereis (seg-intersects-rect-p a b x0 y0 x1 y1))))))

(defun tessellate-piece (pc)
  "Turn a piece into a list of :seg pieces (used under non-uniform transforms)."
  (case (first pc)
    (:circle (let ((pts (arc-points (second pc) (third pc) 0d0 +2pi+ 64)))
               (loop for (a b) on pts while b collect (list :seg a b))))
    (:arc (let ((pts (apply #'arc-points (rest pc))))
            (loop for (a b) on pts while b collect (list :seg a b))))
    (t (list pc))))

;;; ---------- transforms ----------
;;; An XF maps points, angles, lengths. MIRROR is true when orientation flips.

(defstruct xf
  (fn #'identity) (ang #'identity) (scale 1d0) (mirror nil) (uniform t))

(defun xf-move (delta) (make-xf :fn (lambda (p) (v+ p delta))))
(defun xf-rotate (base a)
  (make-xf :fn (lambda (p) (rot-pt p base a)) :ang (lambda (x) (norm-ang (+ x a)))))
(defun xf-scaler (base s) (make-xf :fn (lambda (p) (scale-pt p base s)) :scale (d s)))
(defun xf-reflect (a b)
  (let ((m (ang a b)))
    (make-xf :fn (lambda (p) (mirror-pt p a b))
             :ang (lambda (x) (norm-ang (- (* 2 m) x))) :mirror t)))
(defun xf-insert (ins sx sy rot &optional (base (pt 0 0)))
  "Block insert transform: translate by -BASE, scale SX/SY, rotate ROT, translate to INS."
  (let ((c (cos rot)) (s (sin rot)))
    (make-xf :fn (lambda (p)
                   (let ((x (* sx (- (px p) (px base)))) (y (* sy (- (py p) (py base)))))
                     (pt (+ (px ins) (- (* x c) (* y s))) (+ (py ins) (* x s) (* y c)) (pz ins))))
             :ang (lambda (a)
                    (norm-ang (+ rot (atan (* sy (sin a)) (* sx (cos a))))))
             :scale (abs (d sx)) :mirror (< (* sx sy) 0)
             :uniform (< (abs (- (abs sx) (abs sy))) 1d-12))))
(defun xf-compose (inner outer)
  "Apply INNER first, then OUTER."
  (make-xf :fn (lambda (p) (funcall (xf-fn outer) (funcall (xf-fn inner) p)))
           :ang (lambda (a) (funcall (xf-ang outer) (funcall (xf-ang inner) a)))
           :scale (* (xf-scale inner) (xf-scale outer))
           :mirror (not (eq (not (xf-mirror inner)) (not (xf-mirror outer))))
           :uniform (and (xf-uniform inner) (xf-uniform outer))))

(defun xf-point (xf p) (funcall (xf-fn xf) p))

(defun transform-piece (pc xf)
  (ecase (first pc)
    ((:seg :gseg) (list (list (first pc) (xf-point xf (second pc)) (xf-point xf (third pc)))))
    (:pt (list (list :pt (xf-point xf (second pc)))))
    ((:circle :arc)
     (if (xf-uniform xf)
         (if (eq (first pc) :circle)
             (list (list :circle (xf-point xf (second pc)) (* (third pc) (xf-scale xf))))
             (destructuring-bind (c r a1 a2) (rest pc)
               (let ((n1 (funcall (xf-ang xf) a1)) (n2 (funcall (xf-ang xf) a2)))
                 (list (if (xf-mirror xf)
                           (list :arc (xf-point xf c) (* r (xf-scale xf)) n2 n1)
                           (list :arc (xf-point xf c) (* r (xf-scale xf)) n1 n2))))))
         (loop for s in (tessellate-piece pc)
               collect (list :seg (xf-point xf (second s)) (xf-point xf (third s))))))))
