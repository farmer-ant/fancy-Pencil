;;; ---------- printing / files ----------

(defun out-target (file) (if (afile-p file) (afile-stream file) nil))
(defun emit (s file) (let ((st (out-target file))) (if st (write-string s st) (out s))))
(defsubr "princ" (&optional (x nil xp) file)
  (if (not xp) *null-sym* (progn (emit (lisp-repr x nil) file) x)))
(defsubr "prin1" (&optional (x nil xp) file)
  (if (not xp) *null-sym* (progn (emit (lisp-repr x t) file) x)))
(defsubr "print" (&optional (x nil xp) file)
  (if (not xp) *null-sym* (progn (emit (format nil "~%~A " (lisp-repr x t)) file) x)))
(defsubr "terpri" () (out (string #\Newline)) nil)
(defsubr "prompt" (s) (out (lisp-repr s nil)) nil)
(defsubr "write-line" (s &optional file) (emit (format nil "~A~%" (astr s)) file) s)
(defsubr "write-char" (c &optional file) (emit (string (code-char (aint c))) file) c)
(defsubr "read-line" (&optional file)
  (if (afile-p file) (read-line (afile-stream file) nil nil) (get-user-input :string :prompt "" :spaces t)))
(defsubr "read-char" (&optional file)
  (if (afile-p file)
      (let ((c (read-char (afile-stream file) nil nil))) (and c (char-code c)))
      (let ((s (get-user-input :string :prompt "" :spaces t))) (if (plusp (length s)) (char-code (char s 0)) 10))))

(defsubr "open" (path mode)
  (astr path) (astr mode)
  (handler-case
      (let ((m (char-downcase (char mode 0))))
        (make-afile :path path :mode mode
                    :stream (ecase m
                              (#\r (open path :direction :input :external-format :utf-8))
                              (#\w (open path :direction :output :if-exists :supersede :if-does-not-exist :create :external-format :utf-8))
                              (#\a (open path :direction :output :if-exists :append :if-does-not-exist :create :external-format :utf-8)))))
    (error () nil)))
(defsubr "close" (f) (when (afile-p f) (close (afile-stream f))) nil)

(defvar *support-paths* nil "Extra directories searched by FINDFILE and LOAD.")
(defun find-file-in-support (name)
  (let ((p (probe-file name)))
    (or (and p (namestring p))
        (loop for dir in (append *support-paths* (list (directory-namestring (or (drawing-filename *dwg*) ""))))
              for q = (probe-file (merge-pathnames name dir))
              when q return (namestring q)))))
(defsubr "findfile" (name) (find-file-in-support (astr name)))
(defsubr "vl-file-directory-p" (p) (bool (and (probe-file (astr p)) (null (pathname-name (probe-file p))))))
(defsubr "vl-file-delete" (p) (bool (ignore-errors (delete-file (astr p)))))
(defsubr "vl-file-rename" (a b) (bool (ignore-errors (rename-file (astr a) (astr b)))))
(defsubr "vl-file-copy" (a b &optional append)
  (ignore-errors
   (with-open-file (in (astr a) :element-type '(unsigned-byte 8))
     (with-open-file (o (astr b) :direction :output :element-type '(unsigned-byte 8)
                                 :if-exists (if append :append :supersede) :if-does-not-exist :create)
       (let ((buf (make-array 65536 :element-type '(unsigned-byte 8))))
         (loop for n = (read-sequence buf in) while (plusp n) do (write-sequence buf o :end n))
         (file-length o))))))
(defsubr "vl-file-size" (p) (ignore-errors (with-open-file (in (astr p) :element-type '(unsigned-byte 8)) (file-length in))))
(defsubr "vl-directory-files" (&optional (dir ".") (pat "*.*") (mode 0))
  (let* ((files (directory (merge-pathnames (make-pathname :name :wild :type :wild) (concatenate 'string (string-right-trim "/" dir) "/"))))
         (names (loop for f in files
                      for isdir = (null (pathname-name f))
                      for nm = (if isdir (car (last (pathname-directory f))) (file-namestring f))
                      when (and nm (case mode (-1 isdir) (1 (not isdir)) (t t))
                                (wcmatch (string-downcase nm) (string-downcase (if (equal pat "*.*") "*" pat))))
                        collect nm)))
    names))
(defsubr "vl-mkdir" (dir) (bool (ignore-errors (ensure-directories-exist (concatenate 'string (string-right-trim "/" dir) "/")))))
(defun getenv (name)
  #+sbcl (sb-ext:posix-getenv name)
  #+ecl (ext:getenv name)
  #+ccl (ccl:getenv name)
  #-(or sbcl ecl ccl) nil)
(defsubr "getenv" (name) (getenv (astr name)))

(defun alisp-load-file (path)
  (let* ((full (or (find-file-in-support path)
                   (and (null (pathname-type (pathname path)))
                        (find-file-in-support (concatenate 'string path ".lsp")))))
         (v nil))
    (unless full (return-from alisp-load-file :not-found))
    (let ((forms (handler-case (alisp-read-all (format nil "~{~A~%~}" (read-file-lines full)))
                   (alisp-incomplete () (aerr "malformed list on input")))))
      (dolist (f forms v) (setf v (aeval f))))))
(defsubr "load" (path &optional (onfail nil failp))
  (let ((r (alisp-load-file (astr path))))
    (if (eq r :not-found)
        (if failp onfail (aerr "LOAD failed: ~S" path))
        r)))
(defsubr "autoload" (file cmds)
  (dolist (c (alst cmds))
    (let ((file file) (c c))
      (set-sym (asym (concatenate 'string "C:" c))
               (make-subr :name c :min 0 :max 0
                          :fn (lambda () (alisp-load-file file)
                                (let ((f (sym-value (asym (concatenate 'string "C:" c)))))
                                  (if (ufunc-p f) (call-ufunc f nil) nil)))))))
  nil)

;;; ---------- top level ----------

(defun alisp-eval-string (s)
  "Read and evaluate every form in S; returns the last value. Errors propagate."
  (let ((v nil)) (dolist (f (alisp-read-all s) v) (setf v (aeval f)))))

(defun report-alisp-error (msg)
  "Invoke the user's *error* handler if any (with the failing code's bindings still in effect)."
  (setf (sysvar "ERRNO") 0)
  (let ((h (sym-value (sym "*ERROR*"))))
    (if (or (ufunc-p h) (subr-p h) (and (consp h) (listp (car h))))
        (handler-case (apply-a h (list msg))
          (alisp-error (c) (out (format nil "~%; error: ~A~%" (alisp-error-msg c))))
          (error (c) (out (format nil "~%; error: ~A~%" c))))
        (out (format nil "~%; error: ~A~%" msg)))))

(defun call-with-alisp-errors (thunk)
  "Run THUNK. On any error, run *error* (or print the message) and return (values nil t)."
  (block run
    (handler-bind ((alisp-error (lambda (c) (report-alisp-error (alisp-error-msg c)) (return-from run (values nil t))))
                   (error (lambda (c) (report-alisp-error (cl-error-text c)) (return-from run (values nil t))))
                   (storage-condition (lambda (c) (declare (ignore c))
                                        (report-alisp-error "stack overflow / out of memory")
                                        (return-from run (values nil t)))))
      (values (funcall thunk) nil))))

(defun cl-error-text (c)
  (typecase c
    (type-error (format nil "bad argument type: ~A: ~A"
                        (let ((ty (type-error-expected-type c)))
                          (cond ((subtypep ty 'number) "numberp") ((subtypep ty 'string) "stringp")
                                ((subtypep ty 'list) "listp") (t (string-downcase (princ-to-string ty)))))
                        (lisp-repr (type-error-datum c))))
    (division-by-zero "divide by zero")
    (t (substitute #\Space #\Newline (princ-to-string c)))))

(defun run-lisp-file (path)
  "Load a .lsp file with full error reporting."
  (call-with-alisp-errors (lambda () (let ((r (alisp-load-file path)))
                                       (when (eq r :not-found) (aerr "LOAD failed: ~S" path))
                                       r))))

