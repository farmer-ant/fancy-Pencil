;;;; alisp.lisp — the AutoLISP interpreter: data types, reader, printer, evaluator.
;;;;
;;;; AutoLISP symbols are CL symbols interned in ALISP-USER (NIL and T shared with CL).
;;;; AutoLISP is dynamically scoped: DEFUN arguments and /locals are bound with PROGV,
;;;; which gives exactly AutoLISP's semantics (including local *error* handlers).
;;;; Functions and variables share one namespace: a function is a symbol's value.

(in-package :fancy-pencil)

;;; ---------- types ----------

(defstruct subr name fn (min 0) (max nil))
(defstruct fsubr name fn)
(defstruct ufunc name params locals body)
(defvar *pickset-counter* 0)
(defstruct (pickset (:constructor %make-pickset))
  (items nil) (id (incf *pickset-counter*)))
(defun make-pickset (&optional items) (%make-pickset :items (remove-duplicates items :from-end t)))
(defstruct afile stream path mode)
(defstruct catch-err message)

(define-condition alisp-error (error)
  ((msg :initarg :msg :reader alisp-error-msg))
  (:report (lambda (c s) (write-string (alisp-error-msg c) s))))
(define-condition alisp-cancel (alisp-error) ()
  (:default-initargs :msg "Function cancelled"))
(define-condition alisp-exit (alisp-error) ()
  (:default-initargs :msg "quit / exit abort"))
(define-condition alisp-incomplete (error) ())

(defun aerr (fmt &rest args) (error 'alisp-error :msg (apply #'format nil fmt args)))
(defun bad-arg (pred val) (aerr "bad argument type: ~A: ~A" pred (lisp-repr val t)))

(defun asym (name) (intern (string-upcase name) :alisp-user))
(defmacro sym (name) `(load-time-value (asym ,name)))

(defun sym-value (s)
  (if (or (null s) (eq s t)) s (if (boundp s) (symbol-value s) nil)))
(defun set-sym (s v)
  (when (or (null s) (eq s t) (not (symbolp s))) (aerr "attempt to set constant symbol: ~A" (lisp-repr s)))
  (setf (symbol-value s) v))

(defvar *null-sym* (asym ""))   ; what (princ) returns: prints as nothing

;;; ---------- output hook ----------

(defvar *output-fn* (lambda (s) (write-string s *standard-output*) (force-output)))
(defun out (s) (funcall *output-fn* s) s)

;;; ---------- reader ----------

(defun delimiterp (c) (member c '(#\Space #\Tab #\Newline #\Return #\Page #\( #\) #\' #\" #\;)))
(defun wsp (c) (member c '(#\Space #\Tab #\Newline #\Return #\Page)))

(defun skip-ws (s i)
  (let ((n (length s)))
    (loop
      (cond ((>= i n) (return i))
            ((wsp (char s i)) (incf i))
            ((char= (char s i) #\;)
             (if (and (< (1+ i) n) (char= (char s (1+ i)) #\|))
                 (let ((e (search "|;" s :start2 (+ i 2))))
                   (if e (setf i (+ e 2)) (error 'alisp-incomplete)))
                 (let ((e (position #\Newline s :start i)))
                   (setf i (if e (1+ e) n)))))
            (t (return i))))))

(defun number-token-p (tok)
  (let ((i 0) (n (length tok)) (digits 0))
    (when (and (< i n) (member (char tok i) '(#\+ #\-))) (incf i))
    (loop while (and (< i n) (digit-char-p (char tok i))) do (incf i) (incf digits))
    (when (and (< i n) (char= (char tok i) #\.))
      (incf i)
      (loop while (and (< i n) (digit-char-p (char tok i))) do (incf i) (incf digits)))
    (when (zerop digits) (return-from number-token-p nil))
    (when (and (< i n) (char-equal (char tok i) #\e))
      (incf i)
      (when (and (< i n) (member (char tok i) '(#\+ #\-))) (incf i))
      (let ((ed 0))
        (loop while (and (< i n) (digit-char-p (char tok i))) do (incf i) (incf ed))
        (when (zerop ed) (return-from number-token-p nil))))
    (= i n)))

(defun parse-token (tok)
  (if (number-token-p tok)
      (if (find-if (lambda (c) (member c '(#\. #\e #\E))) tok)
          (let ((*read-default-float-format* 'double-float))
            (d (let ((s (string-left-trim "+" tok)))
                 (read-from-string (if (char= (char s (1- (length s))) #\.)
                                       (concatenate 'string s "0") ; "5." -> 5.0
                                       (if (and (char= (char s 0) #\.)) (concatenate 'string "0" s)
                                           (if (and (> (length s) 1) (string= (subseq s 0 2) "-."))
                                               (concatenate 'string "-0" (subseq s 1))
                                               s)))))))
          (parse-integer tok))
      (asym tok)))

(defun read-string-lit (s i)
  "I points just past the opening quote."
  (let ((out (make-string-output-stream)) (n (length s)))
    (loop
      (when (>= i n) (error 'alisp-incomplete))
      (let ((c (char s i)))
        (cond ((char= c #\") (return (values (get-output-stream-string out) (1+ i))))
              ((char= c #\\)
               (when (>= (1+ i) n) (error 'alisp-incomplete))
               (let ((e (char s (1+ i))))
                 (incf i 2)
                 (case e
                   (#\n (write-char #\Newline out))
                   (#\t (write-char #\Tab out))
                   (#\r (write-char #\Return out))
                   (#\e (write-char (code-char 27) out))
                   (t (if (digit-char-p e 8)
                          (let ((j (1- i)) (v 0))
                            (loop repeat 3 while (and (< j n) (digit-char-p (char s j) 8))
                                  do (setf v (+ (* v 8) (digit-char-p (char s j) 8))) (incf j))
                            (setf i j)
                            (write-char (code-char v) out))
                          (write-char e out))))))
              (t (write-char c out) (incf i)))))))

(defun read-form (s i)
  "Returns (values form next-index), or (values :eof i)."
  (setf i (skip-ws s i))
  (let ((n (length s)))
    (when (>= i n) (return-from read-form (values :eof i)))
    (let ((c (char s i)))
      (case c
        (#\( (read-list s (1+ i)))
        (#\) (read-form s (1+ i)))    ; stray close paren: ignore like AutoCAD
        (#\' (multiple-value-bind (f j) (read-form s (1+ i))
               (when (eq f :eof) (error 'alisp-incomplete))
               (values (list (sym "QUOTE") f) j)))
        (#\" (read-string-lit s (1+ i)))
        (t (let ((j (or (position-if #'delimiterp s :start i) n)))
             (values (parse-token (subseq s i j)) j)))))))

(defun read-list (s i)
  (let ((items nil) (n (length s)))
    (loop
      (setf i (skip-ws s i))
      (when (>= i n) (error 'alisp-incomplete))
      (let ((c (char s i)))
        (cond ((char= c #\)) (return (values (nreverse items) (1+ i))))
              ((and (char= c #\.) items (< (1+ i) n) (delimiterp (char s (1+ i))))
               (multiple-value-bind (tail j) (read-form s (1+ i))
                 (when (eq tail :eof) (error 'alisp-incomplete))
                 (setf j (skip-ws s j))
                 (when (>= j n) (error 'alisp-incomplete))
                 (unless (char= (char s j) #\)) (aerr "malformed dotted list"))
                 (let ((l (nreverse items))) (setf (cdr (last l)) tail)
                   (return (values l (1+ j))))))
              (t (multiple-value-bind (f j) (read-form s i)
                   (push f items) (setf i j))))))))

(defun alisp-read-all (s)
  (let ((i 0) (forms nil))
    (loop (multiple-value-bind (f j) (read-form s i)
            (when (eq f :eof) (return (nreverse forms)))
            (push f forms) (setf i j)))))

(defun alisp-complete-p (s)
  (handler-case (progn (alisp-read-all s) t) (alisp-incomplete () nil)))

;;; ---------- printer ----------

(defun format-real (x)
  (let ((x (d x)))
    (cond ((zerop x) "0.0")
          ((or (nanp x)) "1.#IND")
          (t
           (let ((e (floor (log (abs x) 10))))
             ;; correct floor for rounding (e.g. 999999.5)
             (when (>= (abs (/ x (expt 10d0 e))) 9.999995d0) (incf e))
             (if (and (>= e -5) (< e 6))
                 (trim-real (format nil "~,vF" (max 1 (- 5 e)) x))
                 (let* ((m (/ x (expt 10d0 e))))
                   (format nil "~Ae~A~2,'0D" (trim-real (format nil "~,5F" m)) (if (minusp e) "-" "+") (abs e)))))))))
(defun nanp (x) (/= x x))
(defun trim-real (s)
  (let ((dot (position #\. s)))
    (if (not dot) (concatenate 'string s ".0")
        (let ((end (length s)))
          (loop while (and (> end (+ dot 2)) (char= (char s (1- end)) #\0)) do (decf end))
          (subseq s 0 end)))))

(defun escape-string (s)
  (with-output-to-string (o)
    (write-char #\" o)
    (loop for c across s do
      (case c (#\" (write-string "\\\"" o)) (#\\ (write-string "\\\\" o))
        (#\Newline (write-string "\\n" o)) (#\Tab (write-string "\\t" o))
        (#\Return (write-string "\\r" o))
        (t (if (= (char-code c) 27) (write-string "\\e" o) (write-char c o)))))
    (write-char #\" o)))

(defun lisp-repr (x &optional (escape t))
  (cond ((null x) "nil")
        ((eq x t) "T")
        ((integerp x) (format nil "~D" x))
        ((realp x) (format-real x))
        ((stringp x) (if escape (escape-string x) x))
        ((symbolp x) (symbol-name x))
        ((consp x)
         (with-output-to-string (o)
           (write-char #\( o)
           (loop for tail on x
                 for first = t then nil
                 do (unless first (write-char #\Space o))
                    (write-string (lisp-repr (car tail) escape) o)
                    (when (and (cdr tail) (atom (cdr tail)))
                      (write-string " . " o)
                      (write-string (lisp-repr (cdr tail) escape) o)))
           (write-char #\) o)))
        ((ename-p x) (format nil "<Entity name: ~(~X~)>" (+ #x7ff6a0000000 (parse-integer (ename-handle x) :radix 16))))
        ((pickset-p x) (format nil "<Selection set: ~(~X~)>" (pickset-id x)))
        ((subr-p x) (format nil "#<SUBR @~8,'0X ~A>" (sxhash x) (subr-name x)))
        ((fsubr-p x) (format nil "#<SUBR @~8,'0X ~A>" (sxhash x) (fsubr-name x)))
        ((ufunc-p x) (format nil "#<USUBR @~8,'0X ~A>" (sxhash x) (or (ufunc-name x) "-lambda-")))
        ((afile-p x) (format nil "#<file \"~A\">" (afile-path x)))
        ((catch-err-p x) (format nil "#<%catch-all-apply-error%>"))
        (t (princ-to-string x))))

;;; ---------- evaluator ----------

(defun aeval (form)
  (cond ((symbolp form) (sym-value form))
        ((atom form) form)
        (t (let* ((head (car form))
                  (f (cond ((symbolp head) (sym-value head))
                           ((consp head) (aeval head))
                           (t head))))
             (typecase f
               (fsubr (funcall (fsubr-fn f) (cdr form)))
               (subr (call-subr f (mapcar #'aeval (cdr form))))
               (ufunc (call-ufunc f (mapcar #'aeval (cdr form))))
               (cons (call-ufunc (list->ufunc f) (mapcar #'aeval (cdr form))))
               (t (aerr "no function definition: ~A" (lisp-repr head))))))))

(defun eval-body (body)
  (let ((v nil)) (dolist (f body v) (setf v (aeval f)))))

(defun call-subr (f args)
  (let ((n (length args)))
    (when (< n (subr-min f)) (aerr "too few arguments"))
    (when (and (subr-max f) (> n (subr-max f))) (aerr "too many arguments"))
    (apply (subr-fn f) args)))

(defun call-ufunc (f args)
  (let ((params (ufunc-params f)) (nargs (length args)))
    (cond ((< nargs (length params)) (aerr "too few arguments"))
          ((> nargs (length params)) (aerr "too many arguments")))
    (if (and (null params) (null (ufunc-locals f)))
        (eval-body (ufunc-body f))
        (progv (append params (ufunc-locals f))
            (append args (make-list (length (ufunc-locals f)) :initial-element nil))
          (eval-body (ufunc-body f))))))

(defun parse-arglist (arglist)
  (unless (listp arglist) (bad-arg "listp" arglist))
  (let ((slash (position (sym "/") arglist)))
    (values (subseq arglist 0 slash) (and slash (subseq arglist (1+ slash))))))

(defun list->ufunc (l &optional name)
  (multiple-value-bind (params locals) (parse-arglist (car l))
    (make-ufunc :name name :params params :locals locals :body (cdr l))))

(defun funcall-a (f &rest args) (apply-a f args))
(defun apply-a (f args)
  (let ((f (resolve-fn f)))
    (typecase f
      (subr (call-subr f args))
      (ufunc (call-ufunc f args))
      (t (bad-arg "function" f)))))

(defun resolve-fn (f)
  (cond ((or (subr-p f) (ufunc-p f)) f)
        ((and (consp f) (eq (car f) (sym "LAMBDA"))) (list->ufunc (cdr f)))
        ((and (consp f) (listp (car f))) (list->ufunc f))
        ((and f (symbolp f)) (let ((v (sym-value f)))
                               (cond ((or (subr-p v) (ufunc-p v)) v)
                                     ((fsubr-p v) (aerr "bad argument type: function: ~A" (lisp-repr f)))
                                     ((consp v) (list->ufunc v (symbol-name f)))
                                     (t (aerr "no function definition: ~A" (lisp-repr f))))))
        (t (bad-arg "function" f))))

(defmacro defspecial (name (args) &body body)
  `(setf (symbol-value (asym ,name))
         (make-fsubr :name ,(string-upcase name) :fn (lambda (,args) (declare (ignorable ,args)) ,@body))))

(defmacro defsubr (names lambda-list &body body)
  (let* ((names (if (listp names) names (list names)))
         (req (or (position-if (lambda (x) (member x '(&optional &rest))) lambda-list) (length lambda-list)))
         (opt-pos (position '&optional lambda-list))
         (rest-pos (position '&rest lambda-list))
         (nopt (if opt-pos (- (or rest-pos (length lambda-list)) opt-pos 1) 0))
         (max (if rest-pos nil (+ req nopt))))
    `(let ((fn (lambda ,lambda-list ,@body)))
       ,@(loop for n in names
               collect `(setf (symbol-value (asym ,n))
                              (make-subr :name ,(string-upcase n) :fn fn :min ,req :max ,max))))))

;;; ---------- argument checks ----------

(defun anum (x) (if (realp x) x (bad-arg "numberp" x)))
(defun aint (x) (if (integerp x) x (bad-arg "fixnump" x)))
(defun astr (x) (if (stringp x) x (bad-arg "stringp" x)))
(defun alst (x) (if (listp x) x (bad-arg "listp" x)))
(defun apt (x) (if (pointp x) x (bad-arg "point" x)))
(defun truthy (x) (not (null x)))
(defun bool (x) (if x t nil))

;;; ---------- special forms ----------

(defspecial "quote" (a) (first a))
(defspecial "function" (a)
  (let ((x (first a)))
    (if (and (consp x) (eq (car x) (sym "LAMBDA"))) (list->ufunc (cdr x)) (sym-value x))))
(defspecial "setq" (a)
  (let ((v nil))
    (loop while a do
      (let ((s (pop a)))
        (unless (and s (symbolp s)) (bad-arg "symbolp" s))
        (when (null a) (aerr "too few arguments"))
        (setf v (set-sym s (aeval (pop a))))))
    v))
(defspecial "defun" (a)
  (let ((name (first a)))
    (unless (and name (symbolp name)) (bad-arg "symbolp" name))
    (multiple-value-bind (params locals) (parse-arglist (second a))
      (set-sym name (make-ufunc :name (symbol-name name) :params params :locals locals :body (cddr a))))
    name))
(defspecial "defun-q" (a)
  (set-sym (first a) (copy-tree (cdr a)))
  (first a))
(defspecial "lambda" (a) (list->ufunc a))
(defspecial "if" (a)
  (when (or (null a) (null (cdr a))) (aerr "too few arguments"))
  (when (cdddr a) (aerr "too many arguments"))
  (if (aeval (first a)) (aeval (second a)) (and (third a) (aeval (third a)))))
(defspecial "cond" (a)
  (dolist (clause a nil)
    (let ((v (aeval (first clause))))
      (when v (return (if (rest clause) (eval-body (rest clause)) v))))))
(defspecial "while" (a)
  (let ((v nil)) (loop while (aeval (first a)) do (setf v (eval-body (rest a)))) v))
(defspecial "repeat" (a)
  (let ((n (aint (aeval (first a)))) (v nil))
    (loop repeat n do (setf v (eval-body (rest a)))) v))
(defspecial "foreach" (a)
  (let ((var (first a)) (lst (alst (aeval (second a)))) (v nil))
    (progv (list var) (list nil)
      (dolist (x lst) (set-sym var x) (setf v (eval-body (cddr a)))))
    v))
(defspecial "progn" (a) (eval-body a))
(defspecial "and" (a) (bool (every #'aeval a)))
(defspecial "or" (a) (bool (some #'aeval a)))
(defspecial "vlax-for" (a) (declare (ignore a)) (aerr "vlax-for: ActiveX is not supported"))

;;; ---------- arithmetic ----------

(defun num-result (x) (if (floatp x) (d x) x))
(defsubr "+" (&rest a) (num-result (reduce #'+ (mapcar #'anum a) :initial-value 0)))
(defsubr "*" (&rest a) (if a (num-result (reduce #'* (mapcar #'anum a))) 0))
(defsubr "-" (&rest a)
  (mapc #'anum a)
  (cond ((null a) 0) ((null (cdr a)) (- (first a))) (t (num-result (reduce #'- a)))))
(defun adiv (x y)
  (when (zerop y) (aerr "divide by zero"))
  (if (and (integerp x) (integerp y)) (truncate x y) (/ (d x) (d y))))
(defsubr "/" (&rest a)
  (mapc #'anum a)
  (cond ((null a) 0) ((null (cdr a)) (first a)) (t (reduce #'adiv a))))
(defsubr "rem" (&rest a)
  (mapc #'anum a)
  (if (null a) 0
      (reduce (lambda (x y) (when (zerop y) (aerr "divide by zero"))
                (if (and (integerp x) (integerp y)) (rem x y) (rem (d x) (d y))))
              a)))
(defsubr "1+" (x) (1+ (anum x)))
(defsubr "1-" (x) (1- (anum x)))
(defsubr "abs" (x) (abs (anum x)))
(defsubr "fix" (x) (values (truncate (anum x))))
(defsubr "float" (x) (d (anum x)))
(defsubr "max" (&rest a) (mapc #'anum a)
  (let ((r (reduce #'max a))) (if (some #'floatp a) (d r) r)))
(defsubr "min" (&rest a) (mapc #'anum a)
  (let ((r (reduce #'min a))) (if (some #'floatp a) (d r) r)))
(defsubr "gcd" (a b) (gcd (aint a) (aint b)))
(defsubr "lcm" (a b) (lcm (aint a) (aint b)))
(defsubr "sqrt" (x) (if (minusp (anum x)) (aerr "function undefined for argument: ~A" (lisp-repr x)) (sqrt (d x))))
(defsubr "expt" (b e)
  (anum b) (anum e)
  (if (and (integerp b) (integerp e) (>= e 0)) (expt b e) (d (expt (d b) (d e)))))
(defsubr "exp" (x) (exp (d (anum x))))
(defsubr "log" (x) (if (<= (anum x) 0) (aerr "function undefined for argument: ~A" (lisp-repr x)) (log (d x))))
(defsubr "sin" (x) (sin (d (anum x))))
(defsubr "cos" (x) (cos (d (anum x))))
(defsubr "atan" (y &optional x) (if x (atan (d (anum y)) (d (anum x))) (atan (d (anum y)))))
(defsubr "~" (x) (lognot (aint x)))
(defsubr "logand" (&rest a) (apply #'logand (mapcar #'aint a)))
(defsubr "logior" (&rest a) (apply #'logior (mapcar #'aint a)))
(defsubr "lsh" (&optional (n 0) (bits 0)) (ash (aint n) (aint bits)))
(defsubr "boole" (op &rest ints)
  (aint op)
  (reduce (lambda (a b)
            (let ((r 0))
              (dotimes (bit 32 r)
                (let* ((x (if (logbitp bit a) 1 0)) (y (if (logbitp bit b) 1 0))
                       (sel (+ (* x 2) y)))   ; AutoLISP: bit 1=11, 2=10, 4=01, 8=00
                  (when (logbitp (case sel (3 0) (2 1) (1 2) (0 3)) op)
                    (setf r (logior r (ash 1 bit))))))))
          (mapcar #'aint ints)))
(defsubr "numberp" (x) (bool (realp x)))
(defsubr "minusp" (x) (bool (minusp (anum x))))
(defsubr "zerop" (x) (bool (zerop (anum x))))

;;; ---------- comparison ----------

(defun string-cmp (a b) (cond ((string< a b) -1) ((string> a b) 1) (t 0)))
(defun chain (pred a)
  (loop for rest on a while (cdr rest)
        always (let ((x (first rest)) (y (second rest)))
                 (cond ((and (realp x) (realp y)) (funcall pred x y))
                       ((and (stringp x) (stringp y)) (funcall pred (string-cmp x y) 0))
                       (t (bad-arg (if (realp x) "numberp" "stringp") y))))))
(defun aeql (x y)
  (cond ((and (realp x) (realp y)) (= x y))
        ((and (stringp x) (stringp y)) (string= x y))
        (t (eq x y))))
(defsubr "=" (x &rest a)
  (bool (loop for tail on (cons x a) while (cdr tail) always (aeql (first tail) (second tail)))))
(defsubr "/=" (x &rest a)
  (bool (loop for tail on (cons x a) while (cdr tail) thereis (not (aeql (first tail) (second tail))))))
(defsubr "<" (x &rest a) (bool (chain #'< (cons x a))))
(defsubr ">" (x &rest a) (bool (chain #'> (cons x a))))
(defsubr "<=" (x &rest a) (bool (chain #'<= (cons x a))))
(defsubr ">=" (x &rest a) (bool (chain #'>= (cons x a))))
(defun aeq (a b) (or (eq a b) (and (numberp a) (numberp b) (eql a b))))
(defun aequal (a b &optional (fuzz 0))
  (cond ((and (realp a) (realp b)) (<= (abs (- a b)) fuzz))
        ((and (stringp a) (stringp b)) (string= a b))
        ((and (consp a) (consp b)) (and (aequal (car a) (car b) fuzz) (aequal (cdr a) (cdr b) fuzz)))
        (t (eq a b))))
(defsubr "eq" (a b) (bool (aeq a b)))
(defsubr "equal" (a b &optional (fuzz 0)) (bool (aequal a b (anum fuzz))))
(defsubr "not" (x) (bool (null x)))
(defsubr "null" (x) (bool (null x)))
(defsubr "atom" (x) (bool (atom x)))
(defsubr "listp" (x) (bool (listp x)))
(defsubr "vl-consp" (x) (bool (consp x)))
(defsubr "boundp" (s) (bool (and (symbolp s) (sym-value s))))
(defsubr "vl-symbolp" (s) (bool (and s (symbolp s))))
(defsubr "type" (x)
  (cond ((null x) nil)
        ((integerp x) (sym "INT")) ((realp x) (sym "REAL")) ((stringp x) (sym "STR"))
        ((symbolp x) (sym "SYM")) ((consp x) (sym "LIST"))
        ((or (subr-p x) (fsubr-p x)) (sym "SUBR")) ((ufunc-p x) (sym "USUBR"))
        ((ename-p x) (sym "ENAME")) ((pickset-p x) (sym "PICKSET"))
        ((afile-p x) (sym "FILE")) (t (sym "UNKNOWN"))))

;;; ---------- lists ----------

(defun acar (x) (if (listp x) (car x) (bad-arg "consp" x)))
(defun acdr (x) (if (listp x) (cdr x) (bad-arg "consp" x)))
;; car, cdr, and every c[ad]{2,4}r combination
(macrolet ((def-cxrs ()
             (let ((forms nil))
               (labels ((gen (path)
                          (when (<= 1 (length path) 4)
                            (let ((name (format nil "c~Ar" path)))
                              (push `(defsubr ,name (x)
                                       ,(let ((body 'x))
                                          (loop for ch across (reverse path)
                                                do (setf body (if (char= ch #\a) `(acar ,body) `(acdr ,body))))
                                          body))
                                    forms)))
                          (when (< (length path) 4)
                            (gen (concatenate 'string "a" path))
                            (gen (concatenate 'string "d" path)))))
                 (gen "a") (gen "d"))
               `(progn ,@forms))))
  (def-cxrs))
(defsubr "cons" (a b) (cons a b))
(defsubr "list" (&rest a) a)
(defsubr "append" (&rest a) (apply #'append (mapcar (lambda (x) (copy-list (alst x))) a)))
