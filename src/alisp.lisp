(defun wcmatch (s pattern)
  "AutoCAD wildcard matching: # @ . * ? ~ [...] ` and comma alternatives."
  (let ((alts (split-wc-alternatives pattern)))
    (some (lambda (p)
            (if (and (plusp (length p)) (char= (char p 0) #\~))
                (not (wc1 s 0 (subseq p 1) 0))
                (wc1 s 0 p 0)))
          alts)))
(defun split-wc-alternatives (p)
  (let ((parts nil) (cur (make-string-output-stream)) (i 0) (n (length p)))
    (loop while (< i n) do
      (let ((c (char p i)))
        (cond ((char= c #\`) (write-char c cur) (when (< (1+ i) n) (write-char (char p (1+ i)) cur)) (incf i 2))
              ((char= c #\,) (push (get-output-stream-string cur) parts) (incf i))
              (t (write-char c cur) (incf i)))))
    (push (get-output-stream-string cur) parts)
    (nreverse parts)))
(defun wc1 (s i p j)
  (let ((n (length s)) (m (length p)))
    (cond ((>= j m) (= i n))
          (t (let ((c (char p j)))
               (case c
                 (#\* (loop for k from i to n thereis (wc1 s k p (1+ j))))
                 (#\? (and (< i n) (wc1 s (1+ i) p (1+ j))))
                 (#\# (and (< i n) (digit-char-p (char s i)) (wc1 s (1+ i) p (1+ j))))
                 (#\@ (and (< i n) (alpha-char-p (char s i)) (wc1 s (1+ i) p (1+ j))))
                 (#\. (and (< i n) (not (alphanumericp (char s i))) (wc1 s (1+ i) p (1+ j))))
                 (#\` (and (< i n) (< (1+ j) m) (char= (char s i) (char p (1+ j))) (wc1 s (1+ i) p (+ j 2))))
                 (#\[ (let* ((close (position #\] p :start (+ j 2)))
                             (neg (and (< (1+ j) m) (char= (char p (1+ j)) #\~)))
                             (set (subseq p (+ j (if neg 2 1)) (or close m))))
                        (and (< i n)
                             (let ((hit (char-in-wc-set (char s i) set)))
                               (if neg (not hit) hit))
                             (wc1 s (1+ i) p (if close (1+ close) m)))))
                 (t (and (< i n) (char= c (char s i)) (wc1 s (1+ i) p (1+ j))))))))))
(defun char-in-wc-set (ch set)
  (loop for k from 0 below (length set)
        thereis (if (and (< (+ k 2) (length set)) (char= (char set (1+ k)) #\-))
                    (prog1 (char<= (char set k) ch (char set (+ k 2))) (incf k 2))
                    (char= ch (char set k)))))

;;; ---------- number formatting (rtos/angtos/distof) ----------

(defun fmt-decimal (x prec)
  (let ((s (format nil "~,vF" (max 0 prec) (d x))))
    (when (zerop prec) (setf s (string-right-trim "." s)))
    (when (and (plusp (length s)) (char= (char s 0) #\.)) (setf s (concatenate 'string "0" s)))
    (when (and (> (length s) 1) (string= (subseq s 0 2) "-.")) (setf s (concatenate 'string "-0" (subseq s 1))))
    (if (every (lambda (c) (member c '(#\- #\0 #\.))) s) (string-left-trim "-" s) s)))

(defun fraction-string (x prec)
  "Format X as whole + fraction with denominator 2^PREC."
  (let* ((den (expt 2 (max 0 prec)))
         (total (round (* (abs x) den)))
         (whole (floor total den))
         (num (mod total den))
         (g (if (zerop num) 1 (gcd num den)))
         (sign (if (and (minusp x) (plusp total)) "-" "")))
    (cond ((zerop num) (format nil "~A~D" sign whole))
          ((zerop whole) (format nil "~A~D/~D" sign (/ num g) (/ den g)))
          (t (format nil "~A~D ~D/~D" sign whole (/ num g) (/ den g))))))

(defun rtos (x &optional mode prec)
  (let ((mode (or mode (sysvar "LUNITS") 2)) (prec (or prec (sysvar "LUPREC") 4)) (x (d x)))
    (case mode
      (1 (let* ((e (if (zerop x) 0 (floor (log (abs x) 10)))) (m (/ x (expt 10d0 e))))
           (format nil "~AE~A~2,'0D" (fmt-decimal m prec) (if (minusp e) "-" "+") (abs e))))
      (3 (let* ((ft (truncate x 12)) (in (- x (* ft 12))))
           (if (zerop ft) (format nil "~A\"" (fmt-decimal in prec))
               (format nil "~D'-~A\"" ft (fmt-decimal (abs in) prec)))))
      (4 (let* ((den (expt 2 prec)) (total (/ (round (* (abs x) den)) den))
                (ft (floor total 12)) (in (- total (* ft 12)))
                (sign (if (minusp x) "-" "")))
           (if (zerop ft) (format nil "~A~A\"" sign (fraction-string in prec))
               (format nil "~A~D'-~A\"" sign ft (fraction-string in prec)))))
      (5 (fraction-string x prec))
      (t (fmt-decimal x prec)))))

(defun angtos (a &optional mode prec)
  (let* ((mode (or mode (sysvar "AUNITS") 0)) (prec (or prec (sysvar "AUPREC") 0))
         (a (norm-ang a)) (dg (deg a)))
    (case mode
      (1 (let* ((dd (floor dg)) (mf (* 60 (- dg dd))) (mm (floor mf)) (ss (* 60 (- mf mm))))
           (cond ((<= prec 0) (format nil "~Dd" (round dg)))
                 ((<= prec 2) (format nil "~Dd~D'" dd (round mf)))
                 (t (format nil "~Dd~D'~A\"" dd mm (fmt-decimal ss (max 0 (- prec 4))))))))
      (2 (format nil "~Ag" (fmt-decimal (* a (/ 200d0 +pi+)) prec)))
      (3 (format nil "~Ar" (fmt-decimal a prec)))
      (4 (let* ((brg (norm-ang (- (/ +pi+ 2) a))) (q (floor brg (/ +pi+ 2)))
                (ns (if (or (= q 0) (= q 3)) "N" "S")) (ew (if (< q 2) "E" "W"))
                (off (case q (0 brg) (1 (- +pi+ brg)) (2 (- brg +pi+)) (t (- +2pi+ brg)))))
           (format nil "~A ~Ad ~A" ns (fmt-decimal (deg off) prec) ew)))
      (t (fmt-decimal dg prec)))))

(defun distof (s &optional mode)
  (declare (ignore mode))
  (let* ((s (string-trim " " s)))
    (handler-case
        (cond ((zerop (length s)) nil)
              ((find #\' s)                       ; feet-inches: 2'-6 1/2"
               (let* ((q (position #\' s)) (ft (parse-token (subseq s 0 q)))
                      (rest (string-trim " -\"" (subseq s (1+ q)))))
                 (+ (* 12 (d ft)) (if (plusp (length rest)) (or (parse-fraction rest) 0d0) 0d0))))
              (t (parse-fraction (string-right-trim "\"" s))))
      (error () nil))))
(defun parse-fraction (s)
  (let* ((s (string-trim " " s)) (sp (position #\Space s)) (sl (position #\/ s)))
    (cond (sl (let* ((whole (if sp (d (parse-token (subseq s 0 sp))) 0d0))
                     (frac (subseq s (if sp (1+ sp) 0)))
                     (k (position #\/ frac))
                     (v (/ (d (parse-token (subseq frac 0 k))) (d (parse-token (subseq frac (1+ k)))))))
                (if (minusp whole) (- whole v) (+ whole v))))
          ((number-token-p s) (d (parse-token s)))
          (t nil))))

(defun angtof (s &optional mode)
  (let ((s (string-trim " " s)))
    (handler-case
        (cond ((and (eql mode 3) (number-token-p (string-right-trim "r" s))) (d (parse-token (string-right-trim "r" s))))
              ((find #\d s :test #'char-equal)
               (let* ((dp (position #\d s :test #'char-equal)) (dg (d (parse-token (subseq s 0 dp))))
                      (r (subseq s (1+ dp))) (mp (position #\' r))
                      (mn (if mp (d (parse-token (subseq r 0 mp))) 0d0))
                      (sc (if mp (let ((x (string-trim "\" " (subseq r (1+ mp))))) (if (plusp (length x)) (d (parse-token x)) 0d0)) 0d0)))
                 (norm-ang (rad (+ dg (/ mn 60) (/ sc 3600))))))
              ((and (plusp (length s)) (char-equal (char s (1- (length s))) #\r)) (d (parse-token (subseq s 0 (1- (length s))))))
              ((and (plusp (length s)) (char-equal (char s (1- (length s))) #\g)) (* (d (parse-token (subseq s 0 (1- (length s))))) (/ +pi+ 200)))
              ((number-token-p s) (norm-ang (rad (parse-token s))))
              (t nil))
      (error () nil))))

(defsubr "rtos" (x &optional mode prec) (rtos (anum x) mode prec))
(defsubr "angtos" (x &optional mode prec) (angtos (anum x) mode prec))
(defsubr "distof" (s &optional mode) (distof (astr s) mode))
(defsubr "angtof" (s &optional mode) (angtof (astr s) mode))
(defsubr "cvunit" (v from to)
  (let ((table '(("inch" . 1d0) ("inches" . 1d0) ("in" . 1d0) ("foot" . 12d0) ("feet" . 12d0) ("ft" . 12d0)
                 ("mm" . 0.03937007874015748d0) ("millimeter" . 0.03937007874015748d0) ("cm" . 0.3937007874015748d0)
                 ("meter" . 39.37007874015748d0) ("m" . 39.37007874015748d0) ("yard" . 36d0)
                 ("mile" . 63360d0) ("km" . 39370.07874015748d0)
                 ("degree" . 1d0) ("radian" . 57.29577951308232d0))))
    (let ((f (cdr (assoc from table :test #'string-equal))) (g (cdr (assoc to table :test #'string-equal))))
      (and f g (if (pointp v) (mapcar (lambda (x) (/ (* x f) g)) v) (/ (* (anum v) f) g))))))

;;; ---------- geometry functions ----------

(defsubr "distance" (a b) (if (or (null (cddr a)) (null (cddr b))) (dist2d (apt a) (apt b)) (dist (apt a) (apt b))))
(defsubr "angle" (a b) (ang (apt a) (apt b)))
