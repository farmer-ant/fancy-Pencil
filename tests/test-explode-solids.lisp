;; EXPLODE on 3D solids: faces as regions and surfaces; on those, edges as lines.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-explode-solids.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun kinds () (sort (mapcar (lambda (e) (let ((d (ent-data e))) (if (equal (dxf 0 d) "POLYFACE") (or (dxf :kind d) "solid") (dxf 0 d))))
                              (live-entities))
                      #'string<))
(defun clear () (al "(command \"erase\" \"all\" \"\")"))

(al "(command \"box\" '(0 0) '(10 20) 5)")
(al "(command \"chprop\" \"l\" \"\" \"c\" 3 \"\")")
(al "(command \"explode\" \"l\" \"\")")
(chk "box -> 6 regions" (kinds) '("Region" "Region" "Region" "Region" "Region" "Region"))
(chk "the faces keep the color" (every (lambda (e) (eql (dxf 62 (ent-data e)) 3)) (live-entities)) t)
(chk "the regions add up to the box's area"
     (round (loop for e in (live-entities) sum (loop for f in (mesh-faces (ent-data e))
                                                      sum (let ((ps (mesh-face-points (ent-data e) f)))
                                                            (loop for i from 1 below (1- (length ps))
                                                                  sum (* 0.5 (vlen3 (cross3 (v- (nth i ps) (first ps)) (v- (nth (1+ i) ps) (first ps))))))))))
     (* 2 (+ (* 10 20) (* 10 5) (* 20 5))))
(al "(command \"explode\" \"all\" \"\")")
(chk "regions -> edges: 6 x 4 lines" (length (live-entities)) 24)
(clear)

(al "(command \"cylinder\" '(0 0) 5 10)")
(al "(command \"explode\" \"l\" \"\")")
(chk "cylinder -> 2 round regions and a surface" (kinds) '("Region" "Region" "Surface"))
(clear)

(al "(command \"sphere\" '(0 0 0) 5)")
(al "(command \"explode\" \"l\" \"\")")
(chk "sphere -> one surface" (kinds) '("Surface"))
(clear)

(al "(command \"box\" '(0 0) '(10 10) 10)")
(al "(setq b (entlast))")
(al "(command \"cylinder\" '(5 5) 3 10)")
(al "(command \"subtract\" b \"\" \"l\" \"\")")
(let ((n (length (live-entities))))
  (al "(command \"explode\" \"all\" \"\")")
  (chk "box with a hole: 6 faces + the hole's surface" (list n (kinds)) '(1 ("Region" "Region" "Region" "Region" "Region" "Region" "Surface"))))
(al "(command \"u\")")
(chk "undo brings the solid back" (kinds) '("solid"))

(format t "~%~D passed, ~D failed~%" *pass* *fail*)
(sb-ext:exit :code (if (zerop *fail*) 0 1))
