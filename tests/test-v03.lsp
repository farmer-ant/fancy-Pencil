;; ---------- leaders ----------
(defun entbefore (e / x prev) (setq x (entnext)) (while (and x (not (eq x e))) (setq prev x x (entnext x))) prev)
(command "new")
(command "leader" '(0 0) '(2 2) "" "FIRST LINE" "SECOND" "")
(setq tx (entlast))
(check "leader note is mtext" (g tx 0) "MTEXT")
(check "leader note text" (g tx 1) "FIRST LINE\\PSECOND")
(setq ld (entbefore tx))
(check "leader object" (g ld 0) "LEADER")
(check "leader arrow on" (g ld 71) 1)
(check "leader straight" (g ld 72) 0)
(check "leader landing added" (length (vl-remove-if-not '(lambda (p) (= (car p) 10)) (entget ld))) 3)
(check "note right of landing" (> (car (g tx 10)) 2.0) T)
(command "leader" '(10 0) "S" '(8 1) '(6 1) "NOText")
(check "spline leader" (g (entlast) 72) 1)
(check "no text: no landing" (length (vl-remove-if-not '(lambda (p) (= (car p) 10)) (entget (entlast)))) 3)
(command "leader" '(20 0) "ST" "None" '(18 3) "" "")
(check "straight again, no arrow" (list (g (entlast) 72) (g (entlast) 71)) '(0 0))
(command "leader" "Arrow" '(30 0) '(28 3) "U" '(26 0) "" "LEFT" "")
(check "leftward note right-attached" (g (entlast) 71) 3)
(check "undo leader point" (length (vl-remove-if-not '(lambda (p) (= (car p) 10)) (entget (entbefore (entlast))))) 2)
(command "-layer" "m" "NOTES" "")
(command "leader" '(40 0) '(42 2) "" "ON NOTES" "")
(check "hooked leader keeps its layer" (g (entbefore (entlast)) 8) "NOTES")
(command "close")

