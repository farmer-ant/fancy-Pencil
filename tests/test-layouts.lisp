;; Paper space: layouts, viewports, working through a viewport, plotting and saving layouts.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-layouts.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defun r3 (x) (if (listp x) (mapcar #'r3 x) (if (realp x) (/ (round (* x 1000)) 1000) x)))
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))
(setf *cw* 800 *ch* 600 *vscale* 50d0 *vx* 3d0 *vy* 1d0)

;; model space: a box and a line
(al "(command \"box\" '(0 0 0) '(4 2 0) 3)")
(al "(command \"line\" '(0 0 0) '(10 0 0) \"\")")
(chk "two objects in model space" (length (live-entities)) 2)
(chk "a new drawing has Layout1" (mapcar #'layout-name (drawing-layouts *dwg*)) '("Layout1"))
(chk "starts on the Model tab" (drawing-ctab *dwg*) nil)

;; the layout tab
(al "(command \"layout\" \"set\" \"Layout1\")")
(chk "on Layout1" (drawing-ctab *dwg*) "Layout1")
(chk "CTAB follows" (sysvar "CTAB") "Layout1")
(chk "paper space is empty" (live-entities) nil)
(chk "paper space" (paper-space-p) t)
(chk "the sheet: tabloid landscape, inches" (r3 (multiple-value-list (layout-sheet-size (current-layout)))) '(17 11))
(al "(command \"rectang\" '(0.5 0.5) '(16.5 10.5))")
(defvar border (newest))
(chk "the border belongs to the layout" (dxf :layout (ename-data border)) "Layout1")
(chk "model space doesn't show it" (let ((*space-override* nil)) (length (live-entities))) 2)
(chk "every object" (length (all-live-entities)) 3)

;; one viewport filling the printable area
(al "(command \"mview\" \"fit\")")
(defvar vp1 (newest))
(chk "a viewport" (ent-type vp1) "VIEWPORT")
(chk "it fills the printable area" (r3 (vp-rect (ename-data vp1))) '(0.25 0.25 16.75 10.75))
(chk "it looks at the middle of the model" (r3 (let ((c (vp-view-center (ename-data vp1)))) (list (px c) (py c)))) '(5 1))
(chk "the whole model fits" (< (/ 10 (/ (vp-width (ename-data vp1)) (vp-scale (ename-data vp1)))) 1) t)
(chk "its contents as paper prims" (> (length (vp-paper-prims (ename-data vp1))) 0) t)
(chk "the prims are on the sheet"
     (let ((pts (loop for p in (vp-paper-prims (ename-data vp1)) when (eq (first p) :poly) append (second p))))
       (every (lambda (q) (and (<= 0 (px q) 17) (<= 0 (py q) 11))) pts))
     t)

;; scale
(al "(command \"vpscale\" (entlast) \"\" \"1:2\")")
(chk "VPSCALE 1:2" (r3 (vp-scale (ename-data vp1))) 0.5)
(chk "named scale" (vp-scale-label (ename-data vp1)) "1:2")
(al "(command \"vpscale\" (entlast) \"\" \"1/4\\\"=1'-0\\\"\")")
(chk "architectural scale" (r3 (vp-scale (ename-data vp1))) (r3 (/ 1 48d0)))
(chk "parse 2:1" (parse-vp-scale "2:1") 2d0)
(chk "parse 0.5XP" (parse-vp-scale "0.5xp") 0.5d0)
(al "(command \"vpscale\" (entlast) \"\" \"1:1\")")

;; moving a viewport takes its contents along; a corner grip keeps the scale
(let ((before (vp-view-center (ename-data vp1))))
  (al "(command \"move\" (entlast) \"\" '(0 0) '(1 0))")
  (chk "moved viewport keeps its view" (equalp (vp-view-center (ename-data vp1)) before) t)
  (chk "moved viewport center" (r3 (px (vp-center (ename-data vp1)))) 9.5))
(al "(command \"move\" (entlast) \"\" '(1 0) '(0 0))")
(let* ((d (ename-data vp1)) (nd (grip-stretch d '(:vpcorner 2) (pt 16.75 10.75) (pt 12 8))))
  (chk "corner grip resizes" (r3 (vp-rect nd)) '(0.25 0.25 12 8))
  (chk "corner grip keeps the scale" (r3 (vp-scale nd)) (r3 (vp-scale d))))

;; working inside the viewport
(al "(command \"mspace\")")
(chk "MSPACE: in the viewport" (eq (drawing-active-vp *dwg*) vp1) t)
(chk "model space is being drawn in" (current-space) nil)
(chk "the model is what's listed" (length (live-entities)) 2)
(al "(command \"circle\" '(5 5) 1)")
(chk "a circle drawn in the viewport is a model object" (dxf :layout (ename-data (newest))) nil)
(let ((s0 (vp-scale (ename-data vp1))))
  (setf *vscale* (* *vscale* 2))
  (layout-prepare)
  (chk "zooming in the viewport changes its scale" (r3 (/ (vp-scale (ename-data vp1)) s0)) 2))
(al "(command \"zoom\" \"1xp\")")
(chk "ZOOM 1XP" (r3 (vp-scale (ename-data vp1))) 1)
(al "(command \"-view\" \"front\")")
(layout-prepare)
(chk "a view picked in the viewport is kept" (vp-view-name (ename-data vp1)) "Front")
(al "(command \"pspace\")")
(chk "PSPACE: back on the sheet" (drawing-active-vp *dwg*) nil)
(chk "sheet view again" *view* nil)
(chk "paper objects again" (length (live-entities)) 2)

;; locked viewports ignore zooming
(set-entity-data vp1 (set-vp-key :locked t (ename-data vp1)))
(let ((s0 (vp-scale (ename-data vp1))))
  (enter-viewport vp1)
  (setf *vscale* (* *vscale* 3))
  (layout-prepare)
  (chk "locked viewport keeps its scale" (r3 (vp-scale (ename-data vp1))) (r3 s0))
  (leave-viewport))
(set-entity-data vp1 (set-vp-key :locked nil (ename-data vp1)))

;; four standard views
(al "(command \"layout\" \"new\" \"Views\")")
(chk "new layout current" (drawing-ctab *dwg*) "Views")
(al "(command \"mview\" \"4\" \"\" \"\")")
(let* ((vps (layout-viewports)) (names (mapcar (lambda (e) (vp-view-name (ename-data e))) vps)))
  (chk "four viewports" (length vps) 4)
  (chk "their views" names '("Top" "SE Isometric" "Front" "Right"))
  (let ((top (ename-data (first vps))) (front (ename-data (third vps))) (right (ename-data (fourth vps))))
    (chk "flat views share a scale" (r3 (list (vp-scale top) (vp-scale right))) (r3 (list (vp-scale front) (vp-scale front))))
    (chk "Top and Front line up (model X)" (r3 (px (vp-view-center top))) (r3 (px (vp-view-center front))))
    (chk "Front and Right line up (model Z)" (r3 (py (vp-view-center front))) (r3 (py (vp-view-center right))))))
(chk "MVIEW 2" (progn (al "(command \"mview\" \"2\" \"\" \"\")") (length (layout-viewports))) 6)
(al "(command \"u\")")
(chk "U takes both back" (length (layout-viewports)) 4)

;; palette edits
(let ((d (ename-data (first (layout-viewports)))))
  (chk "palette scale" (r3 (vp-scale (viewport-palette-edit d "VPSCALE" "1:4" nil))) 0.25)
  (chk "palette view" (vp-view-name (viewport-palette-edit d "VPVIEW" "Back" nil)) "Back")
  (chk "palette style" (vp-style (viewport-palette-edit d "VPSTYLE" "Shaded with Edges" nil)) "ShadedEdges")
  (chk "palette off" (vp-on-p (viewport-palette-edit d "VPON" "No" nil)) nil))

;; clipping helpers
(chk "clip a line" (r3 (clip-run (list (pt -1 0.5) (pt 2 0.5)) '(0 0 1 1))) '(((0 0.5 0) (1 0.5 0))))
(chk "clip a run that leaves and comes back"
     (length (clip-run (list (pt 0.5 0.5) (pt 2 0.5) (pt 2 0.7) (pt 0.5 0.7)) '(0 0 1 1))) 2)
(chk "clip a polygon" (length (clip-polygon (list (pt -1 -1) (pt 2 -1) (pt 2 2) (pt -1 2)) '(0 0 1 1))) 4)

;; plotting the layout
(ignore-errors (delete-file "/tmp/fp-layout.pdf"))
(al "(command \"layout\" \"set\" \"Layout1\")")
(al "(command \"-plot\" \"\" \"Tabloid\" \"Landscape\" \"Extents\" \"Fit\" \"No\" \"/tmp/fp-layout.pdf\")")
(chk "layout plot written" (and (probe-file "/tmp/fp-layout.pdf") t) t)
(chk "viewport clipped in the PDF" (and (search "re W n" (file-text "/tmp/fp-layout.pdf")) t) t)
(chk "1:1 on tabloid: sheet is 17 in = 1224 pt" (and (search "/MediaBox [0 0 1224 792]" (file-text "/tmp/fp-layout.pdf")) t) t)

;; saving and opening
(dxf-export-2000 "/tmp/fp-layouts.dxf")
(let ((txt (file-text "/tmp/fp-layouts.dxf")))
  (chk "ACAD_LAYOUT dictionary" (and (search "ACAD_LAYOUT" txt) t) t)
  (chk "second layout's block" (and (search "*Paper_Space0" txt) t) t)
  (chk "viewports written" (and (search "AcDbViewport" txt) t) t))
(defvar *model-count* (let ((*space-override* nil)) (length (live-entities))))
(dxf-import "/tmp/fp-layouts.dxf")
(chk "layouts come back" (mapcar #'layout-name (drawing-layouts *dwg*)) '("Layout1" "Views"))
(chk "opens on the Model tab" (drawing-ctab *dwg*) nil)
(chk "model objects come back" (length (live-entities)) *model-count*)
(chk "Layout1's objects" (sort (mapcar #'ent-type (layout-entities "Layout1")) #'string<) '("LWPOLYLINE" "VIEWPORT"))
(chk "Views' viewports" (mapcar (lambda (e) (vp-view-name (ename-data e))) (layout-viewports "Views"))
     '("Top" "SE Isometric" "Front" "Right"))
(let ((vp (first (layout-viewports "Layout1"))))
  (chk "viewport scale kept" (r3 (vp-scale (ename-data vp))) 1)
  (chk "viewport view kept" (vp-view-name (ename-data vp)) "Front")
  (chk "viewport rectangle kept" (r3 (vp-rect (ename-data vp))) '(0.25 0.25 16.75 10.75)))
(let* ((vps (layout-viewports "Views")) (iso (ename-data (second vps))) (front (ename-data (third vps))))
  (chk "iso viewport view center" (r3 (vp-view-center iso)) (r3 (vp-view-center iso)))
  (chk "front viewport model point survives"
       (r3 (vp-view-center front))
       (r3 (let ((*space-override* nil)) (vp-view-center (vp-fit front))))))

;; R12 keeps the sheet's objects in paper space
(al "(command \"layout\" \"set\" \"Layout1\")")
(dxf-export "/tmp/fp-layouts12.dxf")
(dxf-import "/tmp/fp-layouts12.dxf")
(chk "R12: paper objects come back on Layout1" (mapcar #'ent-type (layout-entities "Layout1")) '("LWPOLYLINE"))

;; layout management
(dxf-import "/tmp/fp-layouts.dxf")
(al "(command \"layout\" \"rename\" \"Views\" \"Sheet 2\")")
(chk "renamed" (mapcar #'layout-name (drawing-layouts *dwg*)) '("Layout1" "Sheet 2"))
(chk "objects follow the rename" (length (layout-viewports "Sheet 2")) 4)
(al "(command \"layout\" \"copy\" \"Layout1\" \"Layout1b\")")
(chk "copied with its objects" (length (layout-entities "Layout1b")) 2)
(al "(command \"layout\" \"delete\" \"Layout1b\")")
(chk "deleted" (find-layout "Layout1b") nil)
(chk "its objects went too" (layout-entities "Layout1b") nil)
(chk "PURGE keeps layers only paper uses"
     (progn (al "(command \"layout\" \"set\" \"Layout1\")") (al "(command \"-layer\" \"m\" \"TITLE\" \"\")")
            (al "(command \"line\" '(1 1) '(2 2) \"\")") (al "(setvar \"CLAYER\" \"0\")")
            (set-ctab nil) (al "(command \"purge\")") (and (find-layer "TITLE") t))
     t)
(al "(command \"model\")")
(chk "MODEL tab" (drawing-ctab *dwg*) nil)

(format t "~%Layout tests: ~D passed, ~D failed.~%" *pass* *fail*)
