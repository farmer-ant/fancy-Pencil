;; Attached pictures and PDF pages (IMAGEATTACH, PDFATTACH, IMAGE), and the session record (HISTORY).
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-raster.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun images () (remove-if-not (lambda (e) (equal (ent-type e) "IMAGE")) (live-entities)))
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))
(defun r3 (x) (/ (round (* 1000 x)) 1000))
(defparameter *data* (namestring (merge-pathnames "tests/data/" (truename "."))))
(defun data (f) (concatenate 'string *data* f))
(defun lisp-path (s) (substitute #\/ #\\ s))

;; what Fancy Pencil can read
(chk "JPEG is a picture to convert" (raster-kind "a/b.JPG") :raster)
(chk "TIFF is a picture to convert" (raster-kind "x.tiff") :raster)
(chk "PNG is shown as it is" (raster-kind "x.png") :native)
(chk "PDF" (raster-kind "x.pdf") :pdf)
(chk "a drawing is not a picture" (raster-kind "x.dxf") nil)
(chk "JPEG becomes a PNG" (and (raster-png (data "pic.jpg")) (raster-kind (raster-png (data "pic.jpg")))) :native)
(chk "its size in pixels" (image-pixel-size (raster-png (data "pic.jpg"))) '(64 48))
(chk "TIFF size" (image-pixel-size (raster-png (data "pic.tif"))) '(40 30))
(chk "PDF pages and size" (multiple-value-list (pdf-page-info (data "two-pages.pdf") 2)) (list 2 (/ 300d0 72) (/ 200d0 72)))
(chk "PDF page 2 at 150 dpi" (image-pixel-size (raster-png (data "two-pages.pdf") 2)) '(625 417))
(chk "a missing file" (multiple-value-list (raster-png "/nowhere/x.jpg")) '(nil "file not found"))
(chk "zoom/subsample ratio" (best-ratio 0.5d0) '(1 2))
(chk "zoom/subsample ratio 3" (best-ratio 3d0) '(3 1))

;; attaching: insertion point, then width
(al (format nil "(command \"imageattach\" ~S '(2 3) 8)" (data "pic.jpg")))
(chk "IMAGEATTACH makes an image" (ent-type (newest)) "IMAGE")
(let ((d (ename-data (first (images)))))
  (chk "placed" (pt3 (dxf 10 d)) (pt 2 3 0))
  (chk "width" (r3 (image-width d)) 8)
  (chk "height keeps the shape" (r3 (image-height d)) 6)
  (chk "keeps the file" (image-file d) (data "pic.jpg"))
  (chk "frame corners" (r3 (px (third (image-corners d)))) 10))
(al "(command \"line\" '(0 0) '(20 20) \"\")")
(al (format nil "(command \"imageattach\" ~S '(0 0) \"\")" (data "pic.tif")))
(chk "a new picture goes to the back" (ent-type (first (live-entities))) "IMAGE")
(chk "default size: 96 pixels to the inch" (r3 (image-width (ename-data (first (live-entities))))) (r3 (/ 40 96d0)))
;; a PDF page: asks for the page, then place and size (default: the page's real size)
(al (format nil "(command \"pdfattach\" ~S 2 '(30 0) \"\")" (data "two-pages.pdf")))
(let ((d (ename-data (first (live-entities)))))
  (chk "PDF page attached" (image-page d) 2)
  (chk "at the page's size" (r3 (image-width d)) (r3 (/ 300d0 72))))
(chk "three pictures" (length (images)) 3)

;; moving, scaling and rotating
(let ((e (find-if (lambda (e) (equal (image-file (ename-data e)) (data "pic.jpg"))) (images))))
  (al "(command \"move\" (ssget \"x\" '((0 . \"IMAGE\"))) \"\" '(0 0) '(1 1))")
  (chk "moved" (pt3 (dxf 10 (ename-data e))) (pt 3 4 0))
  (al (format nil "(command \"scale\" (handent ~S) \"\" '(3 4) 0.5)" (ename-handle e)))
  (chk "scaled" (r3 (image-width (ename-data e))) 4)
  (chk "upright: shown" (image-upright-p (ename-data e)) t)
  (al (format nil "(command \"rotate\" (handent ~S) \"\" '(3 4) 90)" (ename-handle e)))
  (chk "rotated: frame only" (image-upright-p (ename-data e)) nil)
  (chk "rotated corners" (mapcar #'r3 (list (px (second (image-corners (ename-data e)))) (py (second (image-corners (ename-data e))))))
       '(3 8))
  (al "(command \"u\")")
  (chk "U puts it back" (image-upright-p (ename-data e)) t)
  (chk "LIST" (and (search "pic.jpg" (describe-entity e)) (search "64 x 48 pixels" (describe-entity e)) t) t)
  (chk "selection by window finds the frame" (al "(sslength (ssget \"w\" '(2.5 3.5) '(7.5 7.5)))") 1))

;; the Image Manager, from the command line
(chk "manager lists files (in draw order)" (mapcar (lambda (r) (subseq r 0 3)) (image-manager-rows))
     (list (list "two-pages.pdf" "PDF page 2" "Loaded") (list "pic.tif" "TIFF" "Loaded") (list "pic.jpg" "JPEG" "Loaded")))
(defun row-of (name) (position name (image-manager-rows) :key #'first :test #'equal))
(image-manager-action "TOGGLE" 0 nil)
(chk "hide" (image-hidden-p (ename-data (first (live-entities)))) t)
(image-manager-action "TOGGLE" 0 nil)
(chk "show" (image-hidden-p (ename-data (first (live-entities)))) nil)
(image-manager-action "FADE" (row-of "pic.jpg") "50%")
(chk "fade" (image-fade (ename-data (find-if (lambda (e) (equal (file-namestring (image-file (ename-data e))) "pic.jpg")) (images)))) 50)
;; a picture that has moved: found again with a new path
(let ((tmp "/tmp/fp-moved.jpg"))
  (with-open-file (o tmp :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
    (write-sequence (read-bytes (data "pic.jpg") 417) o))
  (al (format nil "(command \"imageattach\" ~S '(50 50) 2)" tmp))
  (delete-file tmp)
  (forget-raster tmp nil)
  (chk "missing file shows Not found" (third (find "fp-moved.jpg" (image-manager-rows) :key #'first :test #'equal)) "Not found")
  (image-manager-action "DETACH" (position "fp-moved.jpg" (image-manager-rows) :key #'first :test #'equal) nil)
  (chk "detached" (length (images)) 3))

;; plotting: the picture goes into the PDF
(let ((prims (collect-plot-prims -10 -10 60 60)))
  (chk "plot primitives include pictures" (count :image prims :key #'first) 3)
  (let ((im (find :image prims :key #'first)))
    (chk "plotted picture is a PPM file" (and (probe-file (second im)) (string-equal (pathname-type (second im)) "ppm")) t)
    (write-plot-pdf "/tmp/fp-img.pdf" prims :paper-w 792 :paper-h 612 :window '(-10 -10 60 60) :scale-ppu 10 :offset '(0 0))))
(chk "PDF has image objects" (and (search "/Subtype /Image" (file-text "/tmp/fp-img.pdf")) (search "/Im3 Do" (file-text "/tmp/fp-img.pdf")) t) t)
(chk "the PDF reads back" (multiple-value-bind (code text) (run-shell "pdfimages -list /tmp/fp-img.pdf 2>&1 | tail -n +3 | wc -l")
                             (and (eql code 0) (string-trim '(#\Newline #\Space) text)))
     "3")

;; DXF 2000: IMAGE + IMAGEDEF, PDFUNDERLAY + PDFDEFINITION; read back
(dxf-export-2000 "/tmp/fp-img.dxf")
(let ((txt (file-text "/tmp/fp-img.dxf")))
  (chk "IMAGE written" (and (search (format nil "~%IMAGE~%") txt) t) t)
  (chk "IMAGEDEF written" (and (search "IMAGEDEF" txt) (search "ACAD_IMAGE_DICT" txt) t) t)
  (chk "PDFUNDERLAY written" (and (search "PDFUNDERLAY" txt) (search "ACAD_PDFDEFINITIONS" txt) t) t)
  (chk "classes" (and (search "AcDbRasterImage" txt) t) t))
(let ((before (mapcar (lambda (e) (let ((d (ename-data e))) (list (file-namestring (image-file d)) (image-page d) (r3 (image-width d)) (r3 (px (dxf 10 d))) (image-fade d)))) (images))))
  (dxf-import "/tmp/fp-img.dxf")
  (chk "pictures come back" (mapcar (lambda (e) (let ((d (ename-data e))) (list (file-namestring (image-file d)) (image-page d) (r3 (image-width d)) (r3 (px (dxf 10 d))) (image-fade d)))) (images))
       before))
(chk "draw order kept: picture at the back" (ent-type (first (live-entities))) "IMAGE")
;; R12 has no pictures: left out
(dxf-export "/tmp/fp-img12.dxf")
(chk "R12 leaves pictures out" (search "IMAGE" (file-text "/tmp/fp-img12.dxf")) nil)

;; the session record
(setf (fill-pointer *session-record*) 0)
(out "Command: LINE")
(out (format nil "~%Specify first point: "))
(chk "everything shown is recorded" (session-text) (format nil "Command: LINE~%Specify first point: "))
(let ((*session-record* (make-array 10 :element-type 'character :adjustable t :fill-pointer 0))
      (+record-limit+ 100))
  (dotimes (i 30) (record-output (format nil "line ~D~%" i)))
  (chk "old lines dropped past the limit" (and (<= (length (session-text)) 100) (search "line 29" (session-text)) (null (search "line 0~%" (session-text))) t) t))
(let ((dir "/tmp/fp-logs/"))
  (ignore-errors (dolist (f (directory (concatenate 'string dir "*.log"))) (delete-file f)))
  (setf (sysvar "LOGFILEPATH") dir)
  (al "(command \"logfileon\")")
  (out (format nil "a line for the log~%"))
  (al "(command \"logfileoff\")")
  (chk "log file written" (and (search "a line for the log" (file-text (log-file-path))) (search "Command: LINE" (file-text (log-file-path))) t) t)
  (out (format nil "not logged~%"))
  (chk "nothing after LOGFILEOFF" (search "not logged" (file-text (log-file-path))) nil)
  (setf (sysvar "LOGFILEPATH") "")
  (save-prefs))
(let* ((got "") (*output-fn* (lambda (x) (setf got (concatenate 'string got x)) x)))
  (funcall (find-command-function "HISTORY"))
  (chk "HISTORY on the command line" (and (search "a line for the log" got) t) t))
(format t "~%Picture and history tests: ~D passed, ~D failed.~%" *pass* *fail*)
