;; MTEXT with formatting on parts of the text: reading codes into runs, writing runs back,
;; layout, plotting, and the editor's results.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-richtext.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))

(defun texts (runs) (mapcar #'run-text runs))
(defparameter *c* "Plain {\\fArial|b1|i0|c0|p0;bold} and {\\H2x;\\C1;big red} \\Lund\\l end\\Pline2")
(let ((r (mtext-runs *c* :font "Arial" :height 0.5d0)))
  (chk "runs: split where the format changes" (texts r) (list "Plain " "bold" " and " "big red" " " "und" (format nil " end~%line2")))
  (chk "bold run" (run-bold (second r)) t)
  (chk "relative height: 2x of 0.5" (run-height (fourth r)) 1d0)
  (chk "color run" (run-aci (fourth r)) 1)
  (chk "underline \\L ... \\l" (run-underline (sixth r)) t)
  (chk "the group's end restores the format" (list (run-bold (third r)) (run-height (fifth r)) (run-aci (fifth r))) '(nil 0.5d0 nil))
  (chk "runs written back: only the changed parts get codes"
       (mtext-encode-runs r :font "Arial")
       "Plain {\\fArial|b1|i0|c0|p0;bold} and {\\H2x;\\C1;big red} {\\Lund} end\\Pline2")
  (chk "read again: the same runs" (mtext-runs (mtext-encode-runs r :font "Arial") :font "Arial" :height 0.5d0) r))
(chk "escapes survive" (texts (mtext-runs (mtext-encode-runs (list (list "a{b}\\c" "Arial" t nil nil 1d0 nil)) :font "Arial") :font "Arial" :height 1d0)) '("a{b}\\c"))
(chk "SHX fonts use \\F" (mtext-encode-runs (list (list "x" "Arial" nil nil nil 1d0 nil) (list "y" "romans.shx" nil nil nil 1d0 nil)) :font "Arial") "x{\\Fromans.shx;y}")
(chk "\\F without an extension is a .shx" (run-font (first (mtext-runs "\\Fromans;x" :height 1))) "romans.shx")
(chk "absolute \\H" (run-height (second (mtext-runs "a{\\H0.75;b}" :height 0.25d0))) 0.75d0)
(chk "%%d and stacks" (texts (mtext-runs "45%%d \\S1/2;" :height 1)) (list "45° 1/2"))
(chk "base height: what most characters have" (runs-base-height (list (list "abcdef" "A" nil nil nil 2d0 nil) (list "xy" "A" nil nil nil 5d0 nil))) 2d0)
(chk "plain text: no codes at all" (mtext-encode-runs (list (list "hello" "Arial" nil nil nil 1d0 nil)) :font "Arial") "hello")

;; entities
(defun mt (content &rest more)
  (add (append (list (cons 0 "MTEXT") (cons 10 (pt 0 0 0)) (cons 40 1d0) (cons 41 20d0) (cons 71 1) (cons 1 content)
                     (cons 7 "Standard"))
               more))
  (ename-data (car (last (live-entities)))))
(let ((plain (mt "just text"))
      (whole (mt "{\\fArial|b1|i0|c0|p0;all bold}"))
      (rich (mt "normal {\\fArial|b1|i0|c0|p0;bold} {\\C1;red}"))
      (big (mt "small {\\H3x;BIG}")))
  (chk "plain MTEXT: not rich" (mtext-rich-p plain) nil)
  (chk "whole-object format: not rich (drawn as one)" (mtext-rich-p whole) nil)
  (chk "part bold: rich" (mtext-rich-p rich) t)
  (chk "rich: height is the object's own" (text-effective-height rich) 1d0)
  (chk "rich: drawn run by run" (let ((cmd (render-rich-mtext rich 10 20 "#ffffff" "e1" nil)))
                                  (list (subseq cmd 0 7) (and (search "#FF0000" cmd) t) (and (search " bold}" cmd) t)))
       '("mtrich " t t))
  (multiple-value-bind (pieces total w) (mtext-rich-layout big)
    (chk "layout: pieces in order" (mapcar #'first pieces) '("small" " " "BIG"))
    (chk "layout: the big run sets the line" (list (< (abs (- total 3d0)) 1d-9) w) '(t 20d0))
    (chk "layout: shared baseline" (= (fourth (first pieces)) (fourth (third pieces))) t))
  (let ((tb (text-box big)))
    (chk "box: covers the big text" (> (- (py (fourth tb)) (py (first tb))) 3d0) t))
  ;; wrapping
  (let ((d (mt "aaaa bbbb {\\fArial|b1|i0|c0|p0;cccc} dddd" (cons 41 2.5d0))))
    (setf d (set-dxf 41 2.5d0 d))
    (multiple-value-bind (pieces) (mtext-rich-layout d)
      (chk "wrap: words go to new lines at the width"
           (> (length (remove-duplicates (mapcar #'fourth pieces))) 1) t)))
  ;; plotting
  (let ((*plot-prims* nil))
    (plot-rich-mtext rich '(0 0 0))
    (let ((txt (remove-if-not (lambda (p) (eq (first p) :text)) *plot-prims*)))
      (chk "plot: one text per piece" (mapcar #'second (reverse txt)) '("normal" "bold" "red"))
      (chk "plot: the bold piece in a bold font" (ninth (find "bold" txt :key #'second :test #'equal)) "Helvetica-Bold")
      (chk "plot: the red piece in red" (eighth (find "red" txt :key #'second :test #'equal)) '(1d0 0d0 0d0)))))

;; the editor's result
(defun erun (&rest fields) (format nil (format nil "~~{~~A~~^~C~~}" (code-char 29)) fields))
(let* ((runs (parse-editor-runs (format nil "~A~C~A~C~A" (erun "Hello " "Arial" 0 0 0 1 "") (code-char 30)
                                        (erun "world" "Arial" 1 0 0 1 5) (code-char 30)
                                        (erun (format nil "~Clinetwo" (code-char 28)) "Arial" 0 0 0 2 "")))))
  (chk "editor runs read" (mapcar (lambda (r) (list (run-text r) (run-bold r) (run-height r) (run-aci r))) runs)
       (list (list "Hello " nil 1d0 nil) (list "world" t 1d0 5) (list (format nil "~%linetwo") nil 2d0 nil)))
  (let ((content (editor-result-content (list :style "Standard" :runs runs :height (runs-base-height runs)))))
    (chk "editor result: codes only on the changed words" content "Hello {\\fArial|b1|i0|c0|p0;\\C5;world}{\\H2x;\\Plinetwo}")
    (let ((d (mt content)))
      (chk "saved MTEXT reads back as the same runs"
           (mapcar #'run-text (mtext-data-runs d)) (list "Hello " "world" (format nil "~%linetwo"))))))

;; DXF round trip keeps the inline codes
(let ((n (count "MTEXT" (live-entities) :key #'ent-type :test #'equal)))
  (dxf-export-2000 "/tmp/fp-rich.dxf")
  (%dxf-import "/tmp/fp-rich.dxf")
  (chk "saved and read back" (count "MTEXT" (live-entities) :key #'ent-type :test #'equal) n)
  (chk "rich text still rich" (some (lambda (e) (mtext-rich-p (ename-data e))) (live-entities)) t))
(format t "~%Rich text tests: ~D passed, ~D failed.~%" *pass* *fail*)
