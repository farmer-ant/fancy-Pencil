;; The calculator: CAL expressions, the CAL command, and 'CAL typed in the middle of a command.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-calc.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun ce (s) (handler-case (calc-format (calc-eval s)) (calc-error (c) (concatenate 'string "! " (calc-msg c)))))
(chk "precedence" (mapcar #'ce '("1+2*3" "(1+2)*3" "2^10" "-3^2" "10/4")) '("7" "9" "1024" "-9" "2.5"))
(chk "functions (degrees)" (mapcar #'ce '("sin(30)" "cos(60)" "atan(1)" "sqrt(2)" "r2d(pi)" "log(1000)" "ln(1)"))
     '("0.5" "0.5" "45" "1.41421356" "180" "3" "0"))
(chk "feet and inches" (mapcar #'ce '("5'6\"" "6\"*2" "2'")) '("66" "12" "24"))
(chk "points" (mapcar #'ce '("[1,2,3]+[4,5,6]" "2*[1,2]" "[2<90]" "[1,0,0]&[0,1,0]" "[3,4]*[3,4]"))
     '("5,7,9" "2,4,0" "0,2,0" "0,0,1" "25"))
(chk "geometry" (mapcar #'ce '("dist([0,0],[3,4])" "ang([0,0],[1,1])" "abs([3,4])" "xof([5,6,7])")) '("5" "45" "5" "5"))
(chk "rounding" (mapcar #'ce '("round(2.5)" "round(-2.5)" "trunc(-2.7)")) '("3" "-3" "-2"))
(chk "units" (ce "cvunit(1,\"inch\",\"mm\")") "25.4")
(chk "variables, shared with AutoLISP" (list (ce "x=7*6") (ce "x/2") (alisp-eval-string "x")) '("42" "21" 42d0))
(chk "mistakes are explained" (mapcar #'ce '("1/0" "sqrt(-1)" "2+" "foo"))
     '("! Division by zero." "! SQRT needs a number not below 0." "! The expression is unfinished." "! foo isn't a known variable or function."))
(alisp-eval-string "(command \"line\" '(0 0) \"'cal\" \"[3,4]*2\" \"\")")
(chk "'CAL at a point prompt" (dxf 11 (ename-data (car (last (live-entities))))) '(6d0 8d0 0d0))
(alisp-eval-string "(command \"circle\" '(0 0) \"'cal\" \"dist([0,0],[3,4])\")")
(chk "'CAL at a distance prompt" (dxf 40 (ename-data (car (last (live-entities))))) 5d0)
(format t "~%Calculator tests: ~D passed, ~D failed.~%" *pass* *fail*)
