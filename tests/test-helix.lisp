;; HELIX: making, changing, sweeping and saving helixes.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-helix.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun r3 (x) (/ (round (* 1000 x)) 1000))
(defun rp (p) (mapcar #'r3 (list (px p) (py p) (pz p))))
(defun fr (e k) (nth k (multiple-value-list (helix-frame (ename-data e)))))
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))

;; HELIX: base centre, base radius, top radius, height (3 turns, CCW by default)
(al "(command \"helix\" '(0 0 0) 2 2 6)")
(let ((e (newest)))
  (chk "a helix" (ent-type e) "HELIX")
  (chk "base radius" (r3 (fr e 5)) 2)
  (chk "top radius" (r3 (fr e 6)) 2)
  (chk "height" (r3 (fr e 2)) 6)
  (chk "3 turns" (r3 (fr e 7)) 3)
  (chk "counterclockwise" (fr e 8) t)
  (chk "starts on the X axis" (rp (helix-point-at (ename-data e) 0)) '(2 0 0))
  (chk "a quarter turn on: counterclockwise" (rp (helix-point-at (ename-data e) (/ 1 12d0))) '(0 2 1/2))
  (chk "ends at the top" (rp (helix-point-at (ename-data e) 1)) '(2 0 6))
  (chk "length" (< (abs (- (helix-length (ename-data e)) (sqrt (+ (expt (* 3 2 pi 2) 2) 36)))) 0.02) t)
  (chk "LIST" (and (search "turns: 3" (describe-entity e)) t) t))

;; a cone-shaped spring, clockwise, 5 turns, picked start direction
(al "(command \"helix\" '(10 0 0) '(10 3 0) 1 \"t\" 5 \"w\" \"cw\" \"\")")
(let ((e (newest)))
  (chk "turns option" (r3 (fr e 7)) 5)
  (chk "clockwise" (fr e 8) nil)
  (chk "base radius from the picked point" (r3 (fr e 5)) 3)
  (chk "top radius" (r3 (fr e 6)) 1)
  (chk "starts where picked" (rp (helix-point-at (ename-data e) 0)) '(10 3 0))
  (chk "clockwise: a quarter turn goes toward +X" (> (px (helix-point-at (ename-data e) (/ 1 20d0))) 10) t)
  (chk "default height" (r3 (fr e 2)) 6))
(setf *helix-ccw* t *helix-turns* 3d0)

;; turn height: then the height gives the turns
(al "(command \"helix\" '(0 20 0) 1 1 \"h\" 0.5 4)")
(chk "turn height and height" (list (r3 (fr (newest) 7)) (r3 (fr (newest) 2))) '(8 4))
(setf *helix-turns* 3d0)
;; flat spiral
(al "(command \"helix\" '(0 40 0) 1 5 0)")
(chk "spiral: no height" (r3 (fr (newest) 2)) 0)
(chk "spiral ends at the top radius" (r3 (dist (pt 0 40 0) (helix-point-at (ename-data (newest)) 1))) 5)
;; along an axis endpoint
(al "(command \"helix\" '(30 0 0) 1 1 \"a\" '(30 0 -4))")
(chk "axis endpoint: height" (r3 (fr (newest) 2)) 4)
(chk "axis endpoint: direction" (rp (fr (newest) 1)) '(0 0 -1))
(chk "axis endpoint: ends there" (rp (v- (helix-point-at (ename-data (newest)) 1) (pt 30 0 -4))) (rp (v- (helix-point-at (ename-data (newest)) 0) (pt 30 0 0))))

;; changing it: move, scale, mirror, rotate in 3D, Properties, grips, undo
(let ((e (find-if (lambda (e) (equal (ent-type e) "HELIX")) (live-entities))))
  (al (format nil "(command \"move\" (handent ~S) \"\" '(0 0) '(1 1))" (ename-handle e)))
  (chk "moved" (rp (fr e 0)) '(1 1 0))
  (al (format nil "(command \"scale\" (handent ~S) \"\" '(1 1) 2)" (ename-handle e)))
  (chk "scaled: radius" (r3 (fr e 5)) 4)
  (chk "scaled: height" (r3 (fr e 2)) 12)
  (chk "scaled: turns stay" (r3 (fr e 7)) 3)
  (al "(command \"u\")")
  (al (format nil "(command \"mirror\" (handent ~S) \"\" '(1 1) '(1 5) \"n\")" (ename-handle e)))
  (chk "a mirror image turns the other way" (fr (newest) 8) nil)
  (al "(command \"u\")")
  (let ((r (xform-any (ename-data e) (make-xf :fn (lambda (p) (pt (px p) (- (pz p)) (py p)))))))
    (chk "turned in 3D: axis" (rp (nth-value 1 (helix-frame r))) '(0 -1 0))
    (chk "turned in 3D: same shape" (r3 (nth-value 2 (helix-frame r))) (r3 (fr e 2))))
  (setf *pickfirst* (list e))
  (apply-palette-edit "HXN 7")
  (chk "Properties: turns" (r3 (fr e 7)) 7)
  (apply-palette-edit "HXTR 0.5")
  (chk "Properties: top radius" (r3 (fr e 6)) 1/2)
  (apply-palette-edit "HXTW CW")
  (chk "Properties: twist" (fr e 8) nil)
  (apply-palette-edit "HXTH 1")
  (chk "Properties: turn height sets turns" (r3 (fr e 7)) 6)
  (setf *pickfirst* nil)
  (let* ((d (ename-data e)) (g (helix-grips d)))
    (chk "four grips" (length g) 4)
    (chk "top grip sets height" (r3 (nth-value 2 (helix-frame (grip-stretch d :htop (car (third g)) (pt 1 1 9))))) 9)
    (chk "start grip sets base radius" (r3 (nth-value 5 (helix-frame (grip-stretch d :hstart (car (second g)) (pt 4 1 0))))) 3)))

;; sweeping a circle along it makes a spring
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"helix\" '(0 0 0) 3 3 6)")
(setf (sysvar "DELOBJ") 1)
(al "(command \"circle\" '(3 0 0) 0.25)")
(let ((hx (find "HELIX" (live-entities) :key #'ent-type :test #'equal))
      (ci (find "CIRCLE" (live-entities) :key #'ent-type :test #'equal)))
  (when (and hx ci) (sweep-shapes (list ci) hx)))
(let ((s (find "POLYFACE" (live-entities) :key #'ent-type :test #'equal)))
  (chk "SWEEP along a helix makes a solid" (and s t) t)
  (when s
    (let ((v (mesh-volume (ename-data s))))
      (chk "spring volume (tube area x length)" (< (abs (- v (* pi 0.25 0.25 (sqrt (+ (expt (* 3 2 pi 3) 2) 36))))) (* 0.03 v)) t))))

;; saving: DXF 2000 HELIX; reading it back; R12 as lines
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"helix\" '(1 2 3) 2 1 5)")
(let ((before (ename-data (newest))))
  (dxf-export-2000 "/tmp/fp-helix.dxf")
  (chk "HELIX written" (and (search "AcDbHelix" (file-text "/tmp/fp-helix.dxf")) t) t)
  (dxf-import "/tmp/fp-helix.dxf")
  (let ((e (find "HELIX" (live-entities) :key #'ent-type :test #'equal)))
    (chk "read back" (and e t) t)
    (when e
      (chk "same shape" (mapcar (lambda (k) (let ((x (nth k (multiple-value-list (helix-frame (ename-data e)))))) (if (realp x) (r3 x) (if (consp x) (rp x) x))))
                                '(0 1 2 5 6 7 8))
           (mapcar (lambda (k) (let ((x (nth k (multiple-value-list (helix-frame before))))) (if (realp x) (r3 x) (if (consp x) (rp x) x))))
                   '(0 1 2 5 6 7 8))))))
(dxf-export "/tmp/fp-helix12.dxf")
(chk "R12: lines" (> (count-if (lambda (e) (equal (ent-type e) "LINE")) (progn (dxf-import "/tmp/fp-helix12.dxf") (live-entities))) 50) t)

(format t "~%Helix tests: ~D passed, ~D failed.~%" *pass* *fail*)
