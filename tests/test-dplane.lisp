;; Drafting plane apart from the view: in an isometric view, draw on Front / Right / any plane.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-dplane.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun near (a b) (< (dist (pt3 a) (pt3 b)) 1d-6))
(defun newest () (let ((*ucs-off* t)) (ent-data (car (last (live-entities))))))
(setf *cw* 800 *ch* 600 *tx* 0 *ty* 0 *vscale* 20d0 *vx* 0d0 *vy* 0d0)
(setf *view* (make-view "SW Isometric"))
(chk "iso view, no drafting plane: the ground" (ucs) nil)
(al "(command \"draftplane\" \"front\" \"\")")
(chk "Front drafting plane set, view unchanged" (list (first *view*) (and (ucs) t) *drafting-plane-name*) '("SW Isometric" t "Front"))
(chk "still a 3D (projected) view" (and (projected-view-p) t) t)
(al "(command \"circle\" '(5 3) 2)")
(let ((d (newest)))
  (chk "a circle drawn on the Front plane: centre at X 5, height 3" (near (ocs->w (pt3 (dxf 10 d)) (first (multiple-value-list (ocs-axes (entity-normal d)))) (second (multiple-value-list (ocs-axes (entity-normal d)))) (third (multiple-value-list (ocs-axes (entity-normal d))))) (pt 5 0 3)) t)
  (chk "it faces front (normal along -Y)" (near (entity-normal d) (pt 0 -1 0)) t))
(al "(command \"line\" '(0 0) '(4 6) \"\")")
(let ((d (newest)))
  (chk "a line on the Front plane: it rises in Z, not in Y" (list (near (dxf 10 d) (pt 0 0 0)) (near (dxf 11 d) (pt 4 0 6))) '(t t)))
;; the cursor lands on the plane: a point picked on screen is at local Z 0
(multiple-value-bind (sx sy) (w->s (pt 2 5 0))
  (let ((p (view-work-point sx sy (pt 0 0 0))))
    (chk "a picked point lies on the drafting plane" (< (abs (pz p)) 1d-9) t)
    (chk "and shows where the mouse is" (multiple-value-bind (x y) (w->s p) (list (round x) (round y))) (list (round sx) (round sy)))))
(chk "the screen is unchanged by the plane (a world point shows at the same place)"
     (let ((a (multiple-value-list (let ((*ucs-off* t)) (w->s (pt 5 0 3)))))
           (b (multiple-value-list (w->s (pt 5 3 0)))))
       (and (< (abs (- (first a) (first b))) 1d-6) (< (abs (- (second a) (second b))) 1d-6)))
     t)
;; ortho follows the plane's axes
(chk "ortho on the Front plane: straight up" (near (view-ortho (pt 0.3 4 0) (pt 0 0 0)) (pt 0 4 0)) t)
;; Right plane through a point
(al "(command \"draftplane\" \"right\" '(10 0 0))")
(al "(command \"rectang\" '(0 0) '(3 2))")
(let* ((d (newest)) (n (entity-normal d)))
  (chk "a rectangle on the Right plane through X 10: faces +X" (near n (pt 1 0 0)) t)
  (chk "its corner is at X 10" (multiple-value-bind (ax ay az) (ocs-axes n)
                                 (< (abs (- (px (ocs->w (pt (px (first (first (lwpoly-vertices d)))) (py (first (first (lwpoly-vertices d)))) (d (or (dxf 38 d) 0))) ax ay az)) 10)) 1d-6)) t))
;; F6 cycling and back to ground
(setf *drafting-plane* nil *drafting-plane-name* nil)
(cycle-drafting-plane)
(chk "F6: Front" *drafting-plane-name* "Front")
(cycle-drafting-plane)
(chk "F6: Right" *drafting-plane-name* "Right")
(cycle-drafting-plane)
(chk "F6: back to the ground" (list *drafting-plane-name* *drafting-plane*) '(nil nil))
;; straight-on views keep their own plane
(al "(command \"draftplane\" \"front\" \"\")")
(set-view "Top")
(chk "Top view: draws on XY whatever the drafting plane" (ucs) nil)
(setf *view* (make-view "Right"))
(chk "Right view: its own plane" (near (third (ucs)) (pt 1 0 0)) t)
(setf *view* nil *drafting-plane* nil *drafting-plane-name* nil)
(format t "~%Drafting plane tests: ~D passed, ~D failed.~%" *pass* *fail*)
