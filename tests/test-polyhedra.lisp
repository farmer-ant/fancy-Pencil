;; Platonic solids and the truncated icosahedron.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-polyhedra.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun close-to (a b) (< (abs (- a b)) (* 1d-6 (max 1 (abs b)))))
(defun face-sizes (m) (sort (mapcar #'length (mesh-faces m)) #'<))
(defun counts (m) (list (length (mesh-verts m)) (length (mesh-faces m))))
(let ((s5 (sqrt 5d0)) (s2 (sqrt 2d0)))
  (loop for (kind vf vol) in (list (list :tetrahedron '(4 4) (/ 8 (* 6 s2)))
                                   (list :cube '(8 6) 8d0)
                                   (list :octahedron '(6 8) (* (/ s2 3) 8))
                                   (list :dodecahedron '(20 12) (* (/ (+ 15 (* 7 s5)) 4) 8))
                                   (list :icosahedron '(12 20) (* (/ (* 5 (+ 3 s5)) 12) 8))
                                   (list :soccer '(60 32) (* (/ (+ 125 (* 43 s5)) 4) 8)))
        do (let ((m (polyhedron-mesh kind (pt 0 0 0) :edge 2d0)))
             (chk (format nil "~A: corners and faces" kind) (counts m) vf)
             (chk (format nil "~A: volume for edge 2" kind) (close-to (mesh-volume m) vol) t)
             (chk (format nil "~A: every edge 2 long" kind)
                  (let ((vs (coerce (mesh-verts m) 'vector)))
                    (every (lambda (f) (loop for (a b) on (append f (list (first f))) while b
                                             always (close-to (dist (aref vs (1- a)) (aref vs (1- b))) 2d0)))
                           (mesh-faces m)))
                  t))))
(chk "soccer ball: 12 pentagons and 20 hexagons" (let ((s (face-sizes (polyhedron-mesh :soccer (pt 0 0 0) :edge 1d0)))) (list (count 5 s) (count 6 s))) '(12 20))
(let ((m (polyhedron-mesh :icosahedron (pt 10 20 0) :edge 3d0)))
  (chk "standing on a face: nothing below the working plane, a face on it"
       (let ((zs (mapcar #'pz (mesh-verts m)))) (list (close-to (reduce #'min zs) 0d0) (count-if (lambda (z) (< (abs z) 1d-9)) zs))) '(t 3))
  (chk "that face centred on the point" (let ((low (remove-if-not (lambda (p) (< (abs (pz p)) 1d-9)) (mesh-verts m))))
                                          (< (dist (v* (reduce #'v+ low) (/ 1d0 (length low))) (pt 10 20 0)) 1d-9)) t))
(chk "radius: corners at that distance from the centre"
     (let ((m (polyhedron-mesh :dodecahedron (pt 0 0 0) :radius 5d0 :stand nil)))
       (every (lambda (p) (close-to (dist p (pt 0 0 0)) 5d0)) (mesh-verts m))) t)
(al "(command \"soccerball\" '(0 0 0) 2)")
(chk "SOCCERBALL command: a closed solid" (let ((d (ename-data (car (last (live-entities)))))) (list (dxf 0 d) (length (mesh-faces d)))) '("POLYFACE" 32))
(al "(command \"polyhedron\" \"d\" \"c\" '(50 0 0) \"r\" 4)")
(chk "POLYHEDRON Dodecahedron, Center, Radius" (let ((d (ename-data (car (last (live-entities)))))) (counts d)) '(20 12))
(format t "~%Polyhedra tests: ~D passed, ~D failed.~%" *pass* *fail*)
