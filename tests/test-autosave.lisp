;; Safety copies: made, cleaned up when Fancy Pencil closes normally (even after Save As), and a
;; leftover copy offered only once.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-autosave.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
;; a private autosave folder for the test
(defparameter *home* (format nil "/tmp/fp-autosave-test-~D/" (my-pid)))
(require :sb-posix)
(funcall (intern "SETENV" "SB-POSIX") "HOME" (string-right-trim "/" *home*) 1)
(ensure-directories-exist (autosave-dir))
(defun mine () (directory (concatenate 'string (autosave-dir) "*.*")))
(al "(command \"line\" '(0 0) '(5 5) \"\")")
(write-safety-copy (current-doc))
(chk "a safety copy and its note are made" (length (mine)) 2)
;; the drawing is renamed (Save As) after the copy was made
(setf (drawing-filename *dwg*) "/tmp/renamed-drawing.dxf")
(autosave-forget-all)
(chk "closing normally deletes it, even after a rename" (length (mine)) 0)
;; a copy left by a Fancy Pencil that stopped (a process that is not running)
(with-open-file (o (concatenate 'string (autosave-dir) "Old-99999999-1.dxf") :direction :output :if-exists :supersede) (write-line "0" o) (write-line "EOF" o))
(with-open-file (o (concatenate 'string (autosave-dir) "Old-99999999-1.info") :direction :output :if-exists :supersede)
  (prin1 (list :name "Old.dxf" :time (get-universal-time) :pid 99999999) o))
(chk "a leftover copy is found" (length (leftover-safety-copies)) 1)
(mark-offered (first (leftover-safety-copies)))
(chk "once offered it is marked, and still there for File > Recover" (list (length (leftover-safety-copies)) (getf (cdr (first (leftover-safety-copies))) :offered)) '(1 t))
(chk "it is not offered again at startup" (remove-if (lambda (c) (getf (cdr c) :offered)) (leftover-safety-copies)) nil)
(format t "~%Autosave tests: ~D passed, ~D failed.~%" *pass* *fail*)
