;; SPLINE: fit splines pass through their points; CV splines; Object; fit-point grips; saving.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-spline.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun splines () (remove-if-not (lambda (e) (equal (ent-type e) "SPLINE")) (live-entities)))
(defun newest () (ename-data (car (last (splines)))))
(defun curve (data) (spline-curve-points data 3000))
(defun spline-curve-points (data n)
  "Points along DATA's curve from its control points and knots (closely spaced)."
  (let* ((p (dxf 71 data)) (kv (coerce (loop for x in data when (and (consp x) (eql (car x) 40)) collect (cdr x)) 'vector))
         (cv (coerce (loop for x in data when (and (consp x) (eql (car x) 10)) collect (pt3 (cdr x))) 'vector))
         (u0 (aref kv p)) (u1 (aref kv (length cv))))
    (loop for i from 0 to n collect (de-boor p kv cv (if (= i n) (- u1 1d-12) (+ u0 (* (- u1 u0) (/ i n))))))))
(defun misses (data pts)
  "How far the curve passes from the farthest of PTS."
  (let ((c (curve data)))
    (reduce #'max (mapcar (lambda (q) (reduce #'min (mapcar (lambda (s) (dist s q)) c))) pts))))
(defun ok-fit (data pts) (< (misses data pts) 0.02))

(defparameter *pts* '((0 0) (2 3) (5 1) (7 4) (10 0)))
(defun ptl (l) (format nil "~{'~S~^ ~}" l))

;; Fit (the default)
(al (format nil "(command \"spline\" ~A \"\")" (ptl *pts*)))
(let ((d (newest)))
  (chk "SPLINE makes a cubic spline" (list (length (splines)) (dxf 71 d)) '(1 3))
  (chk "its fit points are kept" (length (spline-fit-points d)) 5)
  (chk "control points: as many as fit points" (count 10 d :key (lambda (x) (and (consp x) (car x)))) 5)
  (chk "knots: controls + degree + 1" (count 40 d :key (lambda (x) (and (consp x) (car x)))) 9)
  (chk "it passes through every point it was given" (ok-fit d (mapcar #'pt3 *pts*)) t)
  (chk "starts and ends on them exactly" (let ((c (curve d))) (list (< (dist (first c) (pt 0 0)) 1d-6) (< (dist (car (last c)) (pt 10 0)) 1d-6))) '(t t)))
;; the knot choices all still pass through the points
(dolist (k '("Square" "Uniform" "Chord"))
  (al (format nil "(command \"spline\" \"k\" ~S ~A \"\")" k (ptl *pts*)))
  (chk (format nil "Knots ~A: through every point" k) (ok-fit (newest) (mapcar #'pt3 *pts*)) t))
;; two and three points
(al "(command \"spline\" '(0 10) '(4 12) \"\")")
(chk "two points: a straight spline" (list (dxf 71 (newest)) (ok-fit (newest) (list (pt 0 10) (pt 4 12)))) '(1 t))
(al "(command \"spline\" '(0 20) '(4 24) '(8 20) \"\")")
(chk "three points: through them" (ok-fit (newest) (list (pt 0 20) (pt 4 24) (pt 8 20))) t)
;; start and end tangents
(al "(command \"spline\" '(0 30) \"t\" '(0 31) '(5 33) '(10 30) \"t\" '(10 29))")
(let* ((d (newest)) (c (curve d)))
  (chk "with tangents: still through the points" (ok-fit d (list (pt 0 30) (pt 5 33) (pt 10 30))) t)
  (chk "leaves the start going up (its tangent)" (let ((v (v- (nth 2 c) (first c)))) (> (py v) (* 3 (abs (px v))))) t)
  (chk "arrives at the end going down" (let ((v (v- (car (last c)) (nth (- (length c) 3) c)))) (< (py v) (- (* 3 (abs (px v)))))) t)
  (chk "tangents kept (12, 13)" (and (dxf 12 d) (dxf 13 d) t) t))
;; closed
(al "(command \"spline\" '(20 0) '(24 0) '(24 4) '(20 4) \"c\")")
(let* ((d (newest)) (c (curve d)))
  (chk "Close: a closed spline" (logtest 1 (dxf 70 d)) t)
  (chk "closed: through its points, back to the start" (list (ok-fit d (list (pt 20 0) (pt 24 0) (pt 24 4) (pt 20 4))) (< (dist (first c) (car (last c))) 1d-6)) '(t t)))
;; CV method
(al "(command \"spline\" \"m\" \"cv\" '(30 0) '(32 4) '(36 4) '(38 0) \"\")")
(let ((d (newest)))
  (chk "CV: the points are control vertices" (list (count 10 d :key (lambda (x) (and (consp x) (car x)))) (spline-fit-points d)) '(4 nil))
  (chk "CV: starts and ends at the end vertices" (let ((c (curve d))) (list (< (dist (first c) (pt 30 0)) 1d-6) (< (dist (car (last c)) (pt 38 0)) 1d-6))) '(t t))
  (chk "CV: lies inside its control polygon (below y 4)" (every (lambda (q) (<= (py q) 4)) (curve d)) t))
(al "(command \"spline\" \"d\" 2 '(40 0) '(42 4) '(44 0) '(46 4) \"\")")
(chk "Degree 2" (dxf 71 (newest)) 2)
(al "(command \"spline\" \"m\" \"fit\" '(0 50) '(1 51) \"\")")
;; Undo inside the command
(al "(command \"spline\" '(0 60) '(3 63) '(6 60) \"u\" '(6 64) \"\")")
(chk "Undo takes back the last point" (mapcar (lambda (p) (round (py p))) (spline-fit-points (newest))) '(60 63 64))
;; Object: a polyline turned into a spline through its vertices
(al "(command \"pline\" '(0 70) '(3 73) '(6 70) '(9 73) \"\")")
(let ((n (length (splines))))
  (al "(command \"spline\" \"o\" (entlast) \"\")")
  (chk "Object: the polyline becomes a spline" (list (- (length (splines)) n) (ent-type (car (last (live-entities))))) '(1 "SPLINE"))
  (chk "through its vertices" (ok-fit (newest) (list (pt 0 70) (pt 3 73) (pt 6 70) (pt 9 73))) t))
;; grips: moving a fit point fits the curve again through it
(let* ((e (first (splines))) (d (ename-data e)))
  (let ((nd (grip-stretch d (list :fit 2) (pt 5 1) (pt 5 6))))
    (chk "fit-point grips" (length (entity-grips d)) 5)
    (chk "a moved fit point: the curve goes through it" (ok-fit nd (list (pt 0 0) (pt 2 3) (pt 5 6) (pt 7 4) (pt 10 0))) t)))
;; moving and saving
(al "(command \"move\" (ssname (ssget \"x\") 0) \"\" '(0 0) '(100 0))")
(chk "moved: through the moved points" (ok-fit (ename-data (first (splines))) (mapcar (lambda (p) (v+ (pt3 p) (pt 100 0))) *pts*)) t)
(let ((n (length (splines))))
  (dxf-export-2000 "/tmp/fp-spline.dxf")
  (%dxf-import "/tmp/fp-spline.dxf")
  (chk "saved and read back" (length (splines)) n)
  (chk "still through its points" (ok-fit (ename-data (first (splines))) (mapcar (lambda (p) (v+ (pt3 p) (pt 100 0))) *pts*)) t))
;; OFFSET: a spline (and an ellipse) offset as a spline at that distance
(defun near-range (src off skip)
  (let* ((a (curve-samples src 800)) (b (curve-samples off 400)) (b (subseq b skip (- (length b) skip)))
         (ds (mapcar (lambda (q) (reduce #'min (mapcar (lambda (s) (dist2d s q)) a))) b)))
    (list (reduce #'min ds) (reduce #'max ds))))
(al "(command \"spline\" '(200 0) '(204 2) '(208 0) '(212 2) \"\")")
(let ((src (newest)))
  (al "(command \"offset\" 0.5 (entlast) '(206 10) \"\")")
  (let ((r (near-range src (newest) 20)))
    (chk "OFFSET a spline: a spline 0.5 away" (list (dxf 0 (newest)) (< (abs (- (first r) 0.5)) 0.02) (< (abs (- (second r) 0.5)) 0.02)) '("SPLINE" t t))))
(al "(command \"ellipse\" '(200 -20) '(206 -20) 3)")
(let ((src (ename-data (car (last (live-entities))))))
  (al "(command \"offset\" 1 (entlast) '(200 -10) \"\")")
  (let ((r (near-range src (ename-data (car (last (live-entities)))) 0)))
    (chk "OFFSET an ellipse: a closed spline 1 away" (list (logtest 1 (dxf 70 (ename-data (car (last (live-entities)))))) (< (abs (- (first r) 1)) 0.02) (< (abs (- (second r) 1)) 0.02)) '(t t t))))
(format t "~%Spline tests: ~D passed, ~D failed.~%" *pass* *fail*)
