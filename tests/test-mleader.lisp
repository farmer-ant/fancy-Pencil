;; Multileaders (MULTILEADER): made with MLEADER, drawn, moved, saved and read back.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-mleader.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun r3 (x) (/ (round (* 1000 x)) 1000))
(defun rp (p) (mapcar #'r3 (list (px p) (py p))))
(defun mls () (remove-if-not (lambda (e) (equal (ent-type e) "MULTILEADER")) (live-entities)))
(defun subs-of (type data) (remove-if-not (lambda (s) (equal (dxf 0 s) type)) (mleader-display-entities data)))

;; MLEADER: arrow at 0,0, landing at 4,3, note "PUMP"
(al "(command \"mleader\" '(0 0) '(4 3) \"PUMP\" \"\")")
(chk "MLEADER makes one multileader" (length (mls)) 1)
(let ((d (ename-data (first (mls)))))
  (chk "its note" (ml d :text) "PUMP")
  (chk "one leader, one line" (list (length (ml d :leaders)) (length (getf (first (ml d :leaders)) :lines))) '(1 1))
  (chk "the line starts at the arrow tip" (rp (pt3 (cdr (assoc 10 (first (subs-of "LWPOLYLINE" d))))))
       (rp (pt 0 0)))
  (chk "pieces: line, arrow, landing, note" (mapcar (lambda (s) (dxf 0 s)) (mleader-display-entities d))
       '("LWPOLYLINE" "SOLID" "LINE" "MTEXT"))
  (chk "landing runs right from 4,3" (let ((l (first (subs-of "LINE" d)))) (list (rp (dxf 10 l)) (rp (dxf 11 l))))
       (list '(4 3) (list (r3 (+ 4 0.36)) 3)))
  (chk "note to the right, top-left attached" (let ((m (first (subs-of "MTEXT" d)))) (list (dxf 71 m) (> (px (dxf 10 m)) 4.36)))
       '(1 t))
  (chk "its box covers arrow and note" (let ((b (entity-bbox (first (mls))))) (and (<= (first b) 0) (> (third b) 4.4) t)) t))

;; leftward: the note goes on the left, top-right attached
(al "(command \"mleader\" '(10 0) '(7 2) \"LEFT\" \"\")")
(let ((d (ename-data (second (mls)))))
  (chk "leftward note: top-right attached" (dxf 71 (first (subs-of "MTEXT" d))) 3)
  (chk "landing runs left" (< (px (dxf 11 (first (subs-of "LINE" d)))) 7) t))

;; MOVE, ROTATE, SCALE, MIRROR
(al "(command \"move\" (ssname (ssget \"x\") 0) \"\" '(0 0) '(1 1))")
(let ((d (ename-data (first (mls)))))
  (chk "moved: arrow tip" (rp (first (first (getf (first (ml d :leaders)) :lines)))) '(1 1))
  (chk "moved: landing" (rp (getf (first (ml d :leaders)) :conn)) '(5 4)))
(al "(command \"scale\" (ssname (ssget \"x\") 0) \"\" '(1 1) 2)")
(let ((d (ename-data (first (mls)))))
  (chk "scaled: landing" (rp (getf (first (ml d :leaders)) :conn)) '(9 7))
  (chk "scaled: text height" (r3 (ml d :th)) (r3 (* 2 0.18)))
  (chk "scaled: arrow" (r3 (ml d :asz)) (r3 (* 2 0.18))))
(al "(command \"rotate\" (ssname (ssget \"x\") 0) \"\" '(1 1) 90)")
(let ((d (ename-data (first (mls)))))
  (chk "rotated: landing" (rp (getf (first (ml d :leaders)) :conn)) '(-5 9))
  (chk "rotated: note turned" (r3 (ml d :trot)) (r3 (/ pi 2))))
(al "(command \"undo\" 3)")
(let ((d (ename-data (first (mls)))))
  (chk "undone" (rp (getf (first (ml d :leaders)) :conn)) '(4 3)))

;; EXPLODE gives its pieces
(al "(command \"copy\" (ssname (ssget \"x\") 0) \"\" '(0 0) '(0 20) \"\")")
(let ((n (length (live-entities))))
  (al "(command \"explode\" (entlast) \"\")")
  (chk "exploded into 4 pieces" (- (length (live-entities)) n) 3)
  (chk "the note survives as MTEXT" (and (find "MTEXT" (live-entities) :key #'ent-type :test #'equal) t) t))
(al "(command \"erase\" (ssget \"x\" '((0 . \"LWPOLYLINE,SOLID,LINE,MTEXT\"))) \"\")")
(chk "two multileaders left" (length (mls)) 2)

;; saved and read back (DXF 2000)
(dxf-export-2000 "/tmp/fp-ml.dxf")
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))
(let ((tx (file-text "/tmp/fp-ml.dxf")))
  (chk "file has MULTILEADER entities" (count-if (lambda (i) (search (format nil "~%MULTILEADER~%") tx :start2 i :end2 (+ i 14))) (list 0)) 0)
  (chk "written twice" (loop with i = 0 with n = 0 for p = (search (format nil "  0~%MULTILEADER") tx :start2 i) while p do (incf n) (setf i (1+ p)) finally (return n)) 2)
  (chk "class and style object" (and (search "ACDB_MLEADER_CLASS" tx) (search "ACAD_MLEADERSTYLE" tx) (search "MLEADERSTYLE" tx) t) t))
(let ((before (mapcar (lambda (e) (ename-data e)) (mls))))
  (%dxf-import "/tmp/fp-ml.dxf")
  (chk "read back: two" (length (mls)) 2)
  (chk "nothing skipped" *import-skipped* nil)
  (let ((a (first before)) (b (ename-data (first (mls)))))
    (chk "same note" (ml b :text) (ml a :text))
    (chk "same landing" (rp (getf (first (ml b :leaders)) :conn)) (rp (getf (first (ml a :leaders)) :conn)))
    (chk "same arrow tip" (rp (first (first (getf (first (ml b :leaders)) :lines)))) (rp (first (first (getf (first (ml a :leaders)) :lines)))))
    (chk "same note position" (rp (ml b :tpos)) (rp (ml a :tpos)))
    (chk "same attachment" (ml b :attach) (ml a :attach))
    (chk "same sizes" (mapcar #'r3 (list (ml b :th) (ml b :asz))) (mapcar #'r3 (list (ml a :th) (ml a :asz))))
    (chk "same style" (ml b :tstyle) (ml a :tstyle))))

;; R12 DXF: no multileaders there, so its pieces
(dxf-export "/tmp/fp-ml12.dxf")
(let ((tx (file-text "/tmp/fp-ml12.dxf")))
  (chk "R12: no MULTILEADER" (search "MULTILEADER" tx) nil)
  (chk "R12: its note as text" (and (search "PUMP" tx) t) t))

;; colours: ByBlock, ByLayer and index colours read from AutoCAD's colour values
(chk "colours" (mapcar #'ml-color (list -1056964608 -1073741824 (- #xC3000005 #x100000000) (- #xC2FF0000 #x100000000)))
     '(0 nil 5 1))
(chk "colour values round trip" (mapcar (lambda (c) (ml-color (ml-color-value c))) '(0 nil 3 200)) '(0 nil 3 200))

(format t "~%Multileader tests: ~D passed, ~D failed.~%" *pass* *fail*)
