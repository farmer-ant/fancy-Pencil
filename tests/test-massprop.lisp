;; MASSPROP: regions (with holes) and solids.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-massprop.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defun r4 (x) (cond ((listp x) (mapcar #'r4 x)) ((realp x) (/ (round (* x 10000)) 10000.0d0)) (t x)))
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun rp (&rest ents) (region-properties (mapcar #'ent-data ents)))

(al "(command \"rectang\" '(0 0) '(5 5))") (defvar sq (newest))
(let ((r (rp sq)))
  (chk "square area" (r4 (getf r :area)) 25d0)
  (chk "square perimeter" (r4 (getf r :perimeter)) 20d0)
  (chk "square centroid" (r4 (list (px (getf r :centroid)) (py (getf r :centroid)))) '(2.5d0 2.5d0))
  (chk "square Ix (integral of y^2)" (r4 (getf r :ix)) 208.3333d0)
  (chk "square product XY" (r4 (getf r :ixy)) 156.25d0)
  (chk "square radius of gyration" (r4 (getf r :rx)) 2.8868d0)
  (chk "square principal moments" (r4 (mapcar #'first (getf r :principal))) '(52.0833d0 52.0833d0)))
(al "(command \"circle\" '(10 0) 2)") (defvar ci (newest))
(let ((r (rp ci)))
  (chk "circle area (exact)" (r4 (getf r :area)) (r4 (* pi 4)))
  (chk "circle circumference" (r4 (getf r :perimeter)) (r4 (* 4 pi)))
  (chk "circle Ix about origin = pi r^4/4" (r4 (getf r :ix)) (r4 (* pi 4)))
  (chk "circle Iy = pi r^4/4 + A*100" (r4 (getf r :iy)) (r4 (+ (* pi 4) (* 400 pi)))))
;; a plate with a hole
(al "(command \"circle\" '(2.5 2.5) 1)") (defvar hole (newest))
(let ((r (rp sq hole)))
  (chk "plate with hole: area" (r4 (getf r :area)) (r4 (- 25 pi)))
  (chk "one hole found" (getf r :holes) 1)
  (chk "perimeter counts the hole" (r4 (getf r :perimeter)) (r4 (+ 20 (* 2 pi))))
  (chk "centroid stays" (r4 (px (getf r :centroid))) 2.5d0))
;; a polyline with an arc: a half disc (diameter 0,0 - 4,0 bulging up)
(al "(entmake '((0 . \"LWPOLYLINE\") (100 . \"AcDbEntity\") (100 . \"AcDbPolyline\") (90 . 2) (70 . 1) (10 4.0 0.0) (42 . 1.0) (10 0.0 0.0)))") (defvar hd (newest))
(let ((r (rp hd)))
  (chk "half disc area" (r4 (getf r :area)) (r4 (* pi 2)))
  (chk "half disc centroid y = 4r/3pi" (r4 (py (getf r :centroid))) (r4 (/ 8 (* 3 pi)))))
(chk "a line is not a region" (region-properties (list (ent-data (progn (al "(command \"line\" '(0 0) '(1 1) \"\")") (newest))))) nil)

;; solids
(al "(command \"box\" '(0 0 0) '(1 2 0) 3)") (defvar bx (newest))
(let ((s (solid-properties (list (ent-data bx)))))
  (chk "box volume" (r4 (getf s :volume)) 6d0)
  (chk "box mass (density 1)" (r4 (getf s :mass)) 6d0)
  (chk "box centroid" (r4 (list (px (getf s :centroid)) (py (getf s :centroid)) (pz (getf s :centroid)))) '(0.5d0 1d0 1.5d0))
  (chk "box Ix = integral of y^2+z^2" (r4 (getf s :ix)) 26d0)
  (chk "box product XY" (r4 (getf s :pxy)) 3d0)
  (chk "box principal moments m(b^2+c^2)/12" (r4 (mapcar #'first (getf s :principal))) '(2.5d0 5d0 6.5d0))
  (chk "box principal axis of the smallest is Z" (r4 (mapcar #'abs (let ((v (second (first (getf s :principal))))) (list (px v) (py v) (pz v))))) '(0d0 0d0 1d0)))
(al "(command \"box\" '(10 0 0) '(12 2 0) 1)")
(let ((s (solid-properties (list (ent-data (newest))))))
  (chk "square-based box: equal moments along X and Y" (r4 (mapcar (lambda (e) (let ((v (second e))) (list (abs (px v)) (abs (py v)) (abs (pz v))))) (getf s :principal)))
       '((1d0 0d0 0d0) (0d0 1d0 0d0) (0d0 0d0 1d0))))
(al "(command \"sphere\" '(0 0 10) 2)") (defvar sp (newest))
(let ((s (solid-properties (list (ent-data sp)))))
  (chk "sphere volume within 2% (a faceted mesh)" (< (abs (- (getf s :volume) (* 4/3 pi 8))) (* 0.02 (* 4/3 pi 8))) t))
(multiple-value-bind (text skipped) (massprop-report (list sq hole bx))
  (chk "report has both sections" (and (search "REGIONS" text) (search "SOLIDS" text) t) t)
  (chk "nothing left out" skipped 0))
(al "(command \"massprop\" (ssget \"x\") \"\" \"y\" \"/tmp/fp-massprop.mpr\")")
(chk "MASSPROP wrote the file" (and (probe-file "/tmp/fp-massprop.mpr") t) t)

(format t "~%Mass properties tests: ~D passed, ~D failed.~%" *pass* *fail*)
