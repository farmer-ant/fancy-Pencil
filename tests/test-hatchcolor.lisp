;; Hatch color: HATCH and HATCHEDIT at the command line (the dialogs set the same HPCOLOR).
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-hatchcolor.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases) (current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun hatch-color () (dxf 62 (ent-data (find "HATCH" (reverse (live-entities)) :key #'ent-type :test #'equal))))
(al "(command \"rectang\" '(0 0) '(10 10))")
(al "(command \"-hatch\" \"p\" \"c\" \"red\" \"ansi31\" 1 0 '(5 5) \"\")")
(chk "-HATCH Properties, Color red" (hatch-color) 1)
(chk "kept for the next hatch" (sysvar "HPCOLOR") 1)
(al "(command \"erase\" \"all\" \"\")") (al "(command \"rectang\" '(0 0) '(10 10))")
(al "(command \"-hatch\" \"p\" \"c\" \".\" \"\" \"\" \"\" '(5 5) \"\")")
(chk "\".\": the current color (ByLayer)" (hatch-color) nil)
(al "(command \"-hatchedit\" (entlast) \"c\" \"30\" \"\" \"\" \"\")")
(chk "HATCHEDIT: color 30" (hatch-color) 30)
(chk "HATCHEDIT leaves HPCOLOR as it was" (sysvar "HPCOLOR") ".")
(al "(command \"-hatchedit\" (entlast) \"c\" \"bylayer\" \"\" \"\" \"\")")
(chk "HATCHEDIT: back to ByLayer" (hatch-color) nil)
(al "(command \"hatchedit\" (entlast) \"ansi37\" 2 45)")
(chk "scripts without a color still work" (dxf 2 (ent-data (find "HATCH" (live-entities) :key #'ent-type :test #'equal))) "ANSI37")
(format t "~%~D passed, ~D failed~%" *pass* *fail*)
(sb-ext:exit :code (if (zerop *fail*) 0 1))
