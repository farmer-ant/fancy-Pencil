;; Revolved surfaces: REVSURF (mesh, SURFTAB1 x SURFTAB2) and REVOLVE's surface mode.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-surfaces.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun r3 (x) (/ (round (* 1000 x)) 1000))
(defun open-edges (d) (mesh-check (mapcar (lambda (f) (mapcar (lambda (i) (1- (abs i))) f)) (mesh-faces d))))

(al "(setq ax (progn (command \"line\" '(0 0) '(0 10) \"\") (entlast)))")
(al "(setq pa (progn (command \"line\" '(2 0) '(4 6) \"\") (entlast)))")
(chk "SURFTAB defaults" (list (sysvar "SURFTAB1") (sysvar "SURFTAB2")) '(6 6))
(al "(command \"revsurf\" pa ax \"\" \"\")")
(let ((d (ename-data (newest))))
  (chk "a mesh" (ent-type (newest)) "POLYFACE")
  (chk "revolved surface" (dxf :kind d) "Revolved surface")
  (chk "6 faces around a straight line" (length (mesh-faces d)) 6)
  (chk "every edge shows" (every (lambda (f) (every #'plusp f)) (mesh-faces d)) t)
  (chk "open surface: edges at its ends" (open-edges d) 12)
  (chk "radius kept" (r3 (reduce #'max (mesh-verts d) :key (lambda (p) (sqrt (+ (* (px p) (px p)) (* (pz p) (pz p))))))) 4))
;; an arc: SURFTAB2 steps along it; part of a turn
(al "(setq ar (progn (command \"arc\" \"c\" '(0 5) '(3 5) '(0 8)) (entlast)))")
(setf (sysvar "SURFTAB1") 12 (sysvar "SURFTAB2") 8)
(al "(command \"revsurf\" ar ax 0 180)")
(let ((d (ename-data (newest))))
  (chk "12 x 8 faces" (length (mesh-faces d)) 96)
  (chk "half a turn" (r3 (reduce #'min (mesh-verts d) :key #'pz)) -3))
;; REVOLVE, surface mode: a closed shape gives an open surface (no ends)
(al "(setq ci (progn (command \"circle\" '(5 3) 1) (entlast)))")
(al "(command \"revolve\" ci \"\" \"mo\" \"su\" '(0 0) '(0 10) 180)")
(let ((d (ename-data (newest))))
  (chk "REVOLVE surface: open (no ends)" (plusp (open-edges d)) t)
  (chk "REVOLVE surface: kind" (dxf :kind d) "Revolved surface"))
(al "(setq ci (progn (command \"circle\" '(5 3) 1) (entlast)))")
(al "(command \"revolve\" ci \"\" \"mo\" \"so\" '(0 0) '(0 10) 180)")
(chk "REVOLVE solid: closed" (open-edges (ename-data (newest))) 0)
(chk "LIST names it" (and (search "REVOLVED SURFACE" (describe-entity (find-if (lambda (e) (dxf :kind (ename-data e))) (live-entities)))) t) t)
(format t "~%Surface tests: ~D passed, ~D failed.~%" *pass* *fail*)
