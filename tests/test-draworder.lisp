;; Draw order and text case.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-draworder.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun order () (mapcar (lambda (e) (dxf 8 (ename-data e))) (live-entities)))
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))

(dolist (l '("A" "B" "C" "D"))
  (al (format nil "(command \"-layer\" \"m\" \"~A\" \"\")" l))
  (al "(command \"line\" '(0 0) '(1 1) \"\")"))
(al "(setvar \"CLAYER\" \"0\")")
(defun on (l) (find-if (lambda (e) (equal (dxf 8 (ename-data e)) l)) (live-entities)))
(chk "drawn in order" (order) '("A" "B" "C" "D"))
(reorder-entities (list (on "A")) :front)
(chk "bring to front" (order) '("B" "C" "D" "A"))
(reorder-entities (list (on "A")) :back)
(chk "send to back" (order) '("A" "B" "C" "D"))
(reorder-entities (list (on "A")) :above (list (on "C")))
(chk "above C" (order) '("B" "C" "A" "D"))
(reorder-entities (list (on "D")) :under (list (on "B")))
(chk "under B" (order) '("D" "B" "C" "A"))
(al "(command \"draworder\" (ssget \"x\" '((8 . \"B\"))) \"\" \"front\")")
(chk "DRAWORDER Front" (order) '("D" "C" "A" "B"))
(al "(command \"u\")")
(chk "U undoes it" (order) '("D" "B" "C" "A"))
(al "(command \"draworder\" (ssget \"x\" '((8 . \"D\"))) \"\" \"above\" (ssget \"x\" '((8 . \"C\"))) \"\")")
(chk "DRAWORDER Above" (order) '("B" "C" "D" "A"))
;; the order is saved and comes back
(dxf-export-2000 "/tmp/fp-order.dxf")
(chk "SORTENTSTABLE written" (and (search "SORTENTSTABLE" (file-text "/tmp/fp-order.dxf")) t) t)
(dxf-import "/tmp/fp-order.dxf")
(chk "order after opening" (order) '("B" "C" "D" "A"))
;; plots paint in draw order
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"-layer\" \"m\" \"RED\" \"c\" \"1\" \"\" \"\")")
(al "(command \"line\" '(0 0) '(1 0) \"\")")
(al "(command \"-layer\" \"m\" \"BLUE\" \"c\" \"5\" \"\" \"\")")
(al "(command \"line\" '(0 1) '(1 1) \"\")")
(chk "first object first in the plot" (third (first (collect-plot-prims -1 -1 2 2))) (plot-color 1))

;; text case
(chk "UPPER" (change-case "Hello world" :upper) "HELLO WORLD")
(chk "lower" (change-case "Hello World" :lower) "hello world")
(chk "Title" (change-case "the QUICK brown fox" :title) "The Quick Brown Fox")
(chk "Sentence" (change-case "HELLO THERE. HOW ARE YOU?" :sentence) "Hello there. How are you?")
(chk "tOGGLE" (change-case "Hello" :toggle) "hELLO")
(chk "%%c code kept" (change-case "%%c25 hole" :upper) "%%c25 HOLE")
(chk "MTEXT codes kept" (change-case "{\\fArial|b1;Big} text\\Pnext line" :upper t) "{\\fArial|b1;BIG} TEXT\\PNEXT LINE")
(chk "MTEXT new paragraph starts a sentence" (change-case "ONE\\PTWO" :sentence t) "One\\PTwo")
(al "(command \"text\" '(0 0) 0.2 0 \"mixed Case\" \"\")")
(al "(command \"tcase\" (entlast) \"\" \"upper\")")
(chk "TCASE on TEXT" (dxf 1 (ename-data (newest))) "MIXED CASE")
(al "(command \"tcase\" (entlast) \"\" \"title\")")
(chk "TCASE Title" (dxf 1 (ename-data (newest))) "Mixed Case")

(format t "~%Draw order tests: ~D passed, ~D failed.~%" *pass* *fail*)
