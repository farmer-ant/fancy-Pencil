;; DWF and DGN underlays: the files read (DWFx, classic DWF, DGN V7), attached, moved and scaled,
;; saved as DWFUNDERLAY / DGNUNDERLAY and read back.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-underlay.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun r2 (x) (/ (round (* 100 x)) 100))
(defun rp (p) (list (r2 (px p)) (r2 (py p))))
(defun unders () (remove-if-not (lambda (e) (equal (ent-type e) "UNDERLAY")) (live-entities)))
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))
(defparameter *dgn* (namestring (truename "tests/data/sample.dgn")))
(defparameter *dwfx* (namestring (truename "tests/data/sample.dwfx")))
(defparameter *dwf* (namestring (truename "tests/data/sample.dwf")))

;; reading the files
(let ((b (read-file-bytes *dwfx*)))
  (chk "zip: files listed" (length (zip-entries b)) 4)
  (chk "zip: inflated" (length (zip-read b "Documents/1/Pages/padding.txt")) 7700))
(chk "VAX reals" (mapcar (lambda (x) (r2 x)) (list (dgn-double (coerce #(0 0 0 0 0 0 0 0) '(vector (unsigned-byte 8))) 0)))
     '(0))
(multiple-value-bind (ents kind) (read-dgn *dgn*)
  (chk "DGN V7: six elements (the deleted one left out)" (list kind (length ents)) '(:v7 6))
  (chk "DGN: the line" (let ((l (first ents))) (list (rp (dxf 10 l)) (rp (dxf 11 l)))) '((0 0) (4 3)))
  (chk "DGN: red is AutoCAD red" (dxf 62 (first ents)) 1)
  (chk "DGN: the shape is closed" (logtest 1 (dxf 70 (third ents))) t)
  (chk "DGN: the arc's extent" (mapcar #'r2 (pieces-bbox (data-pieces (fourth ents)))) '(10 10 12 12))
  (chk "DGN: the ellipse's extent" (mapcar #'r2 (pieces-bbox (data-pieces (fifth ents)))) '(2 9 8 11))
  (chk "DGN: the text" (let ((tx (sixth ents))) (list (dxf 1 tx) (rp (dxf 10 tx)) (r2 (dxf 40 tx)))) '("PUMP" (1 1) 1/2)))
(let ((s (first (dwf-sheets *dwfx*))))
  (chk "DWFx: an 11 x 8.5 sheet" (list (third s) (fourth s)) '(11d0 8.5d0))
  (chk "DWFx: paths and text" (mapcar (lambda (e) (dxf 0 e)) (second s)) '("LWPOLYLINE" "LWPOLYLINE" "LWPOLYLINE" "TEXT" "LWPOLYLINE"))
  (chk "DWFx: a canvas's shift applied (inches, y up)" (rp (pt3 (cdr (assoc 10 (first (second s)))))) '(1 15/2))
  (chk "DWFx: the text" (dxf 1 (fourth (second s))) "VALVE & PUMP"))
(chk "classic DWF: the sheet's size, no drawing" (let ((s (first (dwf-sheets *dwf*)))) (list (second s) (r2 (third s)) (r2 (fourth s))))
     '(nil 827/50 1169/100))

;; attaching
(al (format nil "(command \"dgnattach\" ~S '(100 50) 2 0)" *dgn*))
(chk "DGNATTACH: one underlay" (length (unders)) 1)
(let ((d (ename-data (first (unders)))))
  (chk "it shows the file's drawing, and its frame" (length (underlay-display-entities d)) 7)
  (chk "its frame: the drawing's extent, x2, at 100,50" (mapcar #'rp (underlay-frame d)) '((100 50) (124 50) (124 74) (100 74)))
  (chk "the line, placed and scaled" (let ((l (find "LINE" (underlay-display-entities d) :key (lambda (e) (dxf 0 e)) :test #'equal)))
                                       (list (rp (dxf 10 l)) (rp (dxf 11 l))))
       '((100 50) (108 56)))
  (chk "picked by its frame" (eq (pick-entity-at (pt 100 60) 0.1) (first (unders))) t))
(al (format nil "(command \"dwfattach\" ~S '(0 0) 1 0)" *dwfx*))
(al (format nil "(command \"dwfattach\" ~S '(0 20) 1 0)" *dwf*))
(chk "three underlays" (length (unders)) 3)
(let ((d (ename-data (third (unders)))))
  (chk "a classic DWF: its frame and name" (mapcar (lambda (e) (dxf 0 e)) (underlay-display-entities d)) '("LWPOLYLINE" "TEXT")))

;; moving, scaling, rotating
(al "(command \"move\" (ssname (ssget \"x\") 0) \"\" '(100 50) '(110 50))")
(al "(command \"scale\" (ssname (ssget \"x\") 0) \"\" '(110 50) 0.5)")
(al "(command \"rotate\" (ssname (ssget \"x\") 0) \"\" '(110 50) 90)")
(let ((d (ename-data (first (unders)))))
  (chk "moved, scaled, rotated" (list (rp (dxf 10 d)) (r2 (dxf 41 d)) (r2 (deg (dxf 50 d)))) '((110 50) 1 90))
  (chk "its frame follows" (mapcar #'rp (underlay-frame d)) '((110 50) (110 62) (98 62) (98 50))))
(al "(command \"undo\" 3)")

;; saved (DXF 2000) and read back
(dxf-export-2000 "/tmp/fp-under.dxf")
(let ((tx (file-text "/tmp/fp-under.dxf")))
  (chk "written as DGNUNDERLAY and DWFUNDERLAY" (list (and (search (format nil "~%DGNUNDERLAY~%") tx) t) (and (search (format nil "~%DWFUNDERLAY~%") tx) t)) '(t t))
  (chk "with their definitions and dictionaries"
       (and (search "DGNDEFINITION" tx) (search "DWFDEFINITION" tx) (search "ACAD_DGNDEFINITIONS" tx) (search "ACAD_DWFDEFINITIONS" tx)
            (search "AcDbDgnReference" tx) t) t))
(%dxf-import "/tmp/fp-under.dxf")
(chk "read back: three" (length (unders)) 3)
(chk "nothing skipped" *import-skipped* nil)
(let ((d (ename-data (first (unders)))))
  (chk "the DGN underlay: file, place and scale" (list (dxf :kind d) (equal (dxf :file d) *dgn*) (rp (dxf 10 d)) (r2 (dxf 41 d)))
       '(:dgn t (100 50) 2)))
(chk "kinds" (mapcar (lambda (e) (dxf :kind (ename-data e))) (unders)) '(:dgn :dwf :dwf))
(chk "R12 DXF leaves them out" (progn (dxf-export "/tmp/fp-under12.dxf") (search "UNDERLAY" (file-text "/tmp/fp-under12.dxf"))) nil)

(format t "~%Underlay tests: ~D passed, ~D failed.~%" *pass* *fail*)
