;; STRUTS: solid bars along wireframe edges; polyhedron Frame mode.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-struts.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun close-to (a b) (< (abs (- a b)) (* 1d-6 (max 1 (abs b)))))
(defun solids () (remove-if-not (lambda (e) (equal (ent-type e) "POLYFACE")) (live-entities)))
;; one line, rectangle section 0.5 x 0.2: volume = length * area
(al "(command \"line\" '(0 0 0) '(10 0 0) \"\")")
(al "(command \"struts\" (entlast) \"\" \"r\" 0.5 0.2 \"n\")")
(chk "a rectangle strut along the line" (length (solids)) 1)
(chk "the line itself stays" (count "LINE" (live-entities) :key #'ent-type :test #'equal) 1)
(chk "its volume: 10 x 0.5 x 0.2" (close-to (mesh-volume (ename-data (first (solids)))) 1d0) t)
(chk "it runs the length of the line" (let ((xs (mapcar #'px (mesh-verts (ename-data (first (solids))))))) (list (close-to (reduce #'min xs) 0d0) (close-to (reduce #'max xs) 10d0))) '(t t))
;; a flat frame: depth stands up out of its plane
(let ((m (strut-mesh (pt 0 0 0) (pt 4 0 0) '(:rectangle 0.4 1.0) (pt 2 5 0) (pt 0 0 1))))
  (chk "flat frame: the depth stands up (height 1)" (let ((zs (mapcar #'pz (mesh-verts m)))) (close-to (- (reduce #'max zs) (reduce #'min zs)) 1d0)) t))
;; circle and polygon volumes
(let ((c (strut-mesh (pt 0 0 0) (pt 0 0 5) '(:circle 1d0) (pt 3 0 0) nil))
      (h (strut-mesh (pt 0 0 0) (pt 0 0 5) '(:polygon 6 2d0) (pt 3 0 0) nil)))
  (chk "round strut: close to pi r^2 L" (< (abs (- (mesh-volume c) (* pi 0.25 5))) 0.05) t)
  (chk "hexagon strut: 6-sided prism volume" (close-to (mesh-volume h) (* 5 (/ (* 3 (sqrt 3d0)) 2))) t))
;; a polyhedron wireframe block -> struts with corner balls
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"dodecahedron\" \"w\" '(0 0 0) 3)")
(al "(command \"struts\" (entlast) \"\" \"c\" 0.3 \"y\")")
(chk "dodecahedron wireframe: 30 struts + 20 corner balls" (length (solids)) 50)
(chk "the wireframe block stays too" (count "INSERT" (live-entities) :key #'ent-type :test #'equal) 1)
;; Frame mode straight from the polyhedron command
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"icosahedron\" \"f\" '(0 0 0) 4 \"p\" 6 0.4 \"n\")")
(chk "icosahedron Frame: 30 hexagonal struts" (length (solids)) 30)
(chk "Frame keeps the wireframe with the struts" (let ((i (find "INSERT" (live-entities) :key #'ent-type :test #'equal)))
                                                   (and i (length (block-def-entities (find-block (dxf 2 (ename-data i))))))) 30)
(let* ((m (ename-data (first (solids)))) (n (length (mesh-faces m))))
  (chk "each strut: 6 sides + 2 ends" n 8))
;; rectangles turn their depth outward on a polyhedron
(let* ((c (pt 0 0 0)) (m (strut-mesh (pt 1 0 1) (pt -1 0 1) '(:rectangle 0.1 1.0) c nil))
       (zs (mapcar #'pz (mesh-verts m))))
  (chk "rectangle depth points away from the middle" (close-to (- (reduce #'max zs) (reduce #'min zs)) 1d0) t))
(al "(command \"erase\" \"all\" \"\")")
;; curves: one strut that follows the curve
(al "(command \"circle\" '(0 0) 3)")
(al "(command \"struts\" (entlast) \"\" \"r\" 0.5 0.2 \"y\")")
(chk "a circle: one ring strut, no end balls" (length (solids)) 1)
(let ((m (ename-data (first (solids)))))
  (chk "ring volume close to 2 pi r x area" (< (abs (- (mesh-volume m) (* 2 pi 3 0.1))) 0.02) t)
  (chk "flat curve: the depth stands up (0.2)" (let ((zs (mapcar #'pz (mesh-verts m)))) (close-to (- (reduce #'max zs) (reduce #'min zs)) 0.2d0)) t))
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"pline\" '(0 0) '(10 0) \"a\" '(10 10) \"\")")
(al "(command \"struts\" (entlast) \"\" \"c\" 0.3 \"y\")")
(chk "a polyline with an arc: one strut + 2 end balls" (length (solids)) 3)
(chk "the polyline stays" (count "LWPOLYLINE" (live-entities) :key #'ent-type :test #'equal) 1)
(chk "it follows line and arc (volume)" (< (abs (- (reduce #'max (mapcar (lambda (e) (mesh-volume (ename-data e))) (solids)))
                                                (* pi 0.0225 (+ 10 (* pi 5))))) 0.03) t)
;; a drawn closed polyline as the section
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"pline\" '(100 0) '(101 0) '(101 2) '(100 2) \"c\")")
(al "(setq sec (entlast))")
(al "(command \"line\" '(0 0 0) '(10 0 0) \"\")")
(al "(command \"struts\" (entlast) \"\" \"pl\" sec \"n\")")
(chk "PLine section: one strut" (length (solids)) 1)
(let ((m (ename-data (first (solids)))))
  (chk "PLine section: volume 10 x 1 x 2" (close-to (mesh-volume m) 20d0) t)
  (chk "PLine section: its Y is the depth (2 high)" (let ((zs (mapcar #'pz (mesh-verts m)))) (close-to (- (reduce #'max zs) (reduce #'min zs)) 2d0)) t))
(chk "PLine section remembered" (first *strut-section*) :profile)
;; adjustable ends: stop short of the wire ends, or run past them
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"line\" '(0 0 0) '(10 0 0) \"\")")
(al "(command \"struts\" (entlast) \"\" \"e\" 0.5 \"r\" 0.5 0.2 \"n\")")
(chk "Ends 0.5: the strut runs 0.5 to 9.5" (let ((xs (mapcar #'px (mesh-verts (ename-data (first (solids)))))))
                                             (list (close-to (reduce #'min xs) 0.5d0) (close-to (reduce #'max xs) 9.5d0))) '(t t))
(chk "Ends remembered" *strut-end-gap* 0.5d0)
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"line\" '(0 0 0) '(10 0 0) \"\")")
(al "(command \"struts\" (entlast) \"\" \"e\" -1 \"c\" 0.2 \"n\")")
(chk "Ends -1: the strut runs past, -1 to 11" (let ((xs (mapcar #'px (mesh-verts (ename-data (first (solids)))))))
                                               (list (close-to (reduce #'min xs) -1d0) (close-to (reduce #'max xs) 11d0))) '(t t))
(chk "trim a curved path by 1 at each end" (let ((p (trim-path (list (pt 0 0 0) (pt 3 0 0) (pt 3 3 0)) 1d0)))
                                              (list (close-to (px (first p)) 1d0) (close-to (py (car (last p))) 2d0) (length p))) '(t t 3))
(chk "a gap longer than the wire leaves nothing" (trim-path (list (pt 0 0 0) (pt 1 0 0)) 0.6d0) nil)
(setf *strut-end-gap* 0d0)
;; right-click: solid editing when solids are selected
(let ((*pickfirst* (solids)))
  (chk "right-click menu offers Union/Subtract/Intersect for solids"
       (let ((sub (find-if (lambda (it) (and (consp it) (eq (first it) :sub) (equal (second it) "Solid Editing"))) (command-context-items))))
         (and sub (mapcar #'second (remove :sep (third sub))))) '("UNION" "SUBTRACT" "INTERSECT" "SLICE")))
;; slicing a whole strut frame: only the struts the plane crosses are cut (fast, little memory)
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"soccerball\" \"f\" '(0 0 0) 2 \"c\" 0.25 \"y\")")
(let ((t0 (get-internal-real-time)) (n0 (length (solids))))
  (al "(command \"slice\" \"all\" \"\" \"xy\" '(0 0 3) \"b\")")
  (chk "slice a 150-solid frame: cut where the plane crosses, the rest kept" (> (length (solids)) n0) t)
  (chk "and quickly (under 20 s)" (< (/ (- (get-internal-real-time) t0) internal-time-units-per-second) 20) t))
(al "(command \"erase\" \"all\" \"\")")
(al "(command \"box\" '(0 0 0) '(4 4 0) 4)")
(al "(command \"slice\" \"all\" \"\" \"xy\" '(0 0 10) '(0 0 0))")
(chk "a solid wholly on the kept side stays" (length (solids)) 1)
(al "(command \"slice\" \"all\" \"\" \"xy\" '(0 0 10) '(0 0 20))")
(chk "a solid wholly on the other side goes" (length (solids)) 0)
;; running out of memory stops the command, not Fancy Pencil
(let ((said ""))
  (let ((*output-fn* (lambda (s) (setf said (concatenate 'string said s)) s)))
    (run-builtin "TEST" (lambda () (signal 'storage-condition))))
  (chk "out of memory: the command stops with a message" (and (search "ran out of memory" said) t) t))
(format t "~%Strut tests: ~D passed, ~D failed.~%" *pass* *fail*)
