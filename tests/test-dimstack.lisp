;; Stacked fractions, tolerances and alternate units in dimensions (0.5.25), and MTEXT stacks (\S).
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-dimstack.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases) (current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun style (&rest vars) (append vars (standard-dimvars)))
(defun txt (meas &rest vars) (dim-text-string meas (apply #'style vars) nil))
(defun stacks (content) (remove nil (mapcar #'run-stack (mtext-runs content))))

;; MTEXT \S read as stacks
(chk "a/b over a bar" (stacks "2'-6\\S3/8;\"") '(("3" "8" :bar)))
(chk "a#b diagonal" (stacks "{\\H0.75x;\\S3#8;}") '(("3" "8" :diagonal)))
(chk "a^b tolerance" (stacks "2.40\\S+0.01^-0.02;") '(("+0.01" "-0.02" :tolerance)))
(chk "the text around it stays" (mapcar #'run-text (mtext-runs "2'-6\\S3/8;\"")) '("2'-6" "3/8" "\""))
(chk "the stack is at the \\H height" (run-height (find-if #'run-stack (mtext-runs "a{\\H0.5x;\\S1/2;}" :height 1d0))) 0.5d0)
(chk "plain text of it" (text-string-display "2'-6{\\H0.75x;\\S3#8;}\"") "2'-6 3/8\"")
(chk "  ...a tolerance" (text-string-display "2.40\\S+0.01^-0.02;") "2.40 +0.01/-0.02")
(chk "an MTEXT with a stack is drawn piece by piece"
     (and (mtext-rich-p (list (cons 0 "MTEXT") (cons 1 "6\\S1/2;") (cons 40 1d0))) t) t)

;; how a stack sits: rows one over the other, the bar between them
(let* ((r (find-if #'run-stack (mtext-runs "\\S3/8;" :height 1d0)))
       (parts (stack-parts r 0d0 0d0))
       (texts (remove :line parts :key #'first)) (line (find :line parts :key #'first)))
  (chk "two rows and a bar" (mapcar #'first parts) '(:text :line :text))
  (chk "  ...3 above, 8 below" (mapcar #'second texts) '("3" "8"))
  (chk "  ...the bar between them" (< (fourth (second texts)) (third line) (fourth (first texts))) t)
  (chk "  ...as wide as the stack" (< (abs (- (fourth line) (stack-width r))) 1d-9) t))
(let* ((r (find-if #'run-stack (mtext-runs "\\S3#8;" :height 1d0))) (parts (stack-parts r 0d0 0d0)))
  (chk "diagonal: 3, slash, 8 to its right" (list (mapcar #'first parts) (< (third (first parts)) (third (third parts)))) '((:text :line :text) t)))
(let* ((r (find-if #'run-stack (mtext-runs "\\S+0.01^-0.02;" :height 1d0))) (parts (stack-parts r 0d0 0d0)))
  (chk "tolerance: no line, rows left-aligned" (list (mapcar #'first parts) (= (third (first parts)) (third (second parts)))) '((:text :text) t)))
;; plotted: the stack's rows and bar come out
(let ((*plot-prims* nil))
  (plot-rich-mtext (list (cons 0 "MTEXT") (cons 10 (pt 0 0)) (cons 40 1d0) (cons 71 1) (cons 1 "6\\S1/2;\"")) 7)
  (chk "plot: 6, 1, 2, \" and the bar" (sort (mapcar (lambda (p) (if (eq (first p) :text) (second p) "bar")) *plot-prims*) #'string<)
       '("\"" "1" "2" "6" "bar")))

;; dimension text
(chk "stacked over a bar (DIMFRAC 0)" (txt 30.375d0 :dimlunit 4 :dimfrac 0) "2'-6\\S3/8;\"")
(chk "diagonal at 0.75 (DIMFRAC 1, DIMTFAC .75)" (txt 30.375d0 :dimlunit 4 :dimfrac 1 :dimtfac 0.75d0) "2'-6{\\H0.75x;\\S3#8;}\"")
(chk "not stacked (2)" (txt 30.375d0 :dimlunit 4 :dimfrac 2) "2'-6 3/8\"")
(chk "whole inches: nothing to stack" (txt 30d0 :dimlunit 4 :dimfrac 0) "2'-6\"")
(chk "fractional units" (txt 4.5d0 :dimlunit 5 :dimfrac 0) "4\\S1/2;")
(chk "decimal: never stacked" (txt 4.5d0 :dimlunit 2 :dimfrac 0 :dimdec 2) "4.50")
(chk "tolerance ± (plus = minus)" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimtol 1 :dimtp 0.01d0 :dimtm 0.01d0 :dimtdec 3) "2.40%%p0.010")
(chk "tolerance + and -" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimtol 1 :dimtp 0.01d0 :dimtm 0.02d0 :dimtdec 2) "2.40\\S+0.01^-0.02;")
(chk "  ...both above" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimtol 1 :dimtp 0.03d0 :dimtm -0.01d0 :dimtdec 2) "2.40\\S+0.03^+0.01;")
(chk "  ...at DIMTFAC" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimtol 1 :dimtp 0.01d0 :dimtm 0.02d0 :dimtdec 2 :dimtfac 0.7d0)
     "2.40{\\H0.7x;\\S+0.01^-0.02;}")
(chk "limits" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimlim 1 :dimtp 0.01d0 :dimtm 0.02d0) "\\S2.41^2.38;")
(chk "radius with a tolerance" (dim-text-string 3d0 (style :dimlunit 2 :dimdec 1 :dimtol 1 :dimtp 0.1d0 :dimtm 0.1d0 :dimtdec 1) nil :kind :radius)
     "R3.0%%p0.1")
(chk "alternate units in [ ]" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimalt 1) "2.40 [60.96]")
(chk "  ...with a suffix, precision 1" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimalt 1 :dimaltd 1 :dimapost " mm") "2.40 [61.0 mm]")
(chk "  ...after feet and inches" (txt 30.375d0 :dimlunit 4 :dimfrac 0 :dimalt 1 :dimaltd 0 :dimaltrnd 5d0) "2'-6\\S3/8;\" [770]")
(chk "  ...<> places it" (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimalt 1 :dimapost "<>mm") "2.40 [60.96mm]")
(chk "  ...not on angles" (dim-text-string (/ pi 2) (style :dimalt 1) nil :kind :angular) "90%%d")
(chk "prefix, measurement, tolerance, alternate"
     (txt 2.4d0 :dimlunit 2 :dimdec 2 :dimpost "<> TYP" :dimtol 1 :dimtp 0.01d0 :dimtm 0.01d0 :dimtdec 2 :dimalt 1)
     "2.40%%p0.01 TYP [60.96]")
(chk "the tolerance method" (list (tolerance-method (style)) (tolerance-method (style :dimtol 1 :dimtp 0.1d0 :dimtm 0.1d0))
                                  (tolerance-method (style :dimtol 1 :dimtp 0.1d0 :dimtm 0.2d0)) (tolerance-method (style :dimlim 1)))
     '(0 1 2 3))

;; a dimension drawn with them: its MTEXT holds the stack
(al "(setvar \"DIMLUNIT\" 4) (setvar \"DIMDEC\" 4) (setvar \"DIMFRAC\" 0) (setvar \"DIMALT\" 1) (setvar \"DIMALTD\" 0)")
(al "(command \"dimlinear\" '(0 0) '(30.375 0) '(15 -5))")
(let* ((e (car (last (live-entities))))
       (m (find "MTEXT" (block-def-entities (find-block (dxf 2 (ent-data e)))) :key (lambda (x) (dxf 0 x)) :test #'equal)))
  (chk "the dimension's text" (dxf 1 m) "2'-6\\S3/8;\" [772]"))
(al "(command \"-dimstyle\" \"save\" \"TOL\")")

;; saved and opened again
(let ((f "/tmp/fp-dimstack.dxf"))
  (setf (drawing-dimstyles *dwg*)
        (append (drawing-dimstyles *dwg*)
                (list (make-dimstyle :name "DEV" :vars (style :dimtol 1 :dimtp 0.01d0 :dimtm 0.02d0 :dimtdec 3 :dimtfac 0.75d0 :dimfrac 1
                                                             :dimaltf 2.54d0 :dimaltu 4 :dimaltrnd 0.5d0 :dimapost "<> cm"))
                      (make-dimstyle :name "LIM" :vars (style :dimlim 1)))))
  (dxf-export-2000 f)
  (new-drawing)
  (dxf-import f :replace t)
  (let ((v (dimstyle-vars (find-dimstyle "DEV"))))
    (chk "reopened: tolerance" (list (dv v :dimtol) (dv v :dimtp) (dv v :dimtm) (dv v :dimtdec) (dv v :dimtfac)) '(1 0.01d0 0.02d0 3 0.75d0))
    (chk "reopened: fractions and alternate units" (list (dv v :dimfrac) (dv v :dimaltf) (dv v :dimaltu) (dv v :dimaltrnd) (dv v :dimapost))
         '(1 2.54d0 4 0.5d0 "<> cm")))
  (chk "reopened: limits" (dv (dimstyle-vars (find-dimstyle "LIM")) :dimlim) 1)
  (chk "reopened: alternate units on" (dv (dimstyle-vars (find-dimstyle "TOL")) :dimalt) 1))

;; from AutoCAD: what a style leaves out is AutoCAD's default (fractions stacked, no tolerance)
(let ((f "/tmp/fp-dimstack2.dxf"))
  (with-open-file (o f :direction :output :if-exists :supersede)
    (format o "0~%SECTION~%2~%TABLES~%0~%TABLE~%2~%DIMSTYLE~%0~%DIMSTYLE~%2~%ARCH~%277~%4~%78~%3~%0~%DIMSTYLE~%2~%RICHARD~%277~%4~%276~%1~%146~%0.75~%78~%3~%0~%ENDTAB~%0~%ENDSEC~%0~%EOF~%"))
  (new-drawing) (dxf-import f :replace t)
  (chk "AutoCAD style, no DIMFRAC: stacked over a bar" (dim-text-string 30.375d0 (dimstyle-vars (find-dimstyle "ARCH")) nil) "2'-6\\S3/8;\"")
  (chk "AutoCAD style like the user's RICHARD: diagonal at 0.75" (dim-text-string 30.375d0 (dimstyle-vars (find-dimstyle "RICHARD")) nil)
       "2'-6{\\H0.75x;\\S3#8;}\""))

(format t "~%Dimension stack tests: ~D passed, ~D failed.~%" *pass* *fail*)
(sb-ext:exit :code (if (zerop *fail*) 0 1))
