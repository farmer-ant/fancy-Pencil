;; Typed points: second and later points are relative to the last point (AutoCAD's dynamic input,
;; DYNPICOORDS 0); # makes one absolute; AutoLISP and scripts always give absolute points.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-input.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun xy (p) (and p (list (px p) (py p))))
(setf (sysvar "LASTPOINT") (pt 2 3))
(let ((*typed-interactively* t))
  (chk "first point: absolute" (xy (parse-point-text "11,8.5" nil)) '(11 8.5d0))
  (chk "next point: relative" (xy (parse-point-text "11,8.5" (pt 2 3))) '(13 11.5d0))
  (chk "inch marks" (xy (parse-point-text "11\",8.5\"" (pt 2 3))) '(13 11.5d0))
  (chk "polar: relative" (xy (mapcar #'round (list (px (parse-point-text "5<90" (pt 2 3))) (py (parse-point-text "5<90" (pt 2 3)))))) '(2 8))
  (chk "# makes it absolute" (xy (parse-point-text "#11,8.5" (pt 2 3))) '(11 8.5d0))
  (chk "@ still relative" (xy (parse-point-text "@1,1" (pt 2 3))) '(3 4))
  (setf (sysvar "DYNPICOORDS") 1)
  (chk "DYNPICOORDS 1: absolute" (xy (parse-point-text "11,8.5" (pt 2 3))) '(11 8.5d0))
  (setf (sysvar "DYNPICOORDS") 0))
(chk "AutoLISP / scripts: absolute" (xy (parse-point-text "11,8.5" (pt 2 3))) '(11 8.5d0))
(alisp-eval-string "(command \"rectang\" '(2 3) '(11 8.5))")
(chk "(command) RECTANG absolute" (mapcar #'xy (mapcar #'car (lwpoly-vertices (ename-data (car (last (live-entities)))))))
     '((2 3) (11 3) (11 8.5d0) (2 8.5d0)))
;; Center snap: the middle of polygons, rectangles and other closed polylines
(alisp-eval-string "(command \"erase\" (ssget \"x\") \"\")")
(alisp-eval-string "(command \"polygon\" 6 '(10 10) \"i\" 5)")
(alisp-eval-string "(command \"rectang\" '(30 0) '(40 6))")
(alisp-eval-string "(command \"pline\" '(50 0) '(60 0) '(50 9) \"c\")")
(flet ((snap (x y) (multiple-value-bind (q b) (find-osnap (pt x y) nil 4 0.3)
                     (list (and q (list (/ (round (* 100 (px q))) 100) (/ (round (* 100 (py q))) 100))) b))))
  (chk "hexagon: on an edge, its center" (snap 8.93 5.87) '((10 10) 4))
  (chk "hexagon: near its center" (snap 10.1 10.1) '((10 10) 4))
  (chk "hexagon: inside but away from both, nothing" (snap 12 9) '(nil nil))
  (chk "rectangle: its center" (snap 35 6.1) '((35 3) 4))
  (chk "triangle: its centroid" (snap 55 0.1) (list (list (/ (round (* 100 (/ 160 3))) 100) 3) 4)))

(format t "~%Typed point tests: ~D passed, ~D failed.~%" *pass* *fail*)
