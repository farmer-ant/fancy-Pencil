;; VPORTS: the Model tab split into viewports.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-tiles.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defun r3 (x) (cond ((listp x) (mapcar #'r3 x)) ((realp x) (/ (round (* x 1000)) 1000)) (t x)))
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(setf *full-cw* 1000 *full-ch* 600 *cw* 1000 *ch* 600 *vscale* 50d0 *vx* 3d0 *vy* 1d0)

(al "(command \"box\" '(0 0 0) '(4 2 0) 3)")
(chk "one viewport to start" (tiled-p) nil)
(al "(command \"vports\" \"4\" \"standard\")")
(chk "four viewports" (length (drawing-tiles *dwg*)) 4)
(chk "their views" (mapcar (lambda (tl) (if (tile-view tl) (first (tile-view tl)) "Top")) (drawing-tiles *dwg*))
     '("Top" "SE Isometric" "Front" "Right"))
(chk "the active one is top left" (r3 (list *tx* *ty* *cw* *ch*)) '(0 0 500 300))
(chk "the active one shows Top" *view* nil)
(chk "screen point maps inside it" (r3 (multiple-value-list (w->s (pt *vx* *vy*)))) '(250 150))
(chk "flat views share a scale" (r3 (let ((ts (drawing-tiles *dwg*))) (list (tile-vscale (first ts)) (tile-vscale (third ts)))))
     (r3 (let ((ts (drawing-tiles *dwg*))) (list (tile-vscale (fourth ts)) (tile-vscale (fourth ts))))))
(chk "the others draw" (> (length (tile-prims (second (drawing-tiles *dwg*)))) 0) t)
(chk "a click in the bottom right makes it active" (tile-switch-at 900 500) t)
(chk "now Right view" (first *view*) "Right")
(chk "placed bottom right" (r3 (list *tx* *ty*)) '(500 300))
(chk "drawing works there: a working plane" (r3 (third (ucs))) '(1 0 0))
(al "(command \"circle\" '(1 1.5) 0.5)")
(chk "the circle is a model object in the Right view's plane" (r3 (entity-normal (ename-data (newest)))) '(1 0 0))
(chk "clicking the active one again changes nothing" (tile-switch-at 900 500) nil)
(tile-switch-at 100 100)
(chk "back to Top" *view* nil)
(chk "the Right viewport kept its zoom" (tile-view (fourth (drawing-tiles *dwg*))) (make-view "Right"))
(al "(command \"vports\" \"2\" \"horizontal\")")
(chk "split the active one into two" (length (drawing-tiles *dwg*)) 5)
(chk "active is the upper half of the old" (r3 (tile-rect (active-tile))) '(0 0 1/2 1/4))
(al "(command \"vports\" \"join\")")
(chk "join it back" (length (drawing-tiles *dwg*)) 4)
;; files keep the viewports
(dxf-export-2000 "/tmp/fp-tiles.dxf")
(dxf-import "/tmp/fp-tiles.dxf")
(chk "four viewports after opening" (length (drawing-tiles *dwg*)) 4)
(chk "their views after opening" (mapcar (lambda (tl) (if (tile-view tl) (first (tile-view tl)) "Top")) (drawing-tiles *dwg*))
     '("Top" "SE Isometric" "Front" "Right"))
(chk "their rectangles" (r3 (mapcar #'tile-rect (drawing-tiles *dwg*)))
     '((0 0 1/2 1/2) (1/2 0 1 1/2) (0 1/2 1/2 1) (1/2 1/2 1 1)))
(tiles-after-open)
;; layouts leave them alone
(set-ctab "Layout1")
(chk "a layout uses the whole canvas" (r3 (list *tx* *ty* *cw* *ch*)) '(0 0 1000 600))
(set-ctab nil)
(chk "back on Model: the active viewport again" (r3 (list *tx* *ty* *cw* *ch*)) '(0 0 500 300))
(al "(command \"vports\" \"single\")")
(chk "single" (list (tiled-p) (r3 (list *cw* *ch*))) '(nil (1000 600)))
(dxf-export-2000 "/tmp/fp-tiles1.dxf")
(dxf-import "/tmp/fp-tiles1.dxf")
(chk "one viewport stays one" (drawing-tiles *dwg*) nil)

(format t "~%Viewport tests: ~D passed, ~D failed.~%" *pass* *fail*)
