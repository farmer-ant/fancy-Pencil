;; 3D printing files: STL (binary and text), 3MF and OBJ out; STL and OBJ in.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-print3d.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun r3 (x) (/ (round (* 1000 x)) 1000))
(defun file-text (f) (with-open-file (in f :external-format :latin-1) (let ((s (make-string (file-length in)))) (subseq s 0 (read-sequence s in)))))
(defun solids () (remove-if-not (lambda (e) (equal (ent-type e) "POLYFACE")) (live-entities)))
(defun tri-volume (tris) (loop for (a b c) in tris sum (/ (vdot3 a (cross3 b c)) 6d0)))

;; binary helpers
(chk "float32 round trip" (mapcar (lambda (x) (bits-float32 (float32-bits x))) '(0d0 1d0 -2.5d0 0.15625d0 1d-40))
     (list 0d0 1d0 -2.5d0 0.15625d0 (d (coerce 1d-40 'single-float))))
(chk "float32 bits of 1" (float32-bits 1d0) #x3F800000)
(chk "crc32" (crc32 (utf8-bytes "123456789")) #xCBF43926)
(chk "utf8" (coerce (utf8-bytes "aé") 'list) '(97 195 169))

;; solids to print: a box (inches) and a cylinder
(setf (sysvar "INSUNITS") 1)
(al "(command \"box\" '(1 1 1) '(3 2 0) 0.5)")
(al "(command \"cylinder\" '(10 0 0) 1 2)")
(al "(command \"line\" '(0 0) '(5 5) \"\")")
(chk "two solids and a line" (length (live-entities)) 3)
(let ((box (first (solids))) (cyl (second (solids))))
  (chk "box triangles: 12" (length (mesh-triangles (ename-data box))) 12)
  (chk "triangles face outward (positive volume)" (r3 (tri-volume (mesh-triangles (ename-data box)))) 1)
  (multiple-value-bind (v f) (index-triangles (mesh-triangles (ename-data box)) 1d-7)
    (chk "box corners shared" (length v) 8)
    (chk "box is closed" (multiple-value-list (mesh-check f)) '(0 0 0)))
  (multiple-value-bind (v f) (index-triangles (mesh-triangles (ename-data cyl)) 1d-7)
    (declare (ignore v))
    (chk "cylinder is closed" (multiple-value-list (mesh-check f)) '(0 0 0)))
  ;; a solid with its faces turned inward is put right
  (let ((inside-out (make-mesh-data (mesh-verts (ename-data box)) (mapcar #'reverse (mesh-faces (ename-data box))))))
    (chk "inward faces turned outward" (r3 (tri-volume (mesh-triangles inside-out))) 1))
  ;; an open box (top missing) is reported
  (let ((open (make-mesh-data (mesh-verts (ename-data box)) (rest (mesh-faces (ename-data box))))))
    (multiple-value-bind (v f) (index-triangles (mesh-triangles open) 1d-7)
      (declare (ignore v))
      (chk "open box: open edges" (plusp (mesh-check f)) t))))

;; (the solids' own volume, for later)
(defparameter *vol* (reduce #'+ (mapcar (lambda (e) (mesh-volume (ename-data e))) (solids))))
;; STL binary: inches -> millimetres, placed on the plate
(let ((report (export-3d-print (solids) "/tmp/fp-print.stl" :stl)))
  (chk "report says watertight" (and (search "watertight" report) t) t)
  (chk "report gives the size in mm" (and (search "mm" report) t) t))
(let ((tris (read-stl "/tmp/fp-print.stl")))
  (chk "binary STL size" (with-open-file (s "/tmp/fp-print.stl" :element-type '(unsigned-byte 8)) (= (file-length s) (+ 84 (* 50 (length tris))))) t)
  (multiple-value-bind (lo hi) (tris-bbox tris)
    (chk "on the plate at 0,0,0" (mapcar #'r3 lo) '(0 0 0))
    (chk "in millimetres: overall width" (r3 (- (first hi) (first lo))) (r3 (* 25.4 10)))
    (chk "height in mm" (r3 (- (third hi) (third lo))) (r3 (* 25.4 2))))
  (chk "volume in mm^3" (< (abs (- (tri-volume tris) (* (expt 25.4 3) (+ 1 (mesh-volume (ename-data (second (solids)))))))) 1) t))
;; drawing units, not moved
(export-3d-print (solids) "/tmp/fp-print-in.stl" :stl :to :drawing :place nil)
(multiple-value-bind (lo hi) (tris-bbox (read-stl "/tmp/fp-print-in.stl"))
  (chk "drawing units kept" (mapcar #'r3 (append lo hi)) '(1 -1 0 11 2 2)))
;; text STL
(export-3d-print (solids) "/tmp/fp-print-a.stl" :stl-ascii)
(chk "text STL" (and (search "facet normal" (file-text "/tmp/fp-print-a.stl")) (search "endsolid" (file-text "/tmp/fp-print-a.stl")) t) t)
(chk "text STL reads back" (length (read-stl "/tmp/fp-print-a.stl")) (length (read-stl "/tmp/fp-print.stl")))
;; OBJ
(export-3d-print (solids) "/tmp/fp-print.obj" :obj)
(chk "OBJ reads back" (length (read-obj "/tmp/fp-print.obj")) (length (read-stl "/tmp/fp-print.stl")))
;; 3MF: a zip package, in the drawing's units
(export-3d-print (solids) "/tmp/fp-print.3mf" :3mf)
(chk "3MF is a zip" (let ((v (read-file-bytes "/tmp/fp-print.3mf"))) (list (aref v 0) (aref v 1))) '(80 75))
(chk "3MF says inches" (and (search "unit=\"inch\"" (file-text "/tmp/fp-print.3mf")) t) t)
(chk "3MF has two objects" (and (search "objectid=\"2\"" (file-text "/tmp/fp-print.3mf")) t) t)

;; commands
(al "(command \"stlout\" (ssget \"x\") \"\" \"n\" \"/tmp/fp-cmd.stl\")")
(chk "STLOUT (text)" (and (search "facet normal" (file-text "/tmp/fp-cmd.stl")) t) t)
(al "(command \"3dprint\" (ssget \"x\") \"\" \"3mf\" \"/tmp/fp-cmd\")")
(chk "3DPRINT adds the extension" (and (probe-file "/tmp/fp-cmd.3mf") t) t)

;; a boolean result: its cracks (T-junctions) mended so it prints
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"box\" '(0 0 0) '(4 4 0) 2)")
(al "(command \"cylinder\" '(2 2 -1) 1 4)")
(al "(command \"subtract\" (ssname (ssget \"x\") 0) \"\" (ssname (ssget \"x\") 1) \"\")")
(let ((report (export-3d-print (solids) "/tmp/fp-sub.stl" :stl)))
  ;; (facet booleans leave cracks that get mended; exact ones leave none)
  (chk "cracks mended" (and (or (search "mended" report) (brep-available-p)) (search "watertight" report) t) t))
(multiple-value-bind (v f) (index-triangles (read-stl "/tmp/fp-sub.stl") 1d-4)
  (declare (ignore v))
  (chk "box with a hole: closed" (multiple-value-list (mesh-check f)) '(0 0 0)))
(chk "box with a hole: volume" (< (abs (- (tri-volume (read-stl "/tmp/fp-sub.stl")) (* (expt 25.4 3) (mesh-volume (ename-data (first (solids))))))) 1) t)
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"box\" '(1 1 1) '(3 2 0) 0.5)")
(al "(command \"cylinder\" '(10 0 0) 1 2)")

;; importing: STL in millimetres into an inch drawing; triangle edges on flat faces hidden
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"stlin\" \"/tmp/fp-print.stl\" \"\")")
(chk "STLIN makes one solid" (length (solids)) 1)
(let ((d (ename-data (first (solids)))))
  (chk "back in inches" (multiple-value-bind (lo hi) (tris-bbox (mesh-triangles d)) (r3 (- (first hi) (first lo)))) 10)
  (chk "volume back" (r3 (mesh-volume d)) (r3 *vol*))
  (chk "box shows 12 edges (+ the cylinder's)" (> (length (mesh-edges d)) 12) t)
  (chk "flat faces' diagonals hidden" (< (length (mesh-edges d)) (* 3 (length (mesh-faces d)))) t))
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"stlin\" \"/tmp/fp-print-in.stl\" \"d\")")
(let ((d (ename-data (first (solids)))))
  (chk "box imported: its 12 edges" (count-if (lambda (e) (and (< (pz (car e)) 3) (< (px (car e)) 4) (< (px (cdr e)) 4))) (mesh-edges d)) 12))
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"stlin\" \"/tmp/fp-print.obj\" \"\")")
(chk "OBJ import" (length (solids)) 1)
;; a solid read in can be sent out again, unchanged
(export-3d-print (solids) "/tmp/fp-print2.stl" :stl)
(chk "round trip" (length (read-stl "/tmp/fp-print2.stl")) (length (read-stl "/tmp/fp-print.stl")))

;; OPEN takes STL and OBJ as well as drawings
(al "(command \"erase\" (ssget \"x\") \"\")")
(al "(command \"open\" \"/tmp/fp-print.stl\" \"\")")
(chk "OPEN an STL: a solid" (length (solids)) 1)
(chk "model file types" (mapcar (lambda (f) (and (model-file-p f) t)) '("a.STL" "b.obj" "c.dxf")) '(t t nil))
(al "(command \"erase\" (ssget \"x\") \"\")")

;; a smooth model (a sphere of small triangles): no edges to draw, so its outline is drawn and picked
(al "(command \"erase\" (ssget \"x\") \"\")")
(let ((tris nil) (n 24) (m 32))
  (flet ((p (i j) (let ((th (* pi (/ i n))) (ph (* 2 pi (/ j m)))) (pt (* 5 (sin th) (cos ph)) (* 5 (sin th) (sin ph)) (* 5 (cos th))))))
    (dotimes (i n) (dotimes (j m)
      (let ((a (p i j)) (b (p (1+ i) j)) (c (p (1+ i) (1+ j))) (dd (p i (1+ j))))
        (when (> i 0) (push (list a b dd) tris)) (when (< i (1- n)) (push (list b c dd) tris))))))
  (add-entity (triangles-to-mesh tris)))
(let* ((e (first (solids))) (d (ename-data e)))
  (chk "smooth model: no hard edges" (length (mesh-edges d)) 0)
  (chk "its outline from above: the equator" (length (mesh-silhouette-pieces d (pt 0 0 1))) 32)
  (chk "its box comes from its corners" (mapcar #'r3 (entity-bbox e)) '(-5 -5 5 5))
  (chk "picked by its outline" (eq (pick-entity-at (pt 5 0 0) 0.1) e) t))

(format t "~%3D print tests: ~D passed, ~D failed.~%" *pass* *fail*)
