;; 3D navigation: targets, the orbit / swivel / distance view changes.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-navigate.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun near (a b) (< (dist (pt3 a) (pt3 b)) 1d-6))
(al "(command \"box\" '(0 0 0) '(10 6 0) 4)")
(al "(command \"line\" '(20 0) '(30 0) \"\")")
(setf *cw* 800 *ch* 600 *tx* 0 *ty* 0 *vscale* 20d0 *vx* 0d0 *vy* 0d0)
(chk "target: the middle of the drawing (box + line)" (near (nav-auto-target) (pt 15 3 2)) t)
(setf *pickfirst* (list (first (live-entities))))
(chk "target: the middle of the selected box" (near (nav-auto-target) (pt 5 3 2)) t)
(setf *pickfirst* nil)
(setf (sysvar "ORBITAUTOTARGET") 0)
(setf *view* (make-view "SW Isometric"))
(chk "ORBITAUTOTARGET 0: the point in the middle of the screen" (multiple-value-bind (x y) (w->s (nav-auto-target)) (list (round x) (round y))) '(400 300))
(setf (sysvar "ORBITAUTOTARGET") 1)
;; constrained orbit keeps the target where it was on screen, and up stays up
(let* ((st (nav-start-state :constrained 400 300)) (tgt (getf st :target)))
  (nav-apply :constrained st 460 280)
  (chk "orbit: the target stays put on screen" (multiple-value-bind (x y) (w->s tgt) (list (round x) (round y))) (list (round (getf st :tx)) (round (getf st :ty))))
  (chk "constrained orbit: up stays up (no tilt sideways)" (< (abs (pz (second *view*))) 1d-9) t))
;; free orbit can roll the view: the screen's right no longer level
(let ((st (nav-start-state :free 400 300)))
  (setf (getf st :zone) :roll)
  (setf (getf st :sx) 700 (getf st :sy) 300)
  (nav-apply :free st 400 50)
  (chk "free orbit, outside the circle: rolls (right is no longer level)" (> (abs (pz (second *view*))) 0.5) t)
  (chk "free orbit: the frame stays square" (list (< (abs (vdot3 (second *view*) (third *view*))) 1d-9) (< (abs (vdot3 (second *view*) (fourth *view*))) 1d-9)) '(t t)))
;; swivel: the camera stays where it was
(setf *view* (make-view "SW Isometric"))
(let* ((st (nav-start-state :swivel 400 300)) (cam (v+ (getf st :target) (v* (getf st :d0) (getf st :dist)))))
  (nav-apply :swivel st 450 300)
  (let ((newt (multiple-value-call #'view-work-point (nav-screen-centre) nil)))
    (declare (ignore newt))
    (chk "swivel: the view direction turned" (> (dist (pt3 (fourth *view*)) (getf st :d0)) 0.1) t)
    (chk "swivel: the camera is still on the line of sight through the screen centre"
         (multiple-value-bind (u v) (view-project cam) (list (< (abs (- u *vx*)) 1d-6) (< (abs (- v *vy*)) 1d-6))) '(t t))))
;; distance: up = closer = larger
(let ((st (nav-start-state :distance 400 300)) (s0 *vscale*))
  (nav-apply :distance st 400 200)
  (chk "adjust distance: drag up makes things larger" (> *vscale* s0) t)
  (chk "adjust distance: the camera came closer" (< *nav-distance* (getf st :dist)) t))
(let ((st (nav-start-state :pan 400 300)) (vx *vx*))
  (nav-apply :pan st 450 300)
  (chk "pan: dragging right moves the view" (< (abs (- *vx* (- vx (/ 50 *vscale*)))) 1d-9) t))
(chk "the 3D navigation commands exist" (every #'find-command-function '("3DORBIT" "3DFORBIT" "3DCORBIT" "3DDISTANCE" "3DSWIVEL" "3DZOOM" "3DPAN")) t)
(format t "~%Navigation tests: ~D passed, ~D failed.~%" *pass* *fail*)
