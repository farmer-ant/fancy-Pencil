;; Exact solids (Open CASCADE through support/solids/fancypencil-solids): volumes that match the
;; formulas, booleans, slicing, fillets, moving, saving and reopening, STEP out and in.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-brep.lisp
;; (Skipped, with a note, when the exact solid engine isn't built or installed.)
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun newest () (car (last (live-entities))))
(defun vol (&optional (e (newest))) (solid-volume (ent-data e)))
(defun near (a b &optional (tol 1d-6)) (< (abs (- a b)) (* tol (max 1 (abs b)))))
(defun clear () (al "(command \"erase\" \"all\" \"\")"))

(unless (brep-available-p)
  (format t "~%The exact solid engine isn't available here: skipped.~%0 passed, 0 failed~%")
  (sb-ext:exit :code 0))

;; primitives
(al "(command \"box\" '(0 0) '(10 20) 5)")
(chk "box: exact, 1000" (list (brep-data-p (ent-data (newest))) (near (vol) 1000)) '(t t))
(al "(command \"cylinder\" '(30 0) 3 10)")
(chk "cylinder: pi r^2 h exactly (facets would say 279.8)" (near (vol) (* pi 9 10)) t)
(al "(command \"cone\" '(50 0) 3 6)")
(chk "cone: pi r^2 h / 3" (near (vol) (/ (* pi 9 6) 3)) t)
(al "(command \"sphere\" '(70 0 0) 4)")
(chk "sphere: 4/3 pi r^3" (near (vol) (* 4/3 pi 64)) t)
(al "(command \"torus\" '(90 0 0) 5 1)")
(chk "torus: 2 pi^2 R r^2" (near (vol) (* 2 pi pi 5 1)) t)
(al "(command \"wedge\" '(0 30) '(10 40) 6)")
(chk "wedge: half the box" (near (vol) 300) t)
(al "(command \"box\" '(20 30) '(10 40) -5)")
(chk "box drawn backwards and downwards" (near (vol) 500) t)
(clear)

;; booleans
(al "(command \"box\" '(0 0) '(10 10) 10)") (al "(setq b (entlast))")
(al "(command \"cylinder\" '(5 5) 3 10)")
(al "(command \"subtract\" b \"\" (entlast) \"\")")
(chk "a box with a round hole: 1000 - 90 pi" (near (vol) (- 1000 (* pi 90))) t)
(chk "one solid left" (length (live-entities)) 1)
(al "(command \"box\" '(20 0) '(30 10) 10)") (al "(setq b (entlast))")
(al "(command \"box\" '(25 5 5) '(35 15) 10)")
(al "(command \"union\" b (entlast) \"\")")
(chk "two boxes joined: 1000 + 1000 - 125" (near (vol) 1875) t)
(clear)
(al "(command \"sphere\" '(0 0 0) 5)") (al "(setq b (entlast))")
(al "(command \"box\" '(0 0 0) '(10 10) 10)")
(al "(command \"intersect\" b (entlast) \"\")")
(chk "an eighth of a sphere" (near (vol) (/ (* 4/3 pi 125) 8)) t)
(clear)

;; moving keeps the exact shape
(al "(command \"cylinder\" '(0 0) 2 5)")
(al "(command \"rotate\" (entlast) \"\" '(0 0) 30)")
(al "(command \"move\" (entlast) \"\" '(0 0) '(100 50 7))")
(al "(command \"scale\" (entlast) \"\" '(100 50 7) 2)")
(chk "moved, turned, doubled: 8 x the volume" (near (vol) (* 8 pi 4 5)) t)
(let ((d (ent-data (newest))))
  (chk "its facets moved with it" (< (abs (- (reduce #'min (mapcar #'pz (mesh-verts d))) 7)) 1d-6) t))
(clear)

;; slice
(al "(command \"cylinder\" '(0 0) 3 10)")
(al "(command \"slice\" (entlast) \"\" \"xy\" '(0 0 4) \"b\")")
(chk "the parts" (mapcar (lambda (e) (round (vol e) 0.001)) (sort (copy-list (live-entities)) #'< :key #'vol))
     (list (round (* pi 9 4) 0.001) (round (* pi 9 6) 0.001)))
(clear)

;; fillet one edge of a box: takes away (1 - pi/4) r^2 along its length
(al "(command \"box\" '(0 0) '(10 10) 10)")
(let* ((e (newest)) (k (brep-edge-number (ent-data e) (pt 10 0 0) (pt 10 10 0))))
  (edge-op "fillet" 1d0 (list (cons e k)) "filleted")
  (chk "fillet r=1 on one 10-long edge" (near (vol e) (- 1000 (* (- 1 (/ pi 4)) 10))) t))
(clear)

;; extrude and revolve exactly
(al "(command \"circle\" '(0 0) 2)")
(al "(command \"extrude\" (entlast) \"\" 5)")
(chk "a circle extruded: exact cylinder" (near (vol) (* pi 4 5)) t)
(al "(command \"pline\" '(2 0) '(3 0) '(3 4) '(2 4) \"c\")")
(al "(command \"revolve\" (entlast) \"\" '(0 0) '(0 1) 360)")
(chk "a rectangle revolved: a tube, pi (3^2 - 2^2) 4" (near (vol) (* pi 5 4)) t)
(al "(command \"pline\" '(20 0) '(30 0) \"a\" '(30 10) \"l\" '(20 10) \"c\")")
(al "(command \"extrude\" (entlast) \"\" 1)")
(chk "a polyline with an arc end: 100 + half a circle" (near (vol) (+ 100 (/ (* pi 25) 2))) t)
(clear)

;; saving and opening keeps the exact shape (and its move)
(al "(command \"cylinder\" '(0 0) 3 10)")
(al "(command \"move\" (entlast) \"\" '(0 0) '(5 5 5))")
(al "(command \"saveas\" \"/tmp/brep-test.dxf\")")
(clear)
(dxf-import "/tmp/brep-test.dxf")
(chk "reopened: still exact, still where it was"
     (list (brep-data-p (ent-data (newest))) (near (vol) (* pi 90))
           (< (abs (- (reduce #'min (mapcar #'pz (mesh-verts (ent-data (newest))))) 5)) 1d-6))
     '(t t t))
(clear)

;; STEP out and in (millimetres)
(setf (sysvar "INSUNITS") 4)
(al "(command \"box\" '(0 0) '(10 10) 10)") (al "(setq b (entlast))")
(al "(command \"cylinder\" '(5 5) 3 10)")
(al "(command \"subtract\" b \"\" (entlast) \"\")")
(al "(command \"stepout\" \"all\" \"\" \"/tmp/brep-test.step\")")
(chk "a STEP file was written" (and (probe-file "/tmp/brep-test.step")
                                    (search "ISO-10303-21" (with-open-file (i "/tmp/brep-test.step") (read-line i))) t) t)
(clear)
(al "(command \"stepin\" \"/tmp/brep-test.step\")")
(chk "and read back: the same exact solid" (list (length (live-entities)) (near (vol) (- 1000 (* pi 90)))) '(1 t))
(setf (sysvar "INSUNITS") 1)
(clear)
(al "(command \"box\" '(0 0) '(1 1) 1)")
(al "(command \"stepout\" \"all\" \"\" \"/tmp/brep-inch.step\")")
(clear)
(setf (sysvar "INSUNITS") 4)
(al "(command \"stepin\" \"/tmp/brep-inch.step\")")
(chk "a 1-inch cube is 25.4 mm on a side" (near (vol) (expt 25.4d0 3)) t)
(clear)
(setf (sysvar "INSUNITS") 1)

;; a facet solid made exact
(add-entity (box-mesh (pt 0 0 0) (pt 4 5 0) 6))
(chk "a facet box isn't exact" (brep-data-p (ent-data (newest))) nil)
(al "(command \"convtosolid\" \"all\" \"\")")
(chk "CONVTOSOLID: now exact, 120" (list (brep-data-p (ent-data (newest))) (near (vol) 120)) '(t t))
(clear)

;; the engine switched off: facets, as before
(setf (sysvar "SOLIDMODE") 0)
(al "(command \"cylinder\" '(0 0) 3 10)")
(chk "SOLIDMODE 0: a facet cylinder" (brep-data-p (ent-data (newest))) nil)
(setf (sysvar "SOLIDMODE") 1)

(format t "~%~D passed, ~D failed~%" *pass* *fail*)
(sb-ext:exit :code (if (zerop *fail*) 0 1))
