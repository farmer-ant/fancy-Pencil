;; Picking, window selection, snapping and editing in the 3D / side views.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-views.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defun run (s) (run-lisp-string s))
(defmacro chk (name form expect)
  `(let ((v (ignore-errors ,form)))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(al "(command \"line\" '(0 0 0) '(4 0 0) \"\")") (defvar ln (car (last (live-entities))))
(al "(command \"circle\" '(6 6) 1)") (defvar ci (car (last (live-entities))))
(al "(setvar \"ELEVATION\" 3.0)")
(al "(command \"rectang\" '(0 0) '(2 2))") (defvar rc (car (last (live-entities))))
(al "(setvar \"ELEVATION\" 0.0)")
(chk "rect elevation" (dxf 38 (ent-data rc)) 3d0)
(setf *cw* 800 *ch* 600 *vscale* 50d0 *vx* 3d0 *vy* 1d0)
(al "(command \"-view\" \"right\")")
(chk "in right view" (and *view* (first *view*)) "Right")
(defun scr (p) (multiple-value-list (w->s p)))
(defun pick-at-world (p) (destructuring-bind (x y) (scr p) (pick-entity-at (s->w x y))))
(chk "pick circle edge (seen edge-on)" (eq (pick-at-world (pt 6 6.8 0)) ci) t)
(chk "pick raised rectangle" (eq (pick-at-world (pt 0 1 3)) rc) t)
(chk "nothing in empty space" (pick-at-world (pt 0 10 10)) nil)
(chk "window around the raised rectangle"
     (let ((a (pt 0 -1 2.5)) (b (pt 0 3 3.5)))
       (destructuring-bind (x1 y1) (scr a) (destructuring-bind (x2 y2) (scr b)
         (mapcar (lambda (e) (eq e rc)) (entities-in-window (s->w x1 y1) (s->w x2 y2) nil)))))
     '(t))
(chk "work plane through grip: drag circle center up 2"
     (destructuring-bind (x y) (scr (pt 6 6 2)) (mapcar (lambda (v) (/ (round (* v 1000)) 1000)) (view-work-point x y (pt 6 6 0))))
     '(6 6 2))
(chk "snap to circle quadrant at its real position"
     (let ((p (destructuring-bind (x y) (scr (pt 6 7.05 0)) (s->w x y))))
       (mapcar (lambda (v) (/ (round (* v 1000)) 1000)) (find-osnap p nil 16 0.2)))
     '(6 7 0))
(chk "grips of raised polyline sit at its height" (pz (car (first (entity-grips (ent-data rc))))) 3d0)
(set-entity-data rc (xform-data (ent-data rc) (xf-move (pt 0 0 -1))))
(chk "moving a polyline down lowers its elevation" (dxf 38 (ent-data rc)) 2d0)
(chk "vertices stay flat" (pz (first (lwpoly-vertices (ent-data rc)))) 0d0)
(set-entity-data ci (xform-data (ent-data ci) (xf-move (pt 0 0 2))))
(chk "moving a circle up raises it" (pz (pt3 (dxf 10 (ent-data ci)))) 2d0)
(al "(command \"-view\" \"front\")")
(chk "front view: pick the line along its length" (eq (pick-at-world (pt 2 0 0)) ln) t)
(al "(command \"plan\")")
(chk "plan view picking unchanged" (eq (pick-at-world (pt 2 0 0)) ln) t)
