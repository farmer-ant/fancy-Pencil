;; Multilines, wipeouts, construction lines and rays, tolerance frames, arc length dimensions,
;; traces and embedded OLE objects: read from AutoCAD's own files, drawn with the commands, edited,
;; exploded, saved (DXF 2000 and R12) and read back.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-moreobjs.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun al (s) (alisp-eval-string s))
(defun data (f) (namestring (merge-pathnames (concatenate 'string "tests/data/" f) (truename "."))))
(defun of-type (type) (remove type (live-entities) :key #'ent-type :test-not #'equal))
(defun one (type) (first (of-type type)))
(defun newest () (car (last (live-entities))))
(defun clear () (al "(command \"erase\" \"all\" \"\")"))
(defun near (a b &optional (tol 1d-6)) (< (abs (- a b)) tol))
(defun r3 (x) (/ (round (* 1000 x)) 1000))
(defun pic-types (e) (sort (mapcar (lambda (s) (dxf 0 s)) (funcall (kind-fn (ent-type e) :picture) (ent-data e))) #'string<))
(defun counts ()
  (let ((h nil)) (dolist (e (live-entities)) (let ((c (assoc (ent-type e) h :test #'equal))) (if c (incf (cdr c)) (push (cons (ent-type e) 1) h))))
    (sort h #'string< :key #'car)))
(defun listing (e) (with-output-to-string (o) (funcall (kind-fn (ent-type e) :describe) (ent-data e) o)))

;;; ---------- AutoCAD's sample drawing (example_2018 from LibreDWG's tests)
(dxf-import (data "more-objects.dxf"))
(chk "all read, nothing skipped"
     (list (counts) *import-skipped*)
     '((("DIMENSION" . 1) ("LINE" . 8) ("MLINE" . 1) ("RAY" . 1) ("TOLERANCE" . 1) ("WIPEOUT" . 2) ("XLINE" . 1)) nil))
(let ((m (one "MLINE")))
  (chk "multiline: STANDARD, scale 20, top, closed, 4 corners"
       (let ((d (ent-data m))) (list (dxf 2 d) (dxf 40 d) (dxf 70 d) (mline-closed-p d) (length (mline-verts d))))
       '("STANDARD" 20d0 0 t 4))
  (chk "its picture: two lines along each of 4 sides" (pic-types m) (make-list 8 :initial-element "LINE"))
  ;; AutoCAD's own numbers: the second line 35.955 along the first corner's miter
  (let* ((d (ent-data m)) (p (offset-path (mline-verts d) -20d0 t)))
    (chk "the inner line where AutoCAD put it (35.955 along the miter)"
         (r3 (dist (first p) (first (mline-verts d)))) (r3 35.95547762498612d0))))
(chk "wipeouts: 12 and 4 corners" (sort (mapcar (lambda (e) (length (wipeout-points (ent-data e)))) (of-type "WIPEOUT")) #'<) '(4 12))
(let ((w (find 4 (of-type "WIPEOUT") :key (lambda (e) (length (wipeout-points (ent-data e)))))))
  (chk "the small wipeout's first corner" (mapcar #'r3 (subseq (first (wipeout-points (ent-data w))) 0 2)) (list (r3 -1144.8421d0) (r3 -748.556d0))))
(chk "construction line and ray have no size: not in the extents"
     (let ((ext (drawing-extents))) (and ext (< (- (third ext) (first ext)) 20000) t)) t)
(chk "the construction line's direction" (mapcar #'r3 (subseq (xline-dir (ent-data (one "XLINE"))) 0 2)) (list (r3 0.4474991275049089d0) (r3 -0.8942843680185545d0)))
(let ((tol (one "TOLERANCE")))
  (chk "tolerance: its frame text" (dxf 1 (ent-data tol)) "{\\Fgdt;r}%%v1%%v2%%v%%v%%v^J10")
  (chk "drawn as 4 boxes (16 lines), a symbol (2 circles) and 3 texts"
       (let ((ts (pic-types tol))) (list (count "LINE" ts :test #'equal) (count "CIRCLE" ts :test #'equal) (count "TEXT" ts :test #'equal)))
       '(16 2 3))
  (chk "LIST says what it is" (and (search "concentricity | 1 | 2 / 10" (listing tol)) t) t))
(let ((ad (one "DIMENSION")))
  (chk "the arc length dimension: marked, its length" (list (dxf :arclen (ent-data ad)) (r3 (dxf 42 (ent-data ad)))) (list t (r3 2675.622564958266d0))))

;; saved (DXF 2000) and read back
(al "(command \"saveas\" \"/tmp/more-objects-2000.dxf\")")
(let ((before (counts)))
  (dxf-import "/tmp/more-objects-2000.dxf")
  (chk "DXF 2000: the same objects back" (list (counts) *import-skipped*) (list before nil)))
(chk "the multiline style came back with it" (and (find-mlstyle "STANDARD") (length (getf (find-mlstyle "STANDARD") :elements))) 2)
(chk "still an arc length dimension" (dxf :arclen (ent-data (one "DIMENSION"))) t)
(chk "the wipeouts' corners came back"
     (sort (mapcar (lambda (e) (r3 (abs (polygon-area (wipeout-points (ent-data e)))))) (of-type "WIPEOUT")) #'<)
     (list (r3 371529.9564d0) (r3 747482.6034d0)))
(let ((text (with-open-file (i "/tmp/more-objects-2000.dxf") (let ((s (make-string (file-length i)))) (subseq s 0 (read-sequence s i))))))
  (chk "the file has the classes and the style AutoCAD needs"
       (list (and (search "AcDbWipeout" text) t) (and (search "AcDbArcDimension" text) t) (and (search "ACAD_MLINESTYLE" text) t)
             (and (search "MLINESTYLE" text) t) (and (search "AcDbXline" text) t) (and (search "AcDbRay" text) t) (and (search "AcDbFcf" text) t))
       '(t t t t t t t)))

;; R12 has none of these: their pictures go out as plain lines, polylines and text
(al "(setvar \"saveformat\" \"R12\")")
(al "(command \"saveas\" \"/tmp/more-objects-r12.dxf\")")
(al "(setvar \"saveformat\" \"2000\")")
(dxf-import "/tmp/more-objects-r12.dxf")
(chk "R12: lines, polylines, text (and the dimension)"
     (remove-if (lambda (c) (member (car c) '("LINE" "LWPOLYLINE" "TEXT" "MTEXT" "CIRCLE" "ARC" "SOLID" "DIMENSION" "INSERT") :test #'equal)) (counts))
     nil)
(clear)

;;; ---------- OLE object, trace (AutoCAD's TS1 sample)
(dxf-import (data "ole-trace.dxf"))
(chk "OLE object, trace, ray, multiline read"
     (mapcar (lambda (ty) (length (of-type ty))) '("OLE2FRAME" "TRACE" "RAY" "MLINE")) '(1 1 1 1))
(let* ((o (one "OLE2FRAME")) (d (ent-data o)))
  (chk "the OLE object's box" (mapcar #'r3 (append (subseq (dxf 10 d) 0 2) (subseq (dxf 11 d) 0 2)))
       (mapcar #'r3 '(30.13602472538446d0 -18.98882829402869d0 35.27188116753285d0 -22.39344715050545d0)))
  (chk "what it is (from inside it)" (ole-kind-name d) "PBrush")
  (chk "its streams" (sort (mapcar #'car (ole-contents d)) #'string<)
       (list (format nil "~CCompObj" (code-char 1)) (format nil "~COle" (code-char 1)) (format nil "~COle10Native" (code-char 1)) (format nil "~COlePres000" (code-char 2))))
  (multiple-value-bind (bytes ext) (ole-document d)
    (chk "the embedded document: a bitmap" (list ext (and bytes (= (aref bytes 0) 66) (= (aref bytes 1) 77))) '("bmp" t)))
  (let ((png (ole-preview-png d)))
    (chk "a picture of it for the screen" (and png (image-pixel-size png) t) t)
    (chk "shown as that picture" (pic-types o) '("IMAGE"))))
(let* ((tr (one "TRACE")) (d (ent-data tr)))
  (chk "the trace's corners" (mapcar (lambda (c) (mapcar #'r3 (subseq (dxf c d) 0 2))) '(10 13))
       (list (mapcar #'r3 '(28.58112809678753d0 21.5359205421266d0)) (mapcar #'r3 '(27.96792131451394d0 24.38468596538283d0)))))
;; moved, the OLE object keeps its data, its header follows
(al "(command \"move\" \"all\" \"\" '(0 0) '(10 5))")
(al "(command \"saveas\" \"/tmp/ole-trace-2000.dxf\")")
(let ((hex (dxf :ole (ent-data (one "OLE2FRAME")))))
  (dxf-import "/tmp/ole-trace-2000.dxf")
  (let ((d (ent-data (one "OLE2FRAME"))))
    (chk "after moving and saving: the box moved" (mapcar #'r3 (subseq (dxf 10 d) 0 2)) (mapcar #'r3 '(40.13602472538446d0 -13.98882829402869d0)))
    (chk "its contents unchanged (but for the box in its header)"
         (list (= (length (dxf :ole d)) (length hex)) (string= (subseq (dxf :ole d) 200) (subseq hex 200))) '(t t))
    (let ((v (hex-octets (dxf :ole d))))
      (chk "the header's first corner moved with it"
           (r3 (sb-kernel:make-double-float (s32 v 6) (u32 v 2))) (r3 40.13602472538446d0)))
    (chk "the trace came back too" (length (of-type "TRACE")) 1)))
(clear)

;;; ---------- the commands
;; XLINE: through two points, horizontal, vertical, at an angle, bisecting, offset
(al "(command \"xline\" '(0 0) '(1 1) '(1 -1) \"\")")
(chk "XLINE through points: two, through 0,0" (mapcar (lambda (e) (mapcar #'r3 (subseq (xline-dir (ent-data e)) 0 2))) (of-type "XLINE"))
     (list (list (r3 (sqrt 0.5d0)) (r3 (sqrt 0.5d0))) (list (r3 (sqrt 0.5d0)) (r3 (- (sqrt 0.5d0))))))
(clear)
(al "(command \"xline\" \"h\" '(0 5) '(0 7) \"\")")
(al "(command \"xline\" \"v\" '(3 0) \"\")")
(al "(command \"xline\" \"a\" 30 '(0 0) \"\")")
(chk "Hor, Ver, Ang 30" (mapcar (lambda (e) (r3 (deg (let ((u (xline-dir (ent-data e)))) (atan (py u) (px u)))))) (of-type "XLINE")) '(0 0 90 30))
(clear)
(al "(command \"xline\" \"b\" '(0 0) '(10 0) '(0 10) \"\")")
(chk "Bisect: halfway between" (r3 (deg (let ((u (xline-dir (ent-data (one "XLINE"))))) (atan (py u) (px u))))) 45)
(clear)
(al "(command \"line\" '(0 0) '(10 0) \"\")")
(al "(command \"xline\" \"o\" 2 (list (entlast) '(5 0)) '(5 3) \"\")")
(chk "Offset 2 from a line, on the side picked" (mapcar #'r3 (subseq (xline-base (ent-data (one "XLINE"))) 0 2)) '(0 2))
(clear)
(al "(command \"ray\" '(1 1) '(2 1) '(1 5) \"\")")
(chk "RAY: two from 1,1" (list (length (of-type "RAY")) (mapcar #'r3 (subseq (xline-base (ent-data (one "RAY"))) 0 2))) '(2 (1 1)))
(let ((ray (one "RAY")))
  (chk "a ray goes one way" (let ((pc (first (entity-pieces ray)))) (mapcar #'r3 (subseq (second pc) 0 2))) '(1 1))
  (let ((*plot-clip* (list 0d0 0d0 10d0 10d0)))
    (chk "cut to a window when plotted" (mapcar (lambda (s) (mapcar #'r3 (subseq (dxf s (first (xline-picture (ent-data ray)))) 0 2))) '(10 11)) '((1 1) (10 1)))))
(al "(command \"rotate\" (entlast) \"\" '(1 1) 90)")
(chk "rotated about its start: the upward one now points left" (mapcar #'r3 (subseq (xline-dir (ent-data (newest))) 0 2)) '(-1 0))
(chk "intersection snap with a construction line"
     (progn (al "(command \"xline\" \"h\" '(0 3) \"\")") (al "(command \"xline\" \"v\" '(2 0) \"\")")
            (let ((p (find-osnap (pt 2.05 3.05) nil 32 0.5))) (and p (mapcar #'r3 (subseq p 0 2)))))
     '(2 3))
(chk "zoom extents ignores them" (drawing-extents) nil)
(chk "EXPLODE leaves them" (progn (al "(command \"explode\" \"all\" \"\")") (length (live-entities))) 4)
(clear)

;; TRACE: mitred corners
(al "(command \"trace\" 1 '(0 0) '(10 0) '(10 10) \"\")")
(chk "TRACE: two segments" (length (of-type "TRACE")) 2)
(chk "mitred at the corner (outside corner 10.5,-0.5)"
     (let ((d (ent-data (first (of-type "TRACE"))))) (list (mapcar #'r3 (subseq (dxf 12 d) 0 2)) (mapcar #'r3 (subseq (dxf 13 d) 0 2))))
     '((19/2 1/2) (21/2 -1/2)))
(chk "TRACEWID kept" (sysvar "TRACEWID") 1d0)
(clear)

;; WIPEOUT: by points, from a polyline
(al "(command \"wipeout\" '(0 0) '(4 0) '(4 3) '(0 3) \"\")")
(chk "WIPEOUT by points: area 12" (r3 (abs (polygon-area (wipeout-points (ent-data (one "WIPEOUT")))))) 12)
(al "(command \"circle\" '(2 1.5) 1)")
(chk "draws after it go over it, as in AutoCAD" (mapcar #'ent-type (live-entities)) '("WIPEOUT" "CIRCLE"))
(clear)
(al "(command \"pline\" '(0 0) '(10 0) \"a\" '(10 10) \"l\" '(0 10) \"c\")")
(al "(command \"wipeout\" \"\" (entlast) \"y\")")
(chk "WIPEOUT from a polyline with an arc, polyline erased"
     (list (mapcar #'ent-type (live-entities)) (near (abs (polygon-area (wipeout-points (ent-data (one "WIPEOUT"))))) (+ 100 (/ (* pi 25) 2)) 0.5))
     '(("WIPEOUT") t))
(al "(command \"wipeout\" \"f\" \"off\")")
(chk "Frames off" (sysvar "WIPEOUTFRAME") 0)
(al "(command \"wipeout\" \"f\" \"on\")")
(let ((*plot-prims* nil) (*plotting* t))
  (plot-data (ent-data (one "WIPEOUT")) 7)
  (chk "plotted: white fill, then its frame" (mapcar #'first (reverse *plot-prims*)) '(:fill :poly)))
(clear)

;; MLINE: justification, scale, a style of its own
(al "(command \"mline\" \"j\" \"z\" \"s\" 2 '(0 0) '(10 0) '(10 10) \"\")")
(let ((m (one "MLINE")))
  (chk "MLINE: zero justification, scale 2" (list (dxf 70 (ent-data m)) (dxf 40 (ent-data m))) '(1 2d0))
  (chk "two lines each side of the path, 1 either side"
       (sort (mapcar (lambda (s) (r3 (py (pt3 (dxf 10 s))))) (remove-if-not (lambda (s) (< (abs (- (py (pt3 (dxf 10 s))) (py (pt3 (dxf 11 s))))) 1d-9))
                                                                            (funcall (kind-fn "MLINE" :picture) (ent-data m)))) #'<)
       '(-1 1))
  (chk "mitred: the outer corner at 11,-1" (mapcar #'r3 (subseq (second (offset-path (mline-verts (ent-data m)) -1d0 nil)) 0 2)) '(11 -1)))
(al "(command \"explode\" (entlast) \"\")")
(chk "EXPLODE: its 4 lines" (counts) '(("LINE" . 4)))
(clear)
(al "(command \"mlstyle\" \"n\" \"WALL\" \"0.5,0,-0.5\" \"y\" \"n\" \"l\" \"a\" \"\")")
(chk "MLSTYLE: a style with three lines, joints, a line cap and an arc cap"
     (let ((s (find-mlstyle "WALL"))) (list (mapcar #'first (getf s :elements)) (getf s :flags) (sysvar "CMLSTYLE")))
     '((0.5d0 0d0 -0.5d0) 1042 "WALL"))
(al "(command \"mline\" \"j\" \"t\" \"s\" 1 '(0 0) '(10 0) '(10 5) \"\")")
(chk "a WALL multiline: 3 x 2 lines, a joint, a line cap, an arc cap"
     (pic-types (one "MLINE")) '("ARC" "LINE" "LINE" "LINE" "LINE" "LINE" "LINE" "LINE" "LINE"))
(al "(command \"mirror\" (entlast) \"\" '(0 0) '(10 0) \"y\")")
(chk "mirrored: still on the same side of its path in the mirror image"
     (let* ((d (ent-data (one "MLINE"))) (vs (mline-verts d))) (list (mapcar #'r3 (subseq (first vs) 0 2)) (r3 (py (first (offset-path vs -1d0 nil))))))
     '((10 -5) -5))
(al "(command \"saveas\" \"/tmp/mline-style.dxf\")")
(setf (drawing-mlstyles *dwg*) nil)
(dxf-import "/tmp/mline-style.dxf")
(chk "the WALL style saved and read back" (and (find-mlstyle "WALL") (getf (find-mlstyle "WALL") :flags)) 1042)
(clear)

;; TOLERANCE
(al "(command \"tolerance\" \"po\" \"%%c0.05 M\" \"\" \"A\" \"B M\" \"\" '(10 10))")
(let ((d (ent-data (one "TOLERANCE"))))
  (chk "TOLERANCE: the frame AutoCAD would write" (dxf 1 d) "{\\Fgdt;j}%%v{\\Fgdt;n}0.05{\\Fgdt;m}%%v%%vA%%vB{\\Fgdt;m}%%v")
  (chk "at the point picked" (subseq (dxf 10 d) 0 2) '(10d0 10d0)))
(al "(command \"rotate\" (entlast) \"\" '(10 10) 90)")
(chk "rotated: runs up the page" (mapcar #'r3 (subseq (tolerance-dir (ent-data (one "TOLERANCE"))) 0 2)) '(0 1))
(al "(command \"scale\" (entlast) \"\" '(10 10) 2)")
(chk "scaled: twice the text height" (r3 (tolerance-height (ent-data (one "TOLERANCE")))) (r3 (* 2 (sysvar "DIMSCALE") (sysvar "DIMTXT"))))
(al "(command \"saveas\" \"/tmp/tol.dxf\")")
(dxf-import "/tmp/tol.dxf")
(chk "saved and read back: same frame, same size"
     (let ((d (ent-data (one "TOLERANCE")))) (list (subseq (dxf 1 d) 0 9) (r3 (tolerance-height d))))
     (list "{\\Fgdt;j}" (r3 (* 2 (sysvar "DIMSCALE") (sysvar "DIMTXT")))))
(clear)

;; DIMARC
(al "(command \"arc\" \"c\" '(0 0) '(10 0) '(0 10))")
(al "(command \"dimarc\" (list (entlast) '(7.07 7.07)) '(9 9))")
(let ((d (ent-data (one "DIMENSION"))))
  (chk "DIMARC: a quarter of a circle of radius 10" (list (dxf :arclen d) (r3 (dxf 42 d))) (list t (r3 (* 5 pi))))
  (chk "its picture: arc, two extension lines, arrows, text, the arc symbol"
       (let ((ts (mapcar (lambda (s) (dxf 0 s)) (block-def-entities (find-block (dxf 2 d))))))
         (list (count "ARC" ts :test #'equal) (count "LINE" ts :test #'equal) (count "MTEXT" ts :test #'equal) (count "SOLID" ts :test #'equal)))
       '(2 2 1 2)))
(clear)
(al "(command \"arc\" \"c\" '(0 0) '(10 0) '(0 10))")
(al "(command \"dimarc\" (list (entlast) '(7.07 7.07)) \"p\" '(10 0) (list 7.0710678 7.0710678) '(12 6))")
(chk "Partial: half of it" (r3 (dxf 42 (ent-data (one "DIMENSION")))) (r3 (* 2.5 pi)))
(al "(command \"saveas\" \"/tmp/dimarc.dxf\")")
(dxf-import "/tmp/dimarc.dxf")
(chk "saved and read back: still an arc length dimension" (let ((d (ent-data (one "DIMENSION")))) (list (dxf :arclen d) (r3 (dxf 42 d)))) (list t (r3 (* 2.5 pi))))
(clear)

(format t "~%~D passed, ~D failed~%" *pass* *fail*)
(sb-ext:exit :code (if (zerop *fail*) 0 1))
