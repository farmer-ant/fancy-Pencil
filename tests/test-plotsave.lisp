;; Plot: screening percentages (also in black ink only), saved settings.
;; Run: sbcl --non-interactive --load load.lisp --load tests/test-plotsave.lisp
(in-package :fancy-pencil)
(setf *ui* :tty *output-fn* (lambda (s) s))
(load-aliases)
(current-doc)
(defvar *pass* 0) (defvar *fail* 0)
(defmacro chk (name form expect)
  `(let ((v (handler-case ,form (error (c) (format nil "ERROR ~A" c)))))
     (if (equalp v ,expect) (incf *pass*) (incf *fail*))
     (format t "~:[FAIL~;ok  ~] ~A: ~S~%" (equalp v ,expect) ,name v)))
(defun r2 (l) (mapcar (lambda (x) (/ (round (* x 100)) 100d0)) l))
(chk "no screening: black stays black" (r2 (plot-color 7)) '(0d0 0d0 0d0))
(let ((*plot-screening* (cons 100 '((8 . 50) (1 . 25)))))
  (chk "colour 8 at 50%, monochrome: mid grey" (let ((*plot-mono* t)) (r2 (plot-color 8))) '(0.5d0 0.5d0 0.5d0))
  (chk "colour 1 at 25%, monochrome: light grey" (let ((*plot-mono* t)) (r2 (plot-color 1))) '(0.75d0 0.75d0 0.75d0))
  (chk "colour 1 at 25%, in colour: pale red" (r2 (plot-color 1)) '(1d0 0.75d0 0.75d0))
  (chk "other colours: full ink" (let ((*plot-mono* t)) (r2 (plot-color 5))) '(0d0 0d0 0d0)))
(let ((*plot-screening* (cons 30 nil)))
  (chk "all other colours at 30%" (let ((*plot-mono* t)) (r2 (plot-color 3))) '(0.7d0 0.7d0 0.7d0)))
(let ((*plot-screening* (cons 100 '((8 . 50)))) (*prims-for-display* t))
  (chk "not on the screen display" (r2 (plot-color 8)) (r2 (let ((*plot-screening* nil)) (plot-color 8)))))
;; screening reaches the PDF
(alisp-eval-string "(command \"line\" '(0 0) '(10 0) \"\")")
(alisp-eval-string "(command \"chprop\" (entlast) \"\" \"c\" 8 \"\")")
(let ((s (make-plot-settings :mono t :screening '((8 . 50)))))
  (make-plot s "/tmp/fp-screen.pdf")
  (chk "the PDF draws the line in 50% grey" (let ((txt (with-open-file (i "/tmp/fp-screen.pdf" :external-format :latin-1) (let ((str (make-string (file-length i)))) (subseq str 0 (read-sequence str i))))))
                                              (and (search "0.5 0.5 0.5 RG" txt) t)) t))
;; saved settings
(defparameter *home* (format nil "/tmp/fp-plot-test-~D" (my-pid)))
(require :sb-posix)
(funcall (intern "SETENV" "SB-POSIX") "HOME" *home* 1)
(let ((s (make-plot-settings :paper "Letter (8.5 x 11 in)" :landscape nil :mono t :screen-default 80 :screening '((8 . 40)) :scale "1:50")))
  (save-plot-store :setups (list (cons "Check prints" (plot-settings-plist s))) :last s)
  (chk "a named setup is kept" (mapcar #'car (plot-setups)) '("Check prints"))
  (let ((b (plist-plot-settings (cdr (first (plot-setups))))))
    (chk "and comes back the same" (list (plot-settings-paper b) (plot-settings-landscape b) (plot-settings-mono b)
                                         (plot-settings-screen-default b) (plot-settings-screening b) (plot-settings-scale b))
         '("Letter (8.5 x 11 in)" nil t 80 ((8 . 40)) "1:50")))
  (chk "the last settings used come back next time" (plot-settings-scale (last-plot-settings)) "1:50"))
(format t "~%Plot settings tests: ~D passed, ~D failed.~%" *pass* *fail*)
