#!/bin/sh
# Fancy Pencil launcher.  Usage: ./fancypencil [--tty] [file.lsp ...] [drawing.dxf]
DIR=$(cd "$(dirname "$0")" && pwd)
# started from the app launcher (no terminal): keep error messages in a log file
if [ ! -t 2 ]; then
    mkdir -p "$HOME/.cache"
    exec 2>>"$HOME/.cache/fancypencil.log"
    echo "--- $(date) fancypencil $*" >&2
fi
# fonts put in a "fonts" folder (inside or next to the Fancy Pencil folder, or in
# ~/.config/fancypencil/fonts) are installed for this user, so the drawing can use them
FONTDEST="$HOME/.local/share/fonts/fancypencil"
NEWFONTS=
for FD in "$DIR/fonts" "$DIR/../fonts" "$HOME/.config/fancypencil/fonts"; do
    [ -d "$FD" ] || continue
    for F in "$FD"/*.ttf "$FD"/*.TTF "$FD"/*.otf "$FD"/*.OTF "$FD"/*.ttc "$FD"/*.TTC; do
        [ -f "$F" ] || continue
        B=$(basename "$F")
        if [ ! -f "$FONTDEST/$B" ] || ! cmp -s "$F" "$FONTDEST/$B"; then
            mkdir -p "$FONTDEST" && cp "$F" "$FONTDEST/$B" && NEWFONTS=1
        fi
    done
done
if [ -n "$NEWFONTS" ] && command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$FONTDEST" >/dev/null 2>&1
fi
# the most memory Fancy Pencil may use (Options > Memory and speed, kept in memory.conf): Automatic
# is half the computer's memory, at least 2 GB; a size chosen there is used as it is, up to four
# fifths of the memory. It is only reserved, not used, until a big model needs it.
# FANCYPENCIL_HEAP=<MB> overrides both.
RAM=$(awk '/MemTotal/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)
[ -n "$RAM" ] || RAM=8192
HEAP=${FANCYPENCIL_HEAP:-$(sed -n 's/^heap=\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$HOME/.config/fancypencil/memory.conf" 2>/dev/null | head -n 1)}
if [ -z "$HEAP" ]; then
    HEAP=$((RAM / 2))
    [ "$HEAP" -ge 2048 ] || HEAP=2048
else
    MAXHEAP=$((RAM * 4 / 5))
    [ "$MAXHEAP" -ge 2048 ] || MAXHEAP=2048
    [ "$HEAP" -le "$MAXHEAP" ] || HEAP=$MAXHEAP
    [ "$HEAP" -ge 1024 ] || HEAP=1024
fi
exec sbcl --dynamic-space-size "$HEAP" --noinform --disable-debugger --load "$DIR/load.lisp" --eval '(fancy-pencil:main)' --end-toplevel-options "$@"
